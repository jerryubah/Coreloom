<Project Sdk="Microsoft.NET.Sdk">

  <!-- Platform-neutral domain logic: metrics, history, alerts, settings, formatting, updates.
       Contains no Windows or UI dependencies so it can be unit tested on any OS. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Coreloom.Core</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Coreloom.Core.Tests" />
    <!-- Runs the Connect tests (tests/Coreloom.Core.Tests/ConnectTests.cs) on the macOS runners too. -->
    <InternalsVisibleTo Include="Coreloom.Hardware.Mac.Tests" />
  </ItemGroup>

  <!-- The phone app (src/Coreloom.Phone), served to phones by Coreloom Connect. -->
  <ItemGroup>
    <EmbeddedResource Include="..\Coreloom.Phone\**\*" Exclude="..\Coreloom.Phone\README.md" LogicalName="connect-web/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
