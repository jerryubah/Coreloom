<Project Sdk="Microsoft.NET.Sdk">

  <!-- The WPF desktop application (Coreloom.exe). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows 10 SDK projection gives access to Windows' Bluetooth, radio and device APIs (Devices page). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <!-- WinForms is used only for the notification-area icon (NotifyIcon). -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Coreloom.App</RootNamespace>
    <AssemblyName>Coreloom</AssemblyName>
    <!-- The compiled Coreloom.exe embeds this icon (File Explorer, taskbar, Start menu, shortcuts, installer). -->
    <ApplicationIcon>..\..\assets\branding\coreloom.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Smaller, faster-starting self-contained publish; WPF does not support trimming. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <!-- The Windows API projection is large and rarely on a hot path: keep it out of ReadyToRun to keep downloads small. -->
  <ItemGroup>
    <PublishReadyToRunExclude Include="Microsoft.Windows.SDK.NET.dll" />
  </ItemGroup>

  <!-- Keep WPF and WinForms types from colliding (Application, Button, Color, ...). -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Branding: the one tracked copy of the approved icon kit lives in assets/branding; these links expose the
         files the UI needs as pack://application:,,,/Assets/... resources. -->
    <Resource Include="..\..\assets\branding\coreloom.ico" Link="Assets\coreloom.ico" />
    <Resource Include="..\..\assets\branding\png\coreloom-16.png" Link="Assets\coreloom-16.png" />
    <Resource Include="..\..\assets\branding\png\coreloom-24.png" Link="Assets\coreloom-24.png" />
    <Resource Include="..\..\assets\branding\png\coreloom-32.png" Link="Assets\coreloom-32.png" />
    <Resource Include="..\..\assets\branding\png\coreloom-48.png" Link="Assets\coreloom-48.png" />
    <Resource Include="..\..\assets\branding\png\coreloom-64.png" Link="Assets\coreloom-64.png" />
    <Resource Include="..\..\assets\branding\png\coreloom-128.png" Link="Assets\coreloom-128.png" />
    <!-- Startup splash icon (88 DIP, sharp up to ~580 % scaling). -->
    <Resource Include="..\..\assets\branding\png\coreloom-512.png" Link="Assets\coreloom-512.png" />
    <!-- The dark-mode icon (the mark on a dark glass tile), made from the approved icon by build/dark-icon.py and shown by
         the app wherever it draws its own icon while the dark theme is on. -->
    <Resource Include="..\..\assets\branding\dark\coreloom-dark.ico" Link="Assets\coreloom-dark.ico" />
    <Resource Include="..\..\assets\branding\dark\png\coreloom-dark-*.png" Link="Assets\%(Filename)%(Extension)" />
    <!-- A copy beside Coreloom.exe for Windows to draw Coreloom's shortcuts with while the dark theme is on. -->
    <Content Include="..\..\assets\branding\dark\coreloom-dark.ico" Link="coreloom-dark.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Vendor logos (nvidia/amd/intel[-on-dark|-on-light].png) are optional and supplied by the repository owner from
         the vendors' own brand pages; none are bundled. Anything placed in assets/vendors is embedded at build time. -->
    <Resource Include="..\..\assets\vendors\*.png" Link="Assets\Vendors\%(Filename)%(Extension)" />
    <!-- Optional picture of the build for the Overview header (assets/pc/README.md); the drawn PC is used without it. -->
    <Resource Include="..\..\assets\pc\*.png" Link="Assets\PC\%(Filename)%(Extension)" />
    <!-- The PC picture's layers, generated from assets/pc-render/render.png by build/pc-render.py. -->
    <Resource Include="Assets\PcRender\*.png" />
    <!-- The suggested background pictures (build/backdrops/make-backdrops.py) and their swatches. -->
    <Resource Include="..\..\assets\backdrops\*.jpg" Link="Assets\Backdrops\%(Filename)%(Extension)" />
    <!-- Inter and JetBrains Mono (SIL Open Font License 1.1); the license texts ship next to the app. -->
    <Resource Include="Fonts\*.ttf" />
    <None Include="Fonts\LICENSE-*.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\LICENSE" Link="LICENSE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Coreloom.Core\Coreloom.Core.csproj" />
    <ProjectReference Include="..\Coreloom.Hardware\Coreloom.Hardware.csproj" />
    <ProjectReference Include="..\Coreloom.ViewModels\Coreloom.ViewModels.csproj" />
  </ItemGroup>

</Project>
