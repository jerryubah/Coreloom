<UserControl x:Class="Coreloom.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Coreloom.App.Controls"
             xmlns:b="clr-namespace:Coreloom.App.Behaviors"
             xmlns:pages="clr-namespace:Coreloom.ViewModels.Pages;assembly=Coreloom.ViewModels">

  <UserControl.Resources>
    <!-- One settings row: bottom hairline, comfortable vertical rhythm. -->
    <Style x:Key="Row" TargetType="Border">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Divider}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="0,13" />
    </Style>
    <Style x:Key="Row.Last" TargetType="Border" BasedOn="{StaticResource Row}">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0,13,0,2" />
    </Style>
    <Style x:Key="Row.Title" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Row.Description" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,3,0,0" />
    </Style>
    <Style x:Key="Panel.Header" TargetType="TextBlock" BasedOn="{StaticResource Text.Section}">
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style x:Key="Panel.Intro" TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,14" />
    </Style>
    <Style x:Key="Group.Label" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
      <Setter Property="Margin" Value="0,20,0,6" />
    </Style>
    <Style x:Key="Spinner" TargetType="c:RadialGauge">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Thickness" Value="2.4" />
      <Setter Property="SweepAngle" Value="359" />
      <Setter Property="Value" Value="0.28" />
      <Setter Property="TrackBrush" Value="Transparent" />
      <Setter Property="Fill" Value="{DynamicResource Brush.Accent}" />
    </Style>
    <!-- An entry in the log viewer: time, level, category and message (and any lines under it). -->
    <Style x:Key="LogItem" TargetType="ListBoxItem">
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Root" Background="Transparent" CornerRadius="8" Padding="10,7" Margin="0,0,10,1">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.CardHover}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.ControlHover}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DataTemplate x:Key="LogLine" DataType="{x:Type pages:LogLineViewModel}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="150" />
          <ColumnDefinition Width="72" />
          <ColumnDefinition Width="110" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding TimeText}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Top" Margin="0,1,0,0" />
        <Border x:Name="LevelPill" Grid.Column="1" Style="{StaticResource Badge}" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource Brush.ControlHover}">
          <TextBlock x:Name="LevelText" Text="{Binding LevelText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" />
        </Border>
        <TextBlock Grid.Column="2" Text="{Binding Category}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Top" Margin="0,1,8,0" ToolTip="{Binding Category}" />
        <StackPanel Grid.Column="3">
          <TextBlock Text="{Binding Message}" FontSize="12.5" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Details}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{DynamicResource Brush.TextTertiary}" TextWrapping="Wrap"
                     Margin="0,3,0,0" MaxHeight="120" TextTrimming="CharacterEllipsis"
                     Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding LevelKey}" Value="Info">
          <Setter TargetName="LevelText" Property="Foreground" Value="{DynamicResource Brush.Info}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding LevelKey}" Value="Warning">
          <Setter TargetName="LevelText" Property="Foreground" Value="{DynamicResource Brush.Elevated}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding LevelKey}" Value="Error">
          <Setter TargetName="LevelText" Property="Foreground" Value="{DynamicResource Brush.Critical}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <!-- Update status icon: tinted by UpdatesViewModel.StatusTone. -->
    <Style x:Key="UpdateStatus.Circle" TargetType="Border">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding StatusTone}" Value="Accent">
          <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="UpdateStatus.Icon" TargetType="Path" BasedOn="{StaticResource IconPath}">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Stroke" Value="{DynamicResource Brush.TextSecondary}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding StatusTone}" Value="Success">
          <Setter Property="Stroke" Value="{DynamicResource Brush.Success}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StatusTone}" Value="Accent">
          <Setter Property="Stroke" Value="{DynamicResource Brush.Accent}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StatusTone}" Value="Critical">
          <Setter Property="Stroke" Value="{DynamicResource Brush.Critical}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Body of a "What's new" card (a ReleaseSummaryViewModel): intro, a short list with category chips, "and N more". -->
    <DataTemplate x:Key="WhatsNewBody">
      <StackPanel>
        <TextBlock Text="{Binding Intro}" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,12"
                   Visibility="{Binding HasIntro, Converter={StaticResource BoolToVisibility}}" />
        <ItemsControl ItemsSource="{Binding Items}" Focusable="False" Grid.IsSharedSizeScope="True"
                      Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" SharedSizeGroup="WhatsNewChip" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource Badge}" Background="{DynamicResource Brush.AccentSoft}" Padding="7,1" Margin="0,1,10,0"
                        VerticalAlignment="Top" HorizontalAlignment="Left"
                        Visibility="{Binding HasCategory, Converter={StaticResource BoolToVisibility}}">
                  <TextBlock Text="{Binding Category}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" />
                </Border>
                <Ellipse Width="5" Height="5" Fill="{DynamicResource Brush.Accent}" Margin="2,7,12,0" VerticalAlignment="Top" HorizontalAlignment="Left"
                         Visibility="{Binding HasCategory, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                <TextBlock x:Name="Lead" Grid.Column="1" Text="{Binding Lead}" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource Brush.Text}" />
                <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding Detail}" TextWrapping="Wrap" FontSize="12.5" Margin="0,2,0,0"
                           Foreground="{DynamicResource Brush.TextSecondary}"
                           Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}" />
              </Grid>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasTitle}" Value="True">
                  <Setter TargetName="Lead" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding MoreText}" Margin="0,0,0,2"
                   Visibility="{Binding MoreText, Converter={StaticResource HasValueToVisibility}}" />
        <TextBlock Style="{StaticResource Text.Secondary}" Text="This release has no summary. Its full notes are on GitHub." TextWrapping="Wrap"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
      </StackPanel>
    </DataTemplate>

    <Style x:Key="Combo.Setting" TargetType="ComboBox" BasedOn="{StaticResource ComboBox.Default}">
      <Setter Property="MinWidth" Value="240" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Grid.Column" Value="1" />
      <Setter Property="Margin" Value="20,0,0,0" />
      <Setter Property="DisplayMemberPath" Value="Label" />
      <Setter Property="SelectedValuePath" Value="Value" />
    </Style>
  </UserControl.Resources>

  <Grid Margin="32,14,28,0">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="200" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Section list -->
    <ListBox Style="{StaticResource NavList}" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}" VerticalAlignment="Top"
             AutomationProperties.Name="Settings sections">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid Margin="16,0,10,0" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
            <!-- Update badge on the "Updates" section -->
            <Ellipse x:Name="UpdateDot" Grid.Column="1" Width="7" Height="7" Margin="8,1,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                     Fill="{DynamicResource Brush.Accent}" Visibility="Collapsed" />
          </Grid>
          <DataTemplate.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding}" Value="Updates" />
                <Condition Binding="{Binding DataContext.Updates.ShowBadge, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True" />
              </MultiDataTrigger.Conditions>
              <Setter TargetName="UpdateDot" Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
          </DataTemplate.Triggers>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <ScrollViewer Grid.Column="1" Style="{StaticResource ScrollViewer.Page}" Margin="20,0,0,0">
      <Grid MaxWidth="860" HorizontalAlignment="Left" Margin="0,0,8,32">

        <!-- ======================================================================= -->
        <!-- Appearance                                                              -->
        <!-- ======================================================================= -->
        <StackPanel b:Motion.Entrance="True" Visibility="{Binding SelectedSection, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Appearance}">
          <TextBlock Style="{StaticResource Panel.Header}" Text="Appearance" />
          <TextBlock Style="{StaticResource Panel.Intro}" Text="Theme, accent color and motion. Changes apply immediately." />
          <c:SquircleBorder Style="{StaticResource Card}" Padding="20,4,20,10">
            <StackPanel>
              <Border Style="{StaticResource Row}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Style="{StaticResource Row.Title}" Text="Theme" />
                    <TextBlock Style="{StaticResource Row.Description}" Text="Dark is tuned for OLED and low-light setups. 'Use Windows setting' follows the app mode in Windows Settings." />
                  </StackPanel>
                  <ComboBox Style="{StaticResource Combo.Setting}" ItemsSource="{Binding ThemeOptions}" SelectedValue="{Binding Theme}" />
                </Grid>
              </Border>

              <Border Style="{StaticResource Row}">
                <StackPanel>
                  <TextBlock Style="{StaticResource Row.Title}" Text="Accent color" />
                  <TextBlock Style="{StaticResource Row.Description}" Text="Used for selection, focus and the default series color." />
                  <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ItemsControl ItemsSource="{Binding AccentOptions}" Focusable="False">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type pages:AccentOption}">
                          <Button Width="34" Height="34" Margin="0,0,8,8" Cursor="Hand" ToolTip="{Binding Name}"
                                  AutomationProperties.Name="{Binding Name}"
                                  Command="{Binding DataContext.SetAccentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding Hex}">
                            <Button.Template>
                              <ControlTemplate TargetType="Button">
                                <Grid Background="Transparent">
                                  <Ellipse x:Name="Ring" StrokeThickness="2" Stroke="{DynamicResource Brush.Text}">
                                    <Ellipse.Visibility>
                                      <MultiBinding Converter="{StaticResource MultiEqualsToVisibility}">
                                        <Binding Path="Hex" />
                                        <Binding Path="DataContext.Accent" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                      </MultiBinding>
                                    </Ellipse.Visibility>
                                  </Ellipse>
                                  <Ellipse x:Name="Swatch" Margin="5" Fill="{Binding Hex, Converter={StaticResource HexToBrush}}" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                  <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Swatch" Property="Margin" Value="3" />
                                  </Trigger>
                                </ControlTemplate.Triggers>
                              </ControlTemplate>
                            </Button.Template>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,0,0,0">
                      <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource Brush.Accent}" />
                      <TextBox Style="{StaticResource TextBox.Default}" Width="110" Margin="10,0,0,0" Text="{Binding CustomAccent}"
                               ToolTip="Any color as #RRGGBB. Press Enter or Tab to apply." AutomationProperties.Name="Custom accent color"
                               KeyDown="OnCommitOnEnter" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource Row}">
                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding UseMica}" IsEnabled="{Binding IsMicaSupported}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Row.Title}" Text="Mica window material" />
                    <TextBlock Style="{StaticResource Row.Description}" Text="Lets your desktop color tint the sidebar. Requires Windows 11 22H2 or later; turned off automatically when unavailable." />
                  </StackPanel>
                </CheckBox>
              </Border>

              <Border Style="{StaticResource Row}">
                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AnimateValues}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Row.Title}" Text="Animate numbers" />
                    <TextBlock Style="{StaticResource Row.Description}" Text="Values glide to each new reading instead of jumping." />
                  </StackPanel>
                </CheckBox>
              </Border>

              <Border Style="{StaticResource Row}">
                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding SmoothChartScrolling}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Row.Title}" Text="Smooth chart scrolling" />
                    <TextBlock Style="{StaticResource Row.Description}" Text="Charts glide continuously between samples (60-second and 5-minute windows). Off: charts step once per sample, which uses slightly less GPU." />
                  </StackPanel>
                </CheckBox>
              </Border>

              <Border Style="{StaticResource Row.Last}">
                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ReducedMotion}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Row.Title}" Text="Reduce motion" />
                    <TextBlock Style="{StaticResource Row.Description}" Text="Turns off entrance animations, number animation, smooth scrolling and the live pulse." />
                  </StackPanel>
                </CheckBox>
              </Border>
            </StackPanel>
          </c:SquircleBorder>
        </StackPanel>

        <!-- ======================================================================= -->
        <!-- Monitoring                                                              -->
        <!-- ======================================================================= -->
        <StackPanel b:Motion.Entrance="True" Visibility="{Binding SelectedSection, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Monitoring}">
          <TextBlock Style="{StaticResource Panel.Header}" Text="Monitoring" />
          <TextBlock Style="{StaticResource Panel.Intro}" Text="How often sensors are read, which units are shown, and which hardware is monitored." />
          <c:SquircleBorder Style="{StaticResource Card}" Padding="20,4,20,10">
            <StackPanel>
              <Border Style="{StaticResource Row}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Style="{StaticResource Row.Title}" Text="Polling interval" />
                    <TextBlock Style="{StaticResource Row.Description}" Text="How often all sensors are sampled. Faster polling costs a little more CPU; slow sensors are always read less often." />
                  </StackPanel>
                  <ComboBox Style="{StaticResource Combo.Setting}" ItemsSource="{Binding PollingOptions}" SelectedValue="{Binding PollingIntervalMs}" />
                </Grid>
              </Border>
              <Border Style="{StaticResource Row}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Style="{StaticResource Row.Title}" Text="Default chart window" />
                    <TextBlock Style="{StaticResource Row.Description}" Text="The time range charts show when Coreloom starts." />
                  </StackPanel>
                  <ComboBox Style="{StaticResource Combo.Setting}" ItemsSource="{Binding WindowOptions}" SelectedValue="{Binding DefaultWindow}" />
                </Grid>
              </Border>
              <Border Style="{StaticResource Row}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource Row.Title}" Text="Temperature" VerticalAlignment="Center" />
                  <ComboBox Style="{StaticResource Combo.Setting}" ItemsSource="{Binding TemperatureOptions}" SelectedValue="{Binding TemperatureUnit}" />
                </Grid>
              </Border>
              <Border Style="{StaticResource Row}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource Row.Title}" Text="Memory and storage sizes" VerticalAlignment="Center" />
                  <ComboBox Style="{StaticResource Combo.Setting}" ItemsSource="{Binding DataUnitOptions}" SelectedValue="{Binding DataUnits}" />
                </Grid>
              </Border>
              <Border Style="{StaticResource Row.Last}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource Row.Title}" Text="Network speed" VerticalAlignment="Center" />
                  <ComboBox Style="{StaticResource Combo.Setting}" ItemsSource="{Binding NetworkUnitOptions}" SelectedValue="{Binding NetworkUnits}" />
                </Grid>
              </Border>
            </StackPanel>
          </c:SquircleBorder>

          <TextBlock Style="{StaticResource Group.Label}" Text="Monitored hardware" />
          <c:SquircleBorder Style="{StaticResource Card}" Padding="20,4,20,10">
            <StackPanel>
              <TextBlock Style="{StaticResource Row.Description}" Margin="0,12,0,0"
                         Text="A section that is turned off stops reading its sensors entirely and is hidden from the sidebar and Overview." />
              <Border Style="{StaticResource Row}">
                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding GpuEnabled}">
                  <TextBlock Style="{StaticResource Row.Title}" Text="Graphics (GPU)" />
                </CheckBox>
              </Border>
              <Border Style="{StaticResource Row}">
                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding CpuEnabled}">
                  <TextBlock Style="{StaticResource Row.Title}" Text="Processor (CPU)" />
                </CheckBox>
              </Border>
              <Border Style="{StaticResource Row}">
                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding MemoryEnabled}">
                  <TextBlock Style="{StaticResource Row.Title}" Text="Memory" />
                </CheckBox>
              </Border>
              <Border Style="{StaticResource Row}">
                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StorageEnabled}">
                  <TextBlock Style="{StaticResource Row.Title}" Text="Storage" />
                </CheckBox>
              </Border>
              <Border Style="{StaticResource Row.Last}">
                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding NetworkEnabled}">
                  <TextBlock Style="{StaticResource Row.Title}" Text="Network" />
                </CheckBox>
              </Border>
            </StackPanel>
          </c:SquircleBorder>

          <TextBlock Style="{StaticResource Group.Label}" Text="Sensor sources" />
          <c:SquircleBorder Style="{StaticResource Card}" Padding="20,4,20,10">
            <StackPanel>
              <Border Style="{StaticResource Row}">
                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding UseLibreHardwareMonitor}" IsEnabled="{Binding LibreHardwareMonitorIncluded}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Row.Title}" Text="Use LibreHardwareMonitor" />
                    <TextBlock Style="{StaticResource Row.Description}" Text="Adds CPU temperatures, package power, per-core clocks, motherboard fans and SSD health. Most of these need administrator rights and the PawnIO driver. Read-only: nothing is ever written to hardware." />
                  </StackPanel>
                </CheckBox>
              </Border>
              <Border Style="{StaticResource Row}">
                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ScanUsbControllers}" IsEnabled="{Binding UseLibreHardwareMonitor}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Row.Title}" Text="Scan USB fan and pump controllers" />
                    <TextBlock Style="{StaticResource Row.Description}" Text="Looks for AIO coolers and fan hubs (Corsair, NZXT, Aquacomputer…). Off by default because probing USB devices can conflict with vendor software." />
                  </StackPanel>
                </CheckBox>
              </Border>
              <Border Style="{StaticResource Row.Last}">
                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowPerThreadGraphs}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Row.Title}" Text="Show per-thread graphs on the CPU page" />
                    <TextBlock Style="{StaticResource Row.Description}" Text="32 small live graphs on a 9950X3D. Turn off to save a little rendering time." />
                  </StackPanel>
                </CheckBox>
              </Border>
            </StackPanel>
          </c:SquircleBorder>

          <c:SquircleBorder Style="{StaticResource Card.Inset}" Margin="0,12,0,0" Background="{DynamicResource Brush.BannerBackground}" BorderBrush="{DynamicResource Brush.BannerBorder}"
                  Visibility="{Binding RestartRequired, Converter={StaticResource BoolToVisibility}}">
            <Grid>
              <TextBlock Text="Sensor source changes take effect after Coreloom restarts." VerticalAlignment="Center" FontSize="12.5" Margin="0,0,120,0" TextWrapping="Wrap" />
              <Button Style="{StaticResource Button.Primary}" Content="Restart now" HorizontalAlignment="Right" Command="{Binding RestartCommand}" />
            </Grid>
          </c:SquircleBorder>
        </StackPanel>

        <!-- ======================================================================= -->
        <!-- Desktop                                                                 -->
        <!-- ======================================================================= -->
        <StackPanel b:Motion.Entrance="True" Visibility="{Binding SelectedSection, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Desktop}">
          <TextBlock Style="{StaticResource Panel.Header}" Text="Desktop" />
          <TextBlock Style="{StaticResource Panel.Intro}" Text="Startup, tray and window behavior." />
          <c:SquircleBorder Style="{StaticResource Card}" Padding="20,4,20,10">
            <StackPanel>
              <Border Style="{StaticResource Row}">
                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartWithWindows}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Row.Title}" Text="Start with Windows" />
                    <TextBlock Style="{StaticResource Row.Description}" Text="Launch Coreloom when you sign in. Coreloom always runs as administrator, so this uses a Task Scheduler task with the highest privileges: it starts at sign-in without a UAC prompt. Starting it by hand shows the usual Windows prompt." />
                  </StackPanel>
                </CheckBox>
              </Border>
              <Border Style="{StaticResource Row}">
                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding LaunchMinimized}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Row.Title}" Text="Start minimized to the tray" />
                    <TextBlock Style="{StaticResource Row.Description}" Text="When started at sign-in, keep the window hidden until you open it from the tray." />
                  </StackPanel>
                </CheckBox>
              </Border>
              <Border Style="{StaticResource Row}">
                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding MinimizeToTray}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Row.Title}" Text="Minimize to the tray" />
                    <TextBlock Style="{StaticResource Row.Description}" Text="Minimizing hides the window and its taskbar button. Monitoring and alerts continue; chart rendering pauses." />
                  </StackPanel>
                </CheckBox>
              </Border>
              <Border Style="{StaticResource Row.Last}">
                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding CloseToTray}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Row.Title}" Text="Close to the tray" />
                    <TextBlock Style="{StaticResource Row.Description}" Text="The close button hides Coreloom instead of exiting. Use Exit in the tray menu to quit." />
                  </StackPanel>
                </CheckBox>
              </Border>
            </StackPanel>
          </c:SquircleBorder>
          <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding StartupMessage}" TextWrapping="Wrap" Margin="4,10,0,0"
                     Visibility="{Binding StartupMessage, Converter={StaticResource HasValueToVisibility}}" />
        </StackPanel>

        <!-- ======================================================================= -->
        <!-- Alerts                                                                  -->
        <!-- ======================================================================= -->
        <StackPanel b:Motion.Entrance="True" Visibility="{Binding SelectedSection, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Alerts}">
          <TextBlock Style="{StaticResource Panel.Header}" Text="Alerts" />
          <TextBlock Style="{StaticResource Panel.Intro}" Text="Windows notifications when a reading stays past a threshold you choose." />

          <c:SquircleBorder Style="{StaticResource Card.Inset}" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
              <Path Style="{StaticResource IconPath}" Width="14" Height="14" Data="{StaticResource Icon.Info}" VerticalAlignment="Top" Margin="0,2,0,0" />
              <TextBlock Margin="10,0,0,0" FontSize="12.5" TextWrapping="Wrap" MaxWidth="720" Foreground="{DynamicResource Brush.TextSecondary}"
                         Text="These thresholds are personal reminders, not safety limits. Safe operating temperatures and power levels differ by product and cooling; modern CPUs and GPUs protect themselves by throttling. Check your hardware vendor's specifications." />
            </StackPanel>
          </c:SquircleBorder>

          <c:SquircleBorder Style="{StaticResource Card}" Padding="20,4,20,10">
            <StackPanel>
              <Border Style="{StaticResource Row}">
                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AlertsEnabled}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Row.Title}" Text="Enable alerts" />
                    <TextBlock Style="{StaticResource Row.Description}" Text="Alerts are evaluated even while the window is hidden." />
                  </StackPanel>
                </CheckBox>
              </Border>
              <Border Style="{StaticResource Row.Last}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Style="{StaticResource Row.Title}" Text="Repeat an alert at most every" />
                    <TextBlock Style="{StaticResource Row.Description}" Text="A rule also has to drop back below its threshold (with a small margin) before it can fire again." />
                  </StackPanel>
                  <ComboBox Style="{StaticResource Combo.Setting}" ItemsSource="{Binding CooldownOptions}" SelectedValue="{Binding CooldownMinutes}" MinWidth="160" />
                </Grid>
              </Border>
            </StackPanel>
          </c:SquircleBorder>

          <TextBlock Style="{StaticResource Group.Label}" Text="Rules" />
          <ItemsControl ItemsSource="{Binding Rules}" Focusable="False" IsEnabled="{Binding AlertsEnabled}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type pages:AlertRuleViewModel}">
                <c:SquircleBorder Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,10">
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBox Style="{StaticResource TextBox.Default}" Text="{Binding Name}" FontWeight="SemiBold" MaxWidth="360" HorizontalAlignment="Left" MinWidth="200"
                                 AutomationProperties.Name="Rule name" KeyDown="OnCommitOnEnter" />
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding MetricName}" Margin="2,4,0,0" />
                      </StackPanel>
                      <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Enabled}" VerticalAlignment="Top" Margin="12,6,0,0"
                                AutomationProperties.Name="Rule enabled" />
                      <Button Grid.Column="2" Style="{StaticResource Button.Icon}" Command="{Binding RemoveCommand}" VerticalAlignment="Top" Margin="8,2,0,0"
                              ToolTip="Delete rule" AutomationProperties.Name="Delete rule">
                        <Path Style="{StaticResource IconPath}" Width="10" Height="10" Data="{StaticResource Icon.Close}" />
                      </Button>
                    </Grid>
                    <WrapPanel Margin="0,12,0,0">
                      <TextBlock Text="Notify when it" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="0,0,8,6" />
                      <ComboBox Style="{StaticResource ComboBox.Default}" MinWidth="130" SelectedIndex="{Binding ComparisonIndex}" Margin="0,0,8,6">
                        <ComboBoxItem Content="rises above" />
                        <ComboBoxItem Content="falls below" />
                      </ComboBox>
                      <TextBox Style="{StaticResource TextBox.Default}" Width="74" Margin="0,0,6,6" Text="{Binding Threshold, StringFormat={}{0:0.#}}"
                               AutomationProperties.Name="Threshold" KeyDown="OnCommitOnEnter" />
                      <TextBlock Text="{Binding Unit}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="0,0,12,6" />
                      <TextBlock Text="for at least" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="0,0,8,6" />
                      <TextBox Style="{StaticResource TextBox.Default}" Width="60" Margin="0,0,6,6" Text="{Binding SustainSeconds}"
                               AutomationProperties.Name="Sustain seconds" KeyDown="OnCommitOnEnter" />
                      <TextBlock Text="seconds" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="0,0,0,6" />
                    </WrapPanel>
                  </StackPanel>
                </c:SquircleBorder>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <c:SquircleBorder Style="{StaticResource Card.Inset}" IsEnabled="{Binding AlertsEnabled}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="New rule for" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
              <ComboBox x:Name="NewRuleMetric" Grid.Column="1" Style="{StaticResource ComboBox.Default}" Margin="10,0"
                        ItemsSource="{Binding AlertMetricOptions}" DisplayMemberPath="Name" AutomationProperties.Name="Metric for new rule" />
              <Button Grid.Column="2" Style="{StaticResource Button.Secondary}" Command="{Binding AddRuleCommand}"
                      CommandParameter="{Binding SelectedItem, ElementName=NewRuleMetric}">
                <StackPanel Orientation="Horizontal">
                  <Path Style="{StaticResource IconPath}" Width="12" Height="12" Data="{StaticResource Icon.Plus}" />
                  <TextBlock Text="Add rule" Margin="6,0,0,0" />
                </StackPanel>
              </Button>
            </Grid>
          </c:SquircleBorder>
        </StackPanel>

        <!-- ======================================================================= -->
        <!-- Updates                                                                 -->
        <!-- ======================================================================= -->
        <StackPanel b:Motion.Entrance="True" Visibility="{Binding SelectedSection, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Updates}">
          <TextBlock Style="{StaticResource Panel.Header}" Text="Updates" />
          <TextBlock Style="{StaticResource Panel.Intro}" Text="Coreloom updates itself from its GitHub releases. Every download is checked against the release's SHA-256 checksums before it's installed. Only GitHub is contacted, and no hardware data is sent." />

          <StackPanel DataContext="{Binding Updates}">
            <!-- Status: check for updates, download progress (Install update sits in the What's new card below) -->
            <c:SquircleBorder Style="{StaticResource Card}">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border Style="{StaticResource UpdateStatus.Circle}">
                    <Path Style="{StaticResource UpdateStatus.Icon}" Data="{Binding StatusIcon, Converter={StaticResource IconKeyToGeometry}}" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Text.CardTitle}" Text="{Binding HeadlineText}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding DetailText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Button.Secondary}" Command="{Binding CheckCommand}"
                            Visibility="{Binding ShowCheckButton, Converter={StaticResource BoolToVisibility}}">
                      <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconPath}" Width="12" Height="12" Data="{StaticResource Icon.Refresh}" />
                        <TextBlock Text="Check for updates" Margin="6,0,0,0" />
                      </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Button.Primary}" Command="{Binding InstallCommand}"
                            Visibility="{Binding ShowStatusInstallButton, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="Downloads the update if needed, closes Coreloom, installs it and opens Coreloom again.">
                      <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconPath}" Width="12" Height="12" Data="{StaticResource Icon.Download}" Stroke="{DynamicResource Brush.OnAccent}" />
                        <TextBlock Text="Install update" Margin="6,0,0,0" />
                      </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Button.Secondary}" Content="Cancel" Command="{Binding CancelDownloadCommand}"
                            Visibility="{Binding ShowCancelButton, Converter={StaticResource BoolToVisibility}}" />
                  </StackPanel>
                </Grid>
                <ProgressBar Style="{StaticResource ProgressBar.Thin}" Margin="54,14,0,0"
                             Value="{Binding Progress, Mode=OneWay, Converter={StaticResource FractionToPercent}}"
                             Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}" />
                <ProgressBar Style="{StaticResource ProgressBar.Thin}" Margin="54,14,0,0" IsIndeterminate="True"
                             Visibility="{Binding IsChecking, Converter={StaticResource BoolToVisibility}}" />
              </StackPanel>
            </c:SquircleBorder>

            <!-- What's new in the version that is available / downloading / ready -->
            <c:SquircleBorder Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="{Binding ShowUpdateSummary, Converter={StaticResource BoolToVisibility}}">
              <StackPanel>
                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Path Style="{StaticResource IconPath}" Width="16" Height="16" Data="{StaticResource Icon.Sparkle}" Stroke="{DynamicResource Brush.Accent}" VerticalAlignment="Top" Margin="0,2,0,0" />
                  <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Style="{StaticResource Text.CardTitle}" Text="{Binding UpdateSummary.Heading}" />
                    <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding UpdateSummary.PublishedText}" Margin="0,2,0,0"
                               Visibility="{Binding UpdateSummary.PublishedText, Converter={StaticResource HasValueToVisibility}}" />
                  </StackPanel>
                </Grid>
                <ContentControl Content="{Binding UpdateSummary}" ContentTemplate="{StaticResource WhatsNewBody}" Focusable="False" />
                <WrapPanel Margin="0,14,0,0">
                  <Button Style="{StaticResource Button.Primary}" Command="{Binding InstallCommand}" Margin="0,0,8,0"
                          Visibility="{Binding ShowInstallButton, Converter={StaticResource BoolToVisibility}}"
                          ToolTip="Downloads the update if needed, closes Coreloom, installs it and opens Coreloom again.">
                    <StackPanel Orientation="Horizontal">
                      <Path Style="{StaticResource IconPath}" Width="12" Height="12" Data="{StaticResource Icon.Download}" Stroke="{DynamicResource Brush.OnAccent}" />
                      <TextBlock Text="Install update" Margin="6,0,0,0" />
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource Button.Subtle}" Content="Skip this version" Command="{Binding SkipCommand}"
                          ToolTip="Don't install this version. You'll hear about the next one." />
                </WrapPanel>
              </StackPanel>
            </c:SquircleBorder>

            <!-- What's new in the running version (after Coreloom updated itself) -->
            <c:SquircleBorder Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="{Binding ShowInstalledSummary, Converter={StaticResource BoolToVisibility}}">
              <StackPanel>
                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Path Style="{StaticResource IconPath}" Width="16" Height="16" Data="{StaticResource Icon.Sparkle}" Stroke="{DynamicResource Brush.Accent}" VerticalAlignment="Top" Margin="0,2,0,0" />
                  <TextBlock Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource Text.CardTitle}" Text="{Binding InstalledHeading}" />
                </Grid>
                <ContentControl Content="{Binding InstalledSummary}" ContentTemplate="{StaticResource WhatsNewBody}" Focusable="False"
                                Visibility="{Binding InstalledSummary, Converter={StaticResource HasValueToVisibility}}" />
                <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding InstalledSummaryFallback}" TextWrapping="Wrap"
                           Visibility="{Binding InstalledSummary, Converter={StaticResource HasValueToVisibility}, ConverterParameter=Invert}" />
                <Button Style="{StaticResource Button.Secondary}" Command="{Binding OpenInstalledReleaseCommand}" Margin="0,10,0,0" HorizontalAlignment="Left">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Release notes on GitHub" />
                    <Path Style="{StaticResource IconPath}" Width="11" Height="11" Data="{StaticResource Icon.External}" Margin="6,0,0,0" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </c:SquircleBorder>
          </StackPanel>

          <!-- Preferences -->
          <c:SquircleBorder Style="{StaticResource Card}" Padding="20,4,20,10" Margin="0,12,0,0">
            <StackPanel>
              <Border Style="{StaticResource Row}">
                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Updates.AutoInstall}" IsEnabled="{Binding Updates.CanInstall}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Row.Title}" Text="Update automatically" />
                    <TextBlock Style="{StaticResource Row.Description}" Text="{Binding Updates.AutoInstallDescription}" />
                  </StackPanel>
                </CheckBox>
              </Border>
              <Border Style="{StaticResource Row}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Row.Title}" Text="Check for updates" />
                    <TextBlock Style="{StaticResource Row.Description}" Text="How often Coreloom looks for a new version on its own." />
                  </StackPanel>
                  <ComboBox Style="{StaticResource Combo.Setting}" ItemsSource="{Binding UpdateFrequencyOptions}" SelectedValue="{Binding UpdateFrequency}" />
                </Grid>
              </Border>
              <Border Style="{StaticResource Row.Last}">
                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IncludePrereleases}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Row.Title}" Text="Include pre-release versions" />
                    <TextBlock Style="{StaticResource Row.Description}" Text="Get beta builds before they are marked stable." />
                  </StackPanel>
                </CheckBox>
              </Border>
            </StackPanel>
          </c:SquircleBorder>
        </StackPanel>

        <!-- ======================================================================= -->
        <!-- Diagnostics                                                             -->
        <!-- ======================================================================= -->
        <StackPanel b:Motion.Entrance="True" Visibility="{Binding SelectedSection, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Diagnostics}">
          <TextBlock Style="{StaticResource Panel.Header}" Text="Diagnostics" />
          <TextBlock Style="{StaticResource Panel.Intro}" Text="What Coreloom can read on this PC, how each sensor source is doing, and what Coreloom itself costs." />

          <c:SquircleBorder Style="{StaticResource Card}">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Shield}" VerticalAlignment="Top" Margin="0,2,0,0" />
                <StackPanel Grid.Column="1" Margin="12,0,12,0">
                  <TextBlock Style="{StaticResource Text.CardTitle}" Text="{Binding PrivilegeText}" />
                  <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding PawnIoText}" Margin="0,3,0,0" />
                  <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding LowLevelExplanation}" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <Button Style="{StaticResource Button.Subtle}" Margin="0,6,0,0" Command="{Binding OpenPawnIoCommand}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="About PawnIO" />
                      <Path Style="{StaticResource IconPath}" Width="11" Height="11" Data="{StaticResource Icon.External}" Margin="6,0,0,0" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Grid>
            </StackPanel>
          </c:SquircleBorder>

          <TextBlock Style="{StaticResource Group.Label}" Text="Sensor sources" />
          <c:SquircleBorder Style="{StaticResource Card}">
            <ItemsControl ItemsSource="{Binding Providers}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type pages:ProviderStatusItem}">
                  <Grid Margin="0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="190" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource Brush.Elevated}" VerticalAlignment="Top" Margin="0,5,0,0" />
                    <StackPanel Grid.Column="1" Margin="10,0,12,0">
                      <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                      <TextBlock Text="{Binding State}" Style="{StaticResource Text.Caption}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Message}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding Timing}" Style="{StaticResource Text.Caption}" FontFamily="{StaticResource MonoFont}" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0" />
                  </Grid>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsHealthy}" Value="True">
                      <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.Success}" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </c:SquircleBorder>

          <TextBlock Style="{StaticResource Group.Label}" Text="Coreloom's own overhead" />
          <c:SquircleBorder Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="{Binding OverheadText}" FontSize="12.5" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" />
              <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                         Text="Measured live from Coreloom's own process. CPU is a share of the whole machine (all logical processors)." />
            </StackPanel>
          </c:SquircleBorder>

          <c:SquircleBorder Style="{StaticResource Card}" Padding="20,4,20,10" Margin="0,12,0,0">
            <StackPanel>
              <Border Style="{StaticResource Row}">
                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding VerboseLogging}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Row.Title}" Text="Verbose logging" />
                    <TextBlock Style="{StaticResource Row.Description}" Text="Writes more detail to the local log files. Logs never leave this PC." />
                  </StackPanel>
                </CheckBox>
              </Border>
              <WrapPanel Margin="0,14,0,4">
                <Button Style="{StaticResource Button.Secondary}" Command="{Binding ExportReportCommand}" Margin="0,0,8,8"
                        ToolTip="Saves a Markdown report of detected hardware, sensor sources and current readings. Review it before sharing.">
                  <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource IconPath}" Width="12" Height="12" Data="{StaticResource Icon.Download}" />
                    <TextBlock Text="Export diagnostic report" Margin="6,0,0,0" />
                  </StackPanel>
                </Button>
                <Button Style="{StaticResource Button.Secondary}" Command="{Binding ViewLogsCommand}" Margin="0,0,8,8"
                        ToolTip="Opens the log viewer: every entry with its time, searchable and filtered by level and category.">
                  <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource IconPath}" Width="12" Height="12" Data="{StaticResource Icon.List}" />
                    <TextBlock Text="View logs" Margin="6,0,0,0" />
                  </StackPanel>
                </Button>
                <Button Style="{StaticResource Button.Secondary}" Command="{Binding OpenLogsCommand}" Margin="0,0,8,8">
                  <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource IconPath}" Width="12" Height="12" Data="{StaticResource Icon.Folder}" />
                    <TextBlock Text="Open log folder" Margin="6,0,0,0" />
                  </StackPanel>
                </Button>
                <Button Style="{StaticResource Button.Secondary}" Command="{Binding RescanCommand}" Margin="0,0,8,8"
                        ToolTip="Re-detects hardware and restarts every sensor source (useful after a driver update).">
                  <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource IconPath}" Width="12" Height="12" Data="{StaticResource Icon.Refresh}" />
                    <TextBlock Text="Rescan hardware" Margin="6,0,0,0" />
                  </StackPanel>
                </Button>
              </WrapPanel>
            </StackPanel>
          </c:SquircleBorder>
        </StackPanel>

        <!-- ======================================================================= -->
        <!-- Logs                                                                    -->
        <!-- ======================================================================= -->
        <StackPanel b:Motion.Entrance="True" DataContext="{Binding Logs}"
                    Visibility="{Binding DataContext.SelectedSection, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Logs}">
          <TextBlock Style="{StaticResource Panel.Header}" Text="Logs" />
          <TextBlock Style="{StaticResource Panel.Intro}" Text="Everything Coreloom has written to its log on this PC, newest first: what it found, what it changed and anything that went wrong. Logs never leave this PC." />

          <c:SquircleBorder Style="{StaticResource Card}" Padding="16,14,6,10">
            <StackPanel>
              <WrapPanel Margin="0,0,10,4">
                <Grid Width="300" Margin="0,0,10,8" VerticalAlignment="Center">
                  <TextBox x:Name="LogSearch" Style="{StaticResource TextBox.Default}" Padding="32,7,10,7" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                           AutomationProperties.Name="Search the log" />
                  <Path Style="{StaticResource IconPath}" Width="13" Height="13" Data="{StaticResource Icon.Search}" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False" />
                  <TextBlock Text="Search (process name, PID, words…)" Style="{StaticResource Text.Secondary}" Margin="33,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                              <Condition Binding="{Binding Text, ElementName=LogSearch}" Value="" />
                              <Condition Binding="{Binding IsKeyboardFocused, ElementName=LogSearch}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                          </MultiDataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Grid>
                <ComboBox Style="{StaticResource ComboBox.Default}" MinWidth="170" Margin="0,0,10,8" VerticalAlignment="Center" ItemsSource="{Binding LevelOptions}"
                          DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding MinimumLevel}" AutomationProperties.Name="Level" ToolTip="Level" />
                <ComboBox Style="{StaticResource ComboBox.Default}" MinWidth="170" Margin="0,0,10,8" VerticalAlignment="Center" ItemsSource="{Binding Categories}"
                          SelectedItem="{Binding Category}" AutomationProperties.Name="Category" ToolTip="Category" />
                <Button Style="{StaticResource Button.Subtle}" Margin="0,0,6,8" Command="{Binding ClearFiltersCommand}" Content="Clear filters" VerticalAlignment="Center" />
              </WrapPanel>
              <Grid Margin="0,0,10,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <Button Style="{StaticResource Button.Subtle}" Command="{Binding CopyCommand}" ToolTip="Copies the selected entry, or every entry shown when none is selected" Margin="0,0,6,0">
                    <TextBlock Text="Copy" />
                  </Button>
                  <Button Style="{StaticResource Button.Secondary}" Command="{Binding RefreshCommand}" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                      <Path Style="{StaticResource IconPath}" Width="12" Height="12" Data="{StaticResource Icon.Refresh}" />
                      <TextBlock Text="Refresh" Margin="6,0,0,0" />
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource Button.Secondary}" Command="{Binding OpenFolderCommand}" ToolTip="{Binding LogDirectory}">
                    <StackPanel Orientation="Horizontal">
                      <Path Style="{StaticResource IconPath}" Width="12" Height="12" Data="{StaticResource Icon.Folder}" />
                      <TextBlock Text="Open logs" Margin="6,0,0,0" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Grid>
              <Border Style="{StaticResource Divider}" Margin="0,0,10,4" />
              <Grid>
                <ListBox Height="560" ItemsSource="{Binding Lines}" SelectedItem="{Binding Selected}" ItemTemplate="{StaticResource LogLine}" ItemContainerStyle="{StaticResource LogItem}"
                         Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                         AutomationProperties.Name="Log entries">
                  <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                      <ScrollViewer Style="{StaticResource ScrollViewer.Page}" CanContentScroll="True" b:ScrollChain.Enabled="True" Focusable="False">
                        <ItemsPresenter />
                      </ScrollViewer>
                    </ControlTemplate>
                  </ListBox.Template>
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                </ListBox>
                <TextBlock Text="No entries match. Clear the filters to see everything." Style="{StaticResource Text.Secondary}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,30,0,0"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                <c:RadialGauge Style="{StaticResource Spinner}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,30,0,0" b:Spin.IsSpinning="{Binding IsLoading}"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
              </Grid>
            </StackPanel>
          </c:SquircleBorder>
        </StackPanel>

        <!-- ======================================================================= -->
        <!-- About                                                                   -->
        <!-- ======================================================================= -->
        <StackPanel b:Motion.Entrance="True" Visibility="{Binding SelectedSection, Converter={StaticResource EqualsToVisibility}, ConverterParameter=About}">
          <TextBlock Style="{StaticResource Panel.Header}" Text="About" />
          <c:SquircleBorder Style="{StaticResource Card}" Margin="0,10,0,0">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Image Source="{DynamicResource Image.AppIconLarge}" Width="56" Height="56" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="Coreloom" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                  <TextBlock Text="{Binding VersionText}" Style="{StaticResource Text.Secondary}" Margin="0,2,0,0" />
                </StackPanel>
              </StackPanel>
              <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,16,0,0"
                         Text="A native Windows hardware monitor. Coreloom only reads sensors: it never changes clocks, voltages, fan curves or firmware settings, never installs drivers, and never sends your data anywhere." />
              <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Style="{StaticResource Button.Secondary}" Command="{Binding OpenRepositoryCommand}" Margin="0,0,8,0">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding RepositoryText, TargetNullValue='Source code'}" />
                    <Path Style="{StaticResource IconPath}" Width="11" Height="11" Data="{StaticResource Icon.External}" Margin="6,0,0,0" />
                  </StackPanel>
                </Button>
                <Button Style="{StaticResource Button.Subtle}" Content="Third-party notices" Command="{Binding OpenNoticesCommand}" />
              </StackPanel>
              <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,16,0,0"
                         Text="Released under the MIT License. Uses LibreHardwareMonitorLib (MPL-2.0), CommunityToolkit.Mvvm (MIT) and NVIDIA's NVML library that ships with the NVIDIA driver. NVIDIA, GeForce and RTX are trademarks of NVIDIA Corporation; AMD and Ryzen are trademarks of Advanced Micro Devices, Inc. Coreloom is not affiliated with either." />
            </StackPanel>
          </c:SquircleBorder>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>
