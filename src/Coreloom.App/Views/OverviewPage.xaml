<UserControl x:Class="Coreloom.App.Views.OverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Coreloom.App.Controls"
             xmlns:b="clr-namespace:Coreloom.App.Behaviors"
             xmlns:views="clr-namespace:Coreloom.App.Views"
             xmlns:pages="clr-namespace:Coreloom.ViewModels.Pages;assembly=Coreloom.ViewModels">

  <UserControl.Resources>
    <!-- Card and panel templates (resolved by type inside the dashboard tiles). Each fills its tile, so a card made
         bigger on the dashboard grows its chart, list or sparkline. -->
    <DataTemplate DataType="{x:Type pages:SummaryCardViewModel}">
      <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource SummaryCard}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type pages:ChartPanelViewModel}">
      <ContentPresenter Content="{Binding Chart}" ContentTemplate="{StaticResource ChartCard}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type pages:MemoryPanelViewModel}">
      <c:SquircleBorder Style="{StaticResource Card.Glow}" GlowKey="Memory" GlowStrength="0.8" MinHeight="300">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Style="{StaticResource Text.CardTitle}" Text="Memory" />
          <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="168" Height="168" VerticalAlignment="Center">
              <c:DonutChart Segments="{Binding Segments}" Thickness="14" />
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding CenterText}" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                <TextBlock Text="in use" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" />
              </StackPanel>
            </Grid>
            <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding Caption}" Style="{StaticResource Text.Secondary}" Margin="0,0,0,10" />
              <ItemsControl ItemsSource="{Binding Segments}" ItemTemplate="{StaticResource DonutLegendRow}" Focusable="False" />
              <Border Style="{StaticResource Divider}" Margin="0,10" />
              <ItemsControl ItemsSource="{Binding Details}" ItemTemplate="{StaticResource KeyValueRow}" Focusable="False" Grid.IsSharedSizeScope="True" />
            </StackPanel>
          </Grid>
        </Grid>
      </c:SquircleBorder>
    </DataTemplate>

    <DataTemplate DataType="{x:Type pages:StoragePanelViewModel}">
      <c:SquircleBorder Style="{StaticResource Card.Glow}" GlowKey="Storage" GlowStrength="0.8" MinHeight="300">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid>
            <TextBlock Style="{StaticResource Text.CardTitle}" Text="Storage" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Ellipse Width="7" Height="7" Fill="{DynamicResource Series.Read.Brush}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Read.Number}" FontWeight="SemiBold" Margin="6,0,2,0" FontSize="12" />
              <TextBlock Text="{Binding Read.Unit}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
              <Ellipse Width="7" Height="7" Fill="{DynamicResource Series.Write.Brush}" VerticalAlignment="Center" Margin="14,0,0,0" />
              <TextBlock Text="{Binding Write.Number}" FontWeight="SemiBold" Margin="6,0,2,0" FontSize="12" />
              <TextBlock Text="{Binding Write.Unit}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
            </StackPanel>
          </Grid>
          <c:HeightCap Grid.Row="1" Margin="0,10,0,0" Cap="250">
            <ScrollViewer Style="{StaticResource ScrollViewer.Page}" b:ScrollChain.Enabled="True">
              <ItemsControl ItemsSource="{Binding Volumes}" ItemTemplate="{StaticResource VolumeRow}" Focusable="False" />
            </ScrollViewer>
          </c:HeightCap>
        </Grid>
      </c:SquircleBorder>
    </DataTemplate>

    <DataTemplate DataType="{x:Type pages:NetworkPanelViewModel}">
      <c:SquircleBorder Style="{StaticResource Card}" MinHeight="300">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid>
            <TextBlock Style="{StaticResource Text.CardTitle}" Text="Network" />
            <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding AdapterName}" HorizontalAlignment="Right" MaxWidth="220" />
          </Grid>
          <Grid Grid.Row="1" Margin="0,14,0,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource IconPath}" Width="12" Height="12" Data="M12,4 L12,20 M6,14 L12,20 18,14" Stroke="{DynamicResource Series.NetworkDown.Brush}" />
                <TextBlock Text="Download" Style="{StaticResource Text.Label}" Margin="6,0,0,0" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Style="{StaticResource Text.Value}" b:AnimatedText.Formatter="{Binding Download.NumberFormatter}" b:AnimatedText.Value="{Binding Download.Value}" />
                <TextBlock Style="{StaticResource Text.Unit}" Text="{Binding Download.Unit}" VerticalAlignment="Bottom" Margin="4,0,0,3" />
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1">
              <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource IconPath}" Width="12" Height="12" Data="M12,20 L12,4 M6,10 L12,4 18,10" Stroke="{DynamicResource Series.NetworkUp.Brush}" />
                <TextBlock Text="Upload" Style="{StaticResource Text.Label}" Margin="6,0,0,0" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Style="{StaticResource Text.Value}" b:AnimatedText.Formatter="{Binding Upload.NumberFormatter}" b:AnimatedText.Value="{Binding Upload.Value}" />
                <TextBlock Style="{StaticResource Text.Unit}" Text="{Binding Upload.Unit}" VerticalAlignment="Bottom" Margin="4,0,0,3" />
              </StackPanel>
            </StackPanel>
          </Grid>
          <c:LiveLineChart Grid.Row="2" MinHeight="140" Chart="{Binding Chart}"
                           Timeline="{Binding DataContext.Timeline, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </Grid>
      </c:SquircleBorder>
    </DataTemplate>

    <!-- System health: the overall status, then the graphics card, processor, and memory and drives side by side.
         The parts' content is capped so a narrow window doesn't make every dashboard row taller; drag the card taller to
         see more. -->
    <DataTemplate DataType="{x:Type pages:HealthPanelViewModel}">
      <c:SquircleBorder Style="{StaticResource Card.Glow}" Padding="18,14,18,12" GlowStrength="0.7"
                        GlowKey="{Binding Health.OverallKey, Converter={StaticResource StatusToGlowKey}}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid>
            <StackPanel Orientation="Horizontal">
              <Path x:Name="Shield" Style="{StaticResource IconPath}" Width="16" Height="16" Data="{StaticResource Icon.Shield}"
                    Stroke="{DynamicResource Brush.TextTertiary}" StrokeThickness="1.8" VerticalAlignment="Center" />
              <TextBlock Style="{StaticResource Text.CardTitle}" Text="System health" Margin="9,0,0,0" VerticalAlignment="Center" />
              <Border x:Name="Pill" CornerRadius="9" Padding="9,2" Margin="10,0,0,0" VerticalAlignment="Center" Background="{DynamicResource Brush.ControlHover}">
                <TextBlock x:Name="Overall" Text="{Binding Health.OverallText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" />
              </Border>
            </StackPanel>
            <TextBlock Text="{Binding Health.OverallSummary}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Margin="200,0,0,0" />
          </Grid>
          <c:HeightCap Grid.Row="1" Cap="140" Margin="0,12,0,0" ClipToBounds="True">
            <ItemsControl ItemsSource="{Binding Health.Parts}" Focusable="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <c:AdaptiveGrid MinColumnWidth="150" MaxColumns="4" Spacing="24" RowSpacing="12" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type pages:HealthReportViewModel}">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                      <Path Style="{StaticResource IconPath}" Width="14" Height="14" Data="{Binding IconKey, Converter={StaticResource IconKeyToGeometry}}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" Margin="8,0,0,0" VerticalAlignment="Center" />
                      <TextBlock x:Name="Status" Text="{Binding StatusText}" FontSize="12.5" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"
                                 Foreground="{DynamicResource Brush.TextSecondary}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Checks}" ItemTemplate="{StaticResource HealthCheckLine}" Focusable="False" />
                  </StackPanel>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding StatusKey}" Value="Excellent">
                      <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource Brush.Success}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding StatusKey}" Value="Good">
                      <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource Brush.Info}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding StatusKey}" Value="Attention">
                      <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource Brush.Critical}" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </c:HeightCap>
        </Grid>
      </c:SquircleBorder>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Health.OverallKey}" Value="Excellent">
          <Setter TargetName="Shield" Property="Stroke" Value="{DynamicResource Brush.Success}" />
          <Setter TargetName="Overall" Property="Foreground" Value="{DynamicResource Brush.Success}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Health.OverallKey}" Value="Good">
          <Setter TargetName="Shield" Property="Stroke" Value="{DynamicResource Brush.Info}" />
          <Setter TargetName="Overall" Property="Foreground" Value="{DynamicResource Brush.Info}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Health.OverallKey}" Value="Attention">
          <Setter TargetName="Shield" Property="Stroke" Value="{DynamicResource Brush.Critical}" />
          <Setter TargetName="Overall" Property="Foreground" Value="{DynamicResource Brush.Critical}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A card on the dashboard grid: the card itself, a grip at the top and a corner to resize it (both show on hover),
         and a right-click menu. The card can be dragged from anywhere that isn't a control. -->
    <DataTemplate x:Key="DashboardTile" DataType="{x:Type pages:DashboardTileViewModel}">
      <Grid x:Name="Tile" Background="Transparent" AutomationProperties.Name="{Binding Name}">
        <Grid.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Wider" Command="{Binding WiderCommand}" />
            <MenuItem Header="Narrower" Command="{Binding NarrowerCommand}" />
            <MenuItem Header="Taller" Command="{Binding TallerCommand}" />
            <MenuItem Header="Shorter" Command="{Binding ShorterCommand}" />
            <MenuItem Header="Reset size" Command="{Binding ResetSizeCommand}" />
            <Separator />
            <MenuItem Header="Hide card" Command="{Binding HideCommand}" />
          </ContextMenu>
        </Grid.ContextMenu>

        <ContentPresenter Content="{Binding Content}" />

        <Border x:Name="Grip" c:DashboardGrid.Handle="Move" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0"
                Width="44" Height="13" Background="Transparent" Cursor="SizeAll" Opacity="0" ToolTip="Drag to move">
          <UniformGrid Rows="2" Columns="3" Width="15" Height="7" IsHitTestVisible="False">
            <Ellipse Width="2.6" Height="2.6" Fill="{DynamicResource Brush.TextTertiary}" />
            <Ellipse Width="2.6" Height="2.6" Fill="{DynamicResource Brush.TextTertiary}" />
            <Ellipse Width="2.6" Height="2.6" Fill="{DynamicResource Brush.TextTertiary}" />
            <Ellipse Width="2.6" Height="2.6" Fill="{DynamicResource Brush.TextTertiary}" />
            <Ellipse Width="2.6" Height="2.6" Fill="{DynamicResource Brush.TextTertiary}" />
            <Ellipse Width="2.6" Height="2.6" Fill="{DynamicResource Brush.TextTertiary}" />
          </UniformGrid>
        </Border>

        <Border x:Name="Corner" c:DashboardGrid.Handle="Resize" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,3"
                Width="18" Height="18" Background="Transparent" Cursor="SizeNWSE" Opacity="0" ToolTip="Drag to resize">
          <Path Data="M 13,5 L 5,13 M 13,9.5 L 9.5,13" Stroke="{DynamicResource Brush.TextTertiary}" StrokeThickness="1.5"
                StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False" />
        </Border>
      </Grid>
      <DataTemplate.Triggers>
        <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
          <Setter TargetName="Grip" Property="Opacity" Value="1" />
          <Setter TargetName="Corner" Property="Opacity" Value="1" />
        </Trigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- One lighting color in the Customize card: a swatch with its name underneath. -->
    <DataTemplate x:Key="GlowSwatch" DataType="{x:Type pages:GlowOptionViewModel}">
      <Button Width="62" Margin="0,0,4,0" Cursor="Hand" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}"
              Command="{Binding DataContext.Specs.SelectGlowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
              CommandParameter="{Binding}">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <StackPanel Background="Transparent">
              <Grid Width="34" Height="34" HorizontalAlignment="Center">
                <Ellipse StrokeThickness="2" Stroke="{DynamicResource Brush.Text}"
                         Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" />
                <Grid x:Name="Dot" Margin="6">
                  <Ellipse Fill="{Binding Hex, Converter={StaticResource HexToBrush}}" />
                  <Ellipse Visibility="{Binding IsRainbow, Converter={StaticResource BoolToVisibility}}">
                    <Ellipse.Fill>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#FF2933" />
                        <GradientStop Offset="0.25" Color="#FFC21A" />
                        <GradientStop Offset="0.5" Color="#1AD96B" />
                        <GradientStop Offset="0.75" Color="#0D6BFF" />
                        <GradientStop Offset="1" Color="#9E4DFF" />
                      </LinearGradientBrush>
                    </Ellipse.Fill>
                  </Ellipse>
                  <Ellipse Fill="{DynamicResource Brush.Accent}" Visibility="{Binding IsAccent, Converter={StaticResource BoolToVisibility}}" />
                  <Ellipse Stroke="#40FFFFFF" StrokeThickness="1" Visibility="{Binding IsAccent, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
              </Grid>
              <TextBlock x:Name="Label" Text="{Binding Name}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center"
                         TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Dot" Property="Margin" Value="5" />
                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Brush.Text}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Dot" Property="Margin" Value="5" />
              </Trigger>
              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Brush.Text}" />
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Button.Template>
      </Button>
    </DataTemplate>

    <!-- One card or panel in the Customize card: shown or not, and its place in the order. -->
    <DataTemplate x:Key="DashboardCardRow" DataType="{x:Type pages:DashboardCardSettingViewModel}">
      <Grid Margin="0,1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <CheckBox Style="{StaticResource CheckBox.Compact}" IsChecked="{Binding IsVisible}">
          <TextBlock Text="{Binding Name}" FontSize="13" />
        </CheckBox>
        <TextBlock Grid.Column="1" Text="{Binding Kind}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="12,0" />
        <Button Grid.Column="2" Style="{StaticResource Button.Icon}" Command="{Binding MoveUpCommand}" ToolTip="Move up" AutomationProperties.Name="Move up">
          <Path Style="{StaticResource IconPath}" Width="12" Height="12" Data="{StaticResource Icon.ChevronUp}" />
        </Button>
        <Button Grid.Column="3" Style="{StaticResource Button.Icon}" Command="{Binding MoveDownCommand}" ToolTip="Move down" AutomationProperties.Name="Move down">
          <Path Style="{StaticResource IconPath}" Width="12" Height="12" Data="{StaticResource Icon.ChevronDown}" />
        </Button>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.InputBindings>
    <KeyBinding Key="Escape" Command="{Binding Customize.CloseCommand}" />
  </UserControl.InputBindings>

  <Grid>
    <ScrollViewer Style="{StaticResource ScrollViewer.Window}">
      <StackPanel Margin="32,14,28,32" b:Motion.Entrance="True">
        <!-- This PC: its picture (or the user's own render of the build), board name, graphics card and key specs.
             It stays put; the cards under it can be moved and resized. -->
        <c:SquircleBorder Margin="0,0,0,16" GlowKey="Accent" GlowStrength="1.3" EdgeGlow="True" Sheen="0.8">
          <c:SquircleBorder.Style>
            <Style TargetType="Border" BasedOn="{StaticResource Card}">
              <Setter Property="Padding" Value="14,14,22,14" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding ShowPcPicture}" Value="False">
                  <Setter Property="Padding" Value="24,18,22,16" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </c:SquircleBorder.Style>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- Shown or not, lighting color and fans: see Customize -->
            <Border Visibility="{Binding ShowPcPicture, Converter={StaticResource BoolToVisibility}}" VerticalAlignment="Center">
              <views:PcIllustration Width="196" Height="234" DataContext="{Binding Specs}"
                                    Glow="{Binding Glow}" TopFanSpeed="{Binding TopFanSpeed}" BottomFanSpeed="{Binding BottomFanSpeed}"
                                    AnimateFans="{Binding AnimateFans}" />
            </Border>

            <Grid Grid.Column="1" VerticalAlignment="Center">
              <Grid.Style>
                <Style TargetType="Grid">
                  <Setter Property="Margin" Value="22,6,0,6" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ShowPcPicture}" Value="False">
                      <Setter Property="Margin" Value="0" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Grid.Style>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Specs.Title}" ToolTip="{Binding Specs.Title}" FontSize="22" FontWeight="SemiBold"
                         Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Row="1" Text="{Binding Specs.Subtitle}" Style="{StaticResource Text.Secondary}" FontSize="14" Margin="0,3,0,0"
                         TextTrimming="CharacterEllipsis" />
              <Button Grid.Column="1" Grid.RowSpan="2" Style="{StaticResource Button.Subtle}" VerticalAlignment="Top" Margin="16,0,0,0"
                      Command="{Binding CustomizeCommand}" Padding="10,5" ToolTip="PC picture, lighting and which cards the dashboard shows">
                <StackPanel Orientation="Horizontal">
                  <Path Style="{StaticResource IconPath}" Width="14" Height="14" Data="{StaticResource Icon.Edit}" />
                  <TextBlock Text="Customize" Margin="8,0,0,0" Foreground="{DynamicResource Brush.TextSecondary}" />
                </StackPanel>
              </Button>

              <c:AdaptiveGrid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,16,0,0" MinColumnWidth="250" MaxColumns="2" Spacing="40" RowSpacing="0">
                <ItemsControl ItemsSource="{Binding Specs.LeftSpecs}" ItemTemplate="{StaticResource KeyValueRow}" Focusable="False" Grid.IsSharedSizeScope="True" />
                <ItemsControl ItemsSource="{Binding Specs.RightSpecs}" ItemTemplate="{StaticResource KeyValueRow}" Focusable="False" Grid.IsSharedSizeScope="True" />
              </c:AdaptiveGrid>
            </Grid>
          </Grid>
        </c:SquircleBorder>

        <!-- The dashboard: cards and panels on one grid. Drag a card to move it, drag its corner to resize it. -->
        <ItemsControl ItemsSource="{Binding Tiles}" ItemTemplate="{StaticResource DashboardTile}" Focusable="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <c:DashboardGrid MinColumnWidth="232" Spacing="16"
                               MoveCommand="{Binding MoveTileCommand}" ResizeCommand="{Binding ResizeTileCommand}" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemContainerStyle>
            <Style TargetType="ContentPresenter">
              <Setter Property="c:DashboardGrid.Order" Value="{Binding Order}" />
              <Setter Property="c:DashboardGrid.ColumnSpan" Value="{Binding ColumnSpan}" />
              <Setter Property="c:DashboardGrid.RowSpan" Value="{Binding RowSpan}" />
              <Setter Property="c:DashboardGrid.MinColumns" Value="{Binding MinColumns}" />
              <Setter Property="c:DashboardGrid.MinRows" Value="{Binding MinRows}" />
            </Style>
          </ItemsControl.ItemContainerStyle>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <!-- Customize: a card over the dashboard; every change applies right away, so the dashboard updates behind it -->
    <Grid Visibility="{Binding Customize.IsOpen, Converter={StaticResource BoolToVisibility}}">
      <Grid.Style>
        <Style TargetType="Grid">
          <Style.Triggers>
            <DataTrigger Binding="{Binding Customize.IsOpen}" Value="True">
              <DataTrigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.16" />
                  </Storyboard>
                </BeginStoryboard>
              </DataTrigger.EnterActions>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Grid.Style>

      <!-- Clicking outside the card closes it -->
      <Border Background="{DynamicResource Brush.Scrim}">
        <Border.InputBindings>
          <MouseBinding MouseAction="LeftClick" Command="{Binding Customize.CloseCommand}" />
        </Border.InputBindings>
      </Border>

      <c:SquircleBorder Style="{StaticResource Card}" Width="540" Margin="32" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center"
              AutomationProperties.Name="Customize dashboard">
        <c:SquircleBorder.Effect>
          <DropShadowEffect BlurRadius="40" ShadowDepth="10" Direction="270" Opacity="0.35" Color="#000000" />
        </c:SquircleBorder.Effect>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid Margin="22,18,14,6">
            <StackPanel Margin="0,0,40,0">
              <TextBlock Style="{StaticResource Text.CardTitle}" Text="Customize dashboard" FontSize="16" />
              <TextBlock Style="{StaticResource Text.Caption}" Text="Changes apply right away." Margin="0,3,0,0" />
            </StackPanel>
            <Button Style="{StaticResource Button.Icon}" HorizontalAlignment="Right" VerticalAlignment="Top" Width="32" Height="32"
                    Command="{Binding Customize.CloseCommand}" ToolTip="Close" AutomationProperties.Name="Close">
              <Path Style="{StaticResource IconPath}" Width="14" Height="14" Data="{StaticResource Icon.Close}" />
            </Button>
          </Grid>

          <ScrollViewer Grid.Row="1" Style="{StaticResource ScrollViewer.Page}">
            <StackPanel Margin="22,10,22,6">
              <TextBlock Style="{StaticResource Text.Label}" Text="PC picture" />
              <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Customize.ShowPcPicture}" Margin="0,10,0,0">
                <StackPanel>
                  <TextBlock Text="Show the PC picture" FontSize="13.5" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" />
                  <TextBlock Style="{StaticResource Text.Caption}" Text="On the left of the header, with its lighting and turning fans."
                             TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>
              </CheckBox>

              <StackPanel Margin="0,14,0,0" IsEnabled="{Binding Customize.ShowPcPicture}">
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Style.Triggers>
                      <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.45" />
                      </Trigger>
                    </Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <TextBlock Style="{StaticResource Text.Caption}" Text="Lighting color. Rainbow cycles slowly through the colors." TextWrapping="Wrap" Margin="0,0,0,10" />
                <ItemsControl ItemsSource="{Binding Specs.GlowOptions}" ItemTemplate="{StaticResource GlowSwatch}" Focusable="False">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
              </StackPanel>

              <Border Style="{StaticResource Divider}" Margin="0,18,0,16" />

              <TextBlock Style="{StaticResource Text.Label}" Text="Cards" />
              <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Customize.ShowStatistics}" Margin="0,10,0,10">
                <StackPanel>
                  <TextBlock Text="Show minimum, maximum and average on cards" FontSize="13.5" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" />
                  <TextBlock Style="{StaticResource Text.Caption}" Text="Calculated over the selected chart window." TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>
              </CheckBox>
              <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,8"
                         Text="Show, hide and reorder what the Overview shows. On the dashboard you can also drag a card to move it, drag its bottom-right corner to resize it, or right-click it for sizes." />
              <ItemsControl ItemsSource="{Binding Customize.Cards}" ItemTemplate="{StaticResource DashboardCardRow}" Focusable="False" />
            </StackPanel>
          </ScrollViewer>

          <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0" Padding="22,12">
            <Grid>
              <Button Style="{StaticResource Button.Secondary}" Content="Reset layout" HorizontalAlignment="Left"
                      Command="{Binding Customize.ResetLayoutCommand}" ToolTip="Show every card and panel in the default order and size" />
              <Button Style="{StaticResource Button.Primary}" Content="Done" HorizontalAlignment="Right" MinWidth="80"
                      Command="{Binding Customize.CloseCommand}" />
            </Grid>
          </Border>
        </Grid>
      </c:SquircleBorder>
    </Grid>
  </Grid>
</UserControl>
