<Window x:Class="Coreloom.App.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Coreloom.App.Controls"
        Title="Coreloom"
        Width="800" Height="450"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="False" Focusable="False"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        TextOptions.TextHintingMode="Fixed"
        AutomationProperties.Name="Coreloom is starting">
  <!--
    Startup splash (16:9), redrawn for 1.9.0 in the app's own look: the near-black canvas with its glossy orbs (orange,
    cyan, green, the accent's blue and a small silver one, drifting a little), a pane of dark glass in the middle with
    the app icon on a soft halo, the "Coreloom" wordmark in Outfit, a thin loading line and the current step. It runs on
    its own UI thread, so it must stay self-contained: no StaticResource/DynamicResource keys and no implicit styles
    from App.xaml (the window also blocks those lookups in code). The corners are clipped to a squircle in code.
  -->

  <Grid x:Name="Root" TextElement.FontFamily="pack://application:,,,/Fonts/#Outfit">
    <!-- The canvas: near-black navy, a shade lighter toward the top left. -->
    <Rectangle>
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0.6,1">
          <GradientStop Color="#0A101A" Offset="0" />
          <GradientStop Color="#060910" Offset="0.5" />
          <GradientStop Color="#03050A" Offset="1" />
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>

    <!-- The orbs: each a ball lit from the top left (a radial fill from its highlight to a dark rim) on a soft halo of its
         own colour. The canvas drifts a few points over the splash's life (Drift, in code). -->
    <Canvas x:Name="Orbs" IsHitTestVisible="False">
      <Canvas.RenderTransform>
        <TranslateTransform x:Name="Drift" X="0" Y="0" />
      </Canvas.RenderTransform>

      <!-- orange, up at the right -->
      <Ellipse Canvas.Left="520" Canvas.Top="-200" Width="380" Height="380">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#50F2A23A" Offset="0" />
            <GradientStop Color="#1AF2A23A" Offset="0.55" />
            <GradientStop Color="#00F2A23A" Offset="1" />
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
      <Ellipse Canvas.Left="590" Canvas.Top="-130" Width="240" Height="240">
        <Ellipse.Fill>
          <RadialGradientBrush GradientOrigin="0.32,0.28" Center="0.5,0.5" RadiusX="0.62" RadiusY="0.62">
            <GradientStop Color="#FFE2A6" Offset="0" />
            <GradientStop Color="#F5B24A" Offset="0.3" />
            <GradientStop Color="#D98524" Offset="0.72" />
            <GradientStop Color="#5A3410" Offset="1" />
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>

      <!-- cyan, big, down at the right -->
      <Ellipse Canvas.Left="470" Canvas.Top="190" Width="480" Height="480">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#4A36C4E2" Offset="0" />
            <GradientStop Color="#1636C4E2" Offset="0.55" />
            <GradientStop Color="#0036C4E2" Offset="1" />
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
      <Ellipse Canvas.Left="560" Canvas.Top="280" Width="300" Height="300">
        <Ellipse.Fill>
          <RadialGradientBrush GradientOrigin="0.32,0.28" Center="0.5,0.5" RadiusX="0.62" RadiusY="0.62">
            <GradientStop Color="#D6FAFF" Offset="0" />
            <GradientStop Color="#5CD6EE" Offset="0.3" />
            <GradientStop Color="#1C9DBB" Offset="0.72" />
            <GradientStop Color="#0A3A48" Offset="1" />
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>

      <!-- the accent's blue, at the left -->
      <Ellipse Canvas.Left="-200" Canvas.Top="80" Width="420" Height="420">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#4A2E7CF6" Offset="0" />
            <GradientStop Color="#162E7CF6" Offset="0.55" />
            <GradientStop Color="#002E7CF6" Offset="1" />
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
      <Ellipse Canvas.Left="-120" Canvas.Top="160" Width="260" Height="260">
        <Ellipse.Fill>
          <RadialGradientBrush GradientOrigin="0.32,0.28" Center="0.5,0.5" RadiusX="0.62" RadiusY="0.62">
            <GradientStop Color="#CFE2FF" Offset="0" />
            <GradientStop Color="#5E9BFF" Offset="0.3" />
            <GradientStop Color="#1F5FD6" Offset="0.72" />
            <GradientStop Color="#0A2456" Offset="1" />
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>

      <!-- green, small, low in the middle -->
      <Ellipse Canvas.Left="250" Canvas.Top="330" Width="200" Height="200">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#402DB36B" Offset="0" />
            <GradientStop Color="#002DB36B" Offset="1" />
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
      <Ellipse Canvas.Left="300" Canvas.Top="380" Width="100" Height="100">
        <Ellipse.Fill>
          <RadialGradientBrush GradientOrigin="0.32,0.28" Center="0.5,0.5" RadiusX="0.62" RadiusY="0.62">
            <GradientStop Color="#C8F5DA" Offset="0" />
            <GradientStop Color="#4FD68A" Offset="0.3" />
            <GradientStop Color="#1E8F52" Offset="0.72" />
            <GradientStop Color="#0A3A22" Offset="1" />
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>

      <!-- silver, tiny -->
      <Ellipse Canvas.Left="536" Canvas.Top="318" Width="34" Height="34">
        <Ellipse.Fill>
          <RadialGradientBrush GradientOrigin="0.32,0.28" Center="0.5,0.5" RadiusX="0.62" RadiusY="0.62">
            <GradientStop Color="#FFFFFF" Offset="0" />
            <GradientStop Color="#D5DCE5" Offset="0.3" />
            <GradientStop Color="#8C96A3" Offset="0.72" />
            <GradientStop Color="#3A414B" Offset="1" />
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
    </Canvas>

    <!-- The rim (drawn along the squircle in code). -->
    <Path x:Name="Rim" StrokeThickness="1" IsHitTestVisible="False">
      <Path.Stroke>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#30FFFFFF" Offset="0" />
          <GradientStop Color="#10FFFFFF" Offset="0.5" />
          <GradientStop Color="#1EFFFFFF" Offset="1" />
        </LinearGradientBrush>
      </Path.Stroke>
    </Path>

    <!-- The pane of glass with everything on it: dark, nearly opaque, a hairline rim, the orbs' colour just showing. -->
    <StackPanel x:Name="Body" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2" Opacity="0">
      <StackPanel.RenderTransform>
        <TranslateTransform x:Name="BodyOffset" Y="12" />
      </StackPanel.RenderTransform>

      <c:SquircleBorder Width="560" Height="300" CornerRadius="30" Smoothing="0.7" BorderThickness="1" Sheen="0.35">
        <c:SquircleBorder.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0.6,1">
            <GradientStop Color="#DC0B1017" Offset="0" />
            <GradientStop Color="#E40B1017" Offset="1" />
          </LinearGradientBrush>
        </c:SquircleBorder.Background>
        <c:SquircleBorder.BorderBrush>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0.3,1">
            <GradientStop Color="#2AFFFFFF" Offset="0" />
            <GradientStop Color="#12FFFFFF" Offset="1" />
          </LinearGradientBrush>
        </c:SquircleBorder.BorderBrush>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,6,0,0">
          <!-- The icon, on a halo of the accent's blue that breathes. -->
          <Grid Width="84" Height="84" HorizontalAlignment="Center">
            <Ellipse x:Name="Halo" Width="220" Height="220" Margin="-68" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
              <Ellipse.Fill>
                <RadialGradientBrush>
                  <GradientStop Color="#5A2E7CF6" Offset="0" />
                  <GradientStop Color="#222E7CF6" Offset="0.4" />
                  <GradientStop Color="#002E7CF6" Offset="1" />
                </RadialGradientBrush>
              </Ellipse.Fill>
              <Ellipse.RenderTransform>
                <ScaleTransform x:Name="HaloScale" ScaleX="1" ScaleY="1" />
              </Ellipse.RenderTransform>
            </Ellipse>
            <Image x:Name="LogoImage" Width="84" Height="84" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
          </Grid>

          <!-- "Core" in white, "loom" in the accent's blue. -->
          <c:TrackedText x:Name="Wordmark" Text="Coreloom" AccentStart="4" HorizontalAlignment="Center" Margin="0,16,0,0"
                         FontSize="42" FontWeight="SemiBold" Tracking="-0.8" LineHeight="46">
            <c:TrackedText.Foreground>
              <LinearGradientBrush MappingMode="Absolute" StartPoint="0,6" EndPoint="0,40">
                <GradientStop Color="#FFFFFF" Offset="0" />
                <GradientStop Color="#D6DEEA" Offset="1" />
              </LinearGradientBrush>
            </c:TrackedText.Foreground>
            <c:TrackedText.AccentForeground>
              <LinearGradientBrush MappingMode="Absolute" StartPoint="90,4" EndPoint="190,40">
                <GradientStop Color="#7FB4FF" Offset="0" />
                <GradientStop Color="#3F8BFF" Offset="0.55" />
                <GradientStop Color="#2E7CF6" Offset="1" />
              </LinearGradientBrush>
            </c:TrackedText.AccentForeground>
          </c:TrackedText>
          <c:TrackedText Text="SYSTEM PERFORMANCE" HorizontalAlignment="Center" Margin="0,8,0,0" FontSize="10.5" FontWeight="Medium"
                         Tracking="3.6" LineHeight="13" Foreground="#8A96A8" />

          <!-- The loading line: a thin track, the accent filling it with a soft glow under the fill. -->
          <Grid x:Name="Bar" Width="300" Height="4" Margin="0,26,0,0" HorizontalAlignment="Center">
            <Border x:Name="FillGlow" HorizontalAlignment="Left" Width="0" CornerRadius="6" Margin="-6" Opacity="0.7" IsHitTestVisible="False">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                  <GradientStop Color="#302E7CF6" Offset="0" />
                  <GradientStop Color="#663F8BFF" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
              <Border.Effect>
                <BlurEffect Radius="10" RenderingBias="Performance" />
              </Border.Effect>
            </Border>
            <Border CornerRadius="2" Background="#1AFFFFFF" />
            <Border x:Name="Fill" HorizontalAlignment="Left" Width="0" CornerRadius="2" ClipToBounds="True">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                  <GradientStop Color="#2E7CF6" Offset="0" />
                  <GradientStop Color="#5E9BFF" Offset="0.7" />
                  <GradientStop Color="#9EC7FF" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
              <Grid>
                <!-- a faint sheen that slides along the fill -->
                <Rectangle x:Name="Stripes" Opacity="0.35">
                  <Rectangle.Fill>
                    <DrawingBrush x:Name="StripeBrush" TileMode="Tile" Viewport="0,0,28,4" ViewportUnits="Absolute" Viewbox="0,0,28,4" ViewboxUnits="Absolute" Stretch="None">
                      <DrawingBrush.Drawing>
                        <GeometryDrawing Geometry="M0,0 L14,0 L14,4 L0,4 Z">
                          <GeometryDrawing.Brush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                              <GradientStop Color="#00FFFFFF" Offset="0" />
                              <GradientStop Color="#80FFFFFF" Offset="0.5" />
                              <GradientStop Color="#00FFFFFF" Offset="1" />
                            </LinearGradientBrush>
                          </GeometryDrawing.Brush>
                        </GeometryDrawing>
                      </DrawingBrush.Drawing>
                      <DrawingBrush.Transform>
                        <TranslateTransform x:Name="StripeOffset" X="0" />
                      </DrawingBrush.Transform>
                    </DrawingBrush>
                  </Rectangle.Fill>
                </Rectangle>
              </Grid>
            </Border>
          </Grid>

          <!-- The current step, spaced out in capitals. -->
          <c:TrackedText x:Name="StatusLabel" Text="STARTING CORELOOM" HorizontalAlignment="Center" Margin="0,16,0,0" FontSize="10.5" FontWeight="Medium"
                         Tracking="3.2" LineHeight="13" Foreground="#6E7A8C" />
          <!-- The same, for screen readers (live region). -->
          <TextBlock x:Name="StatusText" Text="Starting Coreloom" Height="0" Opacity="0" IsHitTestVisible="False"
                     AutomationProperties.LiveSetting="Polite" />

          <TextBlock x:Name="ErrorText" Visibility="Collapsed" MaxWidth="460" Margin="0,14,0,0" TextWrapping="Wrap" TextAlignment="Center"
                     FontSize="12.5" LineHeight="19" Foreground="#FFB6AD" AutomationProperties.LiveSetting="Assertive" />
        </StackPanel>
      </c:SquircleBorder>
    </StackPanel>
  </Grid>
</Window>
