<UserControl x:Class="Coreloom.App.Views.MemoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Coreloom.App.Controls"
             xmlns:b="clr-namespace:Coreloom.App.Behaviors"
             xmlns:pages="clr-namespace:Coreloom.ViewModels.Pages;assembly=Coreloom.ViewModels">

  <ScrollViewer Style="{StaticResource ScrollViewer.Window}">
    <StackPanel Margin="32,14,28,32" b:Motion.Entrance="True">

      <c:AdaptiveGrid MinColumnWidth="420" MaxColumns="2" Spacing="16">
        <!-- Donut hero (cards are as tall as their content) -->
        <c:SquircleBorder Style="{StaticResource Card}" VerticalAlignment="Top">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="190" Height="190" VerticalAlignment="Center">
              <c:DonutChart Segments="{Binding Segments}" Thickness="16" />
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding CenterText}" FontFamily="{StaticResource MonoFont}" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding CenterCaption}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" />
              </StackPanel>
            </Grid>
            <StackPanel Grid.Column="1" Margin="28,0,0,0" VerticalAlignment="Center">
              <TextBlock Style="{StaticResource Text.CardTitle}" Text="Physical memory" Margin="0,0,0,10" />
              <ItemsControl ItemsSource="{Binding Segments}" ItemTemplate="{StaticResource DonutLegendRow}" Focusable="False" />
              <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Load.StatsText}" Margin="0,10,0,0" />
            </StackPanel>
          </Grid>
        </c:SquircleBorder>

        <ItemsControl ItemsSource="{Binding Details}" ItemTemplate="{StaticResource MetricTile}" Focusable="False" VerticalAlignment="Top">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <c:AdaptiveGrid MinColumnWidth="180" MaxColumns="2" Spacing="12" UniformRowHeight="True" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </c:AdaptiveGrid>

      <!-- Health of the memory -->
      <ContentPresenter Content="{Binding Health}" ContentTemplate="{StaticResource HealthCard}" Margin="0,16,0,0" />

      <c:AdaptiveGrid MinColumnWidth="460" MaxColumns="2" Spacing="16" Margin="0,16,0,0">
        <ContentPresenter Content="{Binding UsageChart}" ContentTemplate="{StaticResource ChartCard}" Height="280" />
        <ContentPresenter Content="{Binding CommitChart}" ContentTemplate="{StaticResource ChartCard}" Height="280" />
      </c:AdaptiveGrid>

      <c:AdaptiveGrid MinColumnWidth="460" MaxColumns="2" Spacing="16" Margin="0,16,0,0">
        <c:SquircleBorder Style="{StaticResource Card}" VerticalAlignment="Top">
          <StackPanel>
            <TextBlock Style="{StaticResource Text.CardTitle}" Text="Top processes by memory" />
            <TextBlock Style="{StaticResource Text.Caption}" Text="Working set, grouped by application" Margin="0,2,0,10" />
            <ContentPresenter Content="{Binding Processes}" ContentTemplate="{StaticResource ProcessList}" />
          </StackPanel>
        </c:SquircleBorder>
        <c:SquircleBorder Style="{StaticResource Card}" VerticalAlignment="Top">
          <StackPanel>
            <TextBlock Style="{StaticResource Text.CardTitle}" Text="Modules" Margin="0,0,0,10" />
            <ItemsControl ItemsSource="{Binding Modules}" Focusable="False" Visibility="{Binding HasModules, Converter={StaticResource BoolToVisibility}}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type pages:MemoryModuleItem}">
                  <c:SquircleBorder Style="{StaticResource Card.Inset}" Margin="0,0,0,8">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="{Binding Slot}" FontWeight="SemiBold" FontSize="12.5" />
                        <TextBlock Text="{Binding Part}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                        <TextBlock HorizontalAlignment="Right" FontSize="12.5">
                          <Run Text="{Binding Size, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding Type, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding Speed}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" Margin="0,2,0,0" />
                      </StackPanel>
                    </Grid>
                  </c:SquircleBorder>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{StaticResource Text.Secondary}" Text="Module details were not reported by the firmware."
                       Visibility="{Binding HasModules, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
            <Border Style="{StaticResource Divider}" />
            <ItemsControl ItemsSource="{Binding Specifications}" ItemTemplate="{StaticResource KeyValueRow}" Focusable="False" Grid.IsSharedSizeScope="True" />
            <ContentPresenter Content="{Binding ModuleSensors}" ContentTemplate="{StaticResource SensorTable}" Margin="0,8,0,0"
                              Visibility="{Binding ModuleSensors.IsEmpty, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
          </StackPanel>
        </c:SquircleBorder>
      </c:AdaptiveGrid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
