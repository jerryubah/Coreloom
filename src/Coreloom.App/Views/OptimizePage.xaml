<UserControl x:Class="Coreloom.App.Views.OptimizePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Coreloom.App.Controls"
             xmlns:b="clr-namespace:Coreloom.App.Behaviors"
             xmlns:pages="clr-namespace:Coreloom.ViewModels.Pages;assembly=Coreloom.ViewModels">

  <UserControl.Resources>
    <!-- A small spinning arc for "working". -->
    <!-- The banner ring: the accent as a sweep gradient while ready or working; the result's color (green, orange or
         red, a shade lighter at the start) once a scan or a clean-up is done. Full while nothing has run yet. -->
    <Style x:Key="HeroRing" TargetType="c:RadialGauge">
      <Setter Property="Thickness" Value="14" />
      <Setter Property="SweepAngle" Value="359" />
      <Setter Property="TrackBrush" Value="Transparent" />
      <Setter Property="Gradient" Value="Accent" />
      <Setter Property="Value" Value="{Binding RingProgress}" />
      <Setter Property="Tone" Value="{Binding RingTone}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding StageKey}" Value="Idle">
          <Setter Property="Value" Value="1" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StageKey}" Value="Ready">
          <Setter Property="Gradient" Value="Shade" />
          <Setter Property="ToneScale" Value="True" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StageKey}" Value="Done">
          <Setter Property="Gradient" Value="Shade" />
          <Setter Property="ToneScale" Value="True" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="Spinner" TargetType="c:RadialGauge">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Thickness" Value="2.4" />
      <Setter Property="SweepAngle" Value="359" />
      <Setter Property="Value" Value="0.28" />
      <Setter Property="TrackBrush" Value="Transparent" />
      <Setter Property="Fill" Value="{DynamicResource Brush.Accent}" />
    </Style>

    <!-- Smart Scan's four summary tiles. -->
    <DataTemplate x:Key="ModuleTile" DataType="{x:Type pages:OptimizeModuleViewModel}">
      <c:SquircleBorder x:Name="Tile" Style="{StaticResource Card.Inset}" Padding="14,12" MinHeight="92">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid Width="36" Height="36" VerticalAlignment="Top">
            <Ellipse Fill="{Binding ColorKey, Converter={StaticResource ColorKeyToBrush}}" Opacity="0.16" />
            <Path Style="{StaticResource IconPath}" Width="17" Height="17" Data="{Binding IconKey, Converter={StaticResource IconKeyToGeometry}}"
                  Stroke="{Binding ColorKey, Converter={StaticResource ColorKeyToBrush}}" />
          </Grid>
          <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Label}" />
            <TextBlock Text="{Binding Status}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" Margin="0,2,0,0"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                       Visibility="{Binding Detail, Converter={StaticResource HasValueToVisibility}}" />
          </StackPanel>
          <Grid Grid.Column="2" VerticalAlignment="Top">
            <c:RadialGauge Style="{StaticResource Spinner}" b:Spin.IsSpinning="{Binding IsWorking}"
                           Visibility="{Binding IsWorking, Converter={StaticResource BoolToVisibility}}" />
            <Path Style="{StaticResource IconPath}" Width="18" Height="18" Data="{StaticResource Icon.Check}" Stroke="{DynamicResource Brush.Success}"
                  b:Pop.Trigger="{Binding IsDone}" Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibility}}" />
            <CheckBox x:Name="Include" Style="{StaticResource CheckBox.Compact}" IsChecked="{Binding IsIncluded}" Visibility="Collapsed"
                      Margin="0,-4,-6,0" ToolTip="Include in the clean-up" AutomationProperties.Name="{Binding Title}" />
          </Grid>
        </Grid>
      </c:SquircleBorder>
      <DataTemplate.Triggers>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding CanInclude}" Value="True" />
            <Condition Binding="{Binding DataContext.IsReady, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
          </MultiDataTrigger.Conditions>
          <Setter TargetName="Include" Property="Visibility" Value="Visible" />
        </MultiDataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A junk category: check box, icon, name and description (and why to think twice), size and result. -->
    <DataTemplate x:Key="JunkRow" DataType="{x:Type pages:JunkCategoryViewModel}">
      <c:SquircleBorder Style="{StaticResource Card.Inset}" Padding="8,8,14,8" Margin="0,0,0,6">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <CheckBox Style="{StaticResource CheckBox.Compact}" IsChecked="{Binding IsSelected}" VerticalAlignment="Center"
                    IsEnabled="{Binding DataContext.Cleanup.IsBusy, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBool}}"
                    AutomationProperties.Name="{Binding Name}" />
          <Path Grid.Column="1" Style="{StaticResource IconPath}" Width="16" Height="16" Margin="2,0,10,0" VerticalAlignment="Center"
                Data="{Binding IconKey, Converter={StaticResource IconKeyToGeometry}}" />
          <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
            <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,1,0,0" />
            <TextBlock Text="{Binding Caution}" FontSize="11.5" Foreground="{DynamicResource Brush.Elevated}" TextWrapping="Wrap" Margin="0,2,0,0"
                       Visibility="{Binding Caution, Converter={StaticResource HasValueToVisibility}}" />
            <TextBlock Text="{Binding Result}" FontSize="11.5" Foreground="{DynamicResource Brush.Success}" Margin="0,2,0,0"
                       Visibility="{Binding Result, Converter={StaticResource HasValueToVisibility}}" />
          </StackPanel>
          <Grid Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="Size" Text="{Binding SizeText}" FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Text}" HorizontalAlignment="Right"
                       Visibility="{Binding IsWorking, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
            <c:RadialGauge Style="{StaticResource Spinner}" HorizontalAlignment="Right" b:Spin.IsSpinning="{Binding IsWorking}"
                           Visibility="{Binding IsWorking, Converter={StaticResource BoolToVisibility}}" />
          </Grid>
        </Grid>
      </c:SquircleBorder>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding HasJunk}" Value="False">
          <Setter TargetName="Size" Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
          <Setter TargetName="Size" Property="FontWeight" Value="Normal" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A threat Microsoft Defender found. -->
    <DataTemplate x:Key="ThreatRow" DataType="{x:Type pages:ThreatViewModel}">
      <Border Background="{DynamicResource Brush.CriticalSoft}" CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Path Style="{StaticResource IconPath}" Width="15" Height="15" Data="{StaticResource Icon.Warning}" VerticalAlignment="Top" Margin="0,1,10,0"
                Stroke="{Binding ColorKey, Converter={StaticResource ColorKeyToBrush}}" />
          <StackPanel Grid.Column="1">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Resource}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Resource}"
                       Visibility="{Binding Resource, Converter={StaticResource HasValueToVisibility}}" />
          </StackPanel>
          <Border Grid.Column="2" Style="{StaticResource Badge}" Margin="10,0,0,0" VerticalAlignment="Top">
            <TextBlock Text="{Binding Severity}" FontSize="10.5" FontWeight="SemiBold" Foreground="{Binding ColorKey, Converter={StaticResource ColorKeyToBrush}}" />
          </Border>
        </Grid>
      </Border>
    </DataTemplate>

    <!-- A startup app with its switch. -->
    <DataTemplate x:Key="StartupRow" DataType="{x:Type pages:StartupAppViewModel}">
      <Grid Margin="0,0,0,2" Background="Transparent" ToolTip="{Binding Command}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,6,12,6">
          <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding Publisher}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding Problem}" FontSize="11.5" Foreground="{DynamicResource Brush.Critical}"
                     Visibility="{Binding Problem, Converter={StaticResource HasValueToVisibility}}" />
        </StackPanel>
        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsEnabled}" AutomationProperties.Name="{Binding Name}" />
      </Grid>
    </DataTemplate>

    <!-- A maintenance task: what it does, a run button and how it went. -->
    <DataTemplate x:Key="TaskRow" DataType="{x:Type pages:MaintenanceTaskViewModel}">
      <c:SquircleBorder Style="{StaticResource Card.Inset}" Padding="12,10" Margin="0,0,0,6">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Path Style="{StaticResource IconPath}" Width="16" Height="16" Margin="0,0,12,0" VerticalAlignment="Center"
                Data="{Binding IconKey, Converter={StaticResource IconKeyToGeometry}}" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
            <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Message}" FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap"
                       Foreground="{Binding ColorKey, Converter={StaticResource ColorKeyToBrush}}"
                       Visibility="{Binding Message, Converter={StaticResource HasValueToVisibility}}" />
          </StackPanel>
          <Grid Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
            <Button Style="{StaticResource Button.Secondary}" Padding="14,6" Content="Run" Command="{Binding RunCommand}"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
            <c:RadialGauge Style="{StaticResource Spinner}" b:Spin.IsSpinning="{Binding IsBusy}"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
          </Grid>
        </Grid>
      </c:SquircleBorder>
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer Style="{StaticResource ScrollViewer.Window}">
    <StackPanel Margin="32,14,28,32" b:Motion.Entrance="True">

      <!-- Not available (not Windows, or no access) -->
      <c:SquircleBorder Style="{StaticResource Card}" Margin="0,0,0,16" Background="{DynamicResource Brush.ElevatedSoft}"
              Visibility="{Binding IsSupported, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
        <StackPanel Orientation="Horizontal">
          <Path Style="{StaticResource IconPath}" Width="16" Height="16" Data="{StaticResource Icon.Info}" Stroke="{DynamicResource Brush.Elevated}" />
          <TextBlock Text="{Binding UnsupportedText}" Margin="10,0,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}" />
        </StackPanel>
      </c:SquircleBorder>

      <!-- ============================================================ -->
      <!-- Smart Scan                                                   -->
      <!-- ============================================================ -->
      <c:SquircleBorder Style="{StaticResource Card.Glow}" GlowKey="Accent" GlowStrength="0.9" Sheen="0.8" Padding="0" BorderBrush="{DynamicResource Brush.AccentEdge}">
        <Grid ClipToBounds="True">
          <!-- The accent washing in from the top left and turning toward its warmer neighbour as it fades -->
          <c:SquircleBorder CornerRadius="17" Background="{DynamicResource Brush.AccentWash}" IsHitTestVisible="False" />

          <c:AdaptiveGrid MinColumnWidth="330" MaxColumns="2" Spacing="12" Margin="28,26">
            <!-- The ring -->
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4,0,8">
              <!-- a bloom of the accent behind it (wider than the ring; negative margins keep the layout the ring's size) -->
              <Ellipse Width="320" Height="320" Margin="-42" Fill="{DynamicResource Brush.AccentBloom}" IsHitTestVisible="False" />
              <Grid Width="236" Height="236">
                <!-- the face: a darker disc so the text stays easy to read on the bloom -->
                <Ellipse Margin="22" Fill="{DynamicResource Brush.Card}" Opacity="0.7" Stroke="{DynamicResource Brush.AccentTrack}" StrokeThickness="1" />
                <!-- the track, tinted with the accent so the ring reads even when empty -->
                <c:RadialGauge Thickness="14" SweepAngle="359" Value="0" TrackBrush="{DynamicResource Brush.AccentTrack}" />
                <!-- a soft glow under the arc -->
                <c:RadialGauge Style="{StaticResource HeroRing}" Opacity="0.75">
                  <c:RadialGauge.Effect>
                    <BlurEffect Radius="16" />
                  </c:RadialGauge.Effect>
                </c:RadialGauge>
                <c:RadialGauge Style="{StaticResource HeroRing}" />
                <!-- a bright comet that circles while scanning or cleaning -->
                <c:RadialGauge Thickness="14" SweepAngle="359" Value="0.2" TrackBrush="Transparent" Fill="{DynamicResource Brush.Text}" FadeTail="True" Opacity="0.6"
                               b:Spin.IsSpinning="{Binding IsWorking}" Visibility="{Binding IsWorking, Converter={StaticResource BoolToVisibility}}" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="170">
                  <Grid HorizontalAlignment="Center" Width="30" Height="30">
                    <Path Style="{StaticResource IconPath}" Width="26" Height="26" Data="{StaticResource Icon.Sparkle}" Stroke="{DynamicResource Brush.Accent}"
                          Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" b:Pulse.IsPulsing="{Binding IsWorking}" />
                    <Path Style="{StaticResource IconPath}" Width="28" Height="28" Data="{StaticResource Icon.Check}" Stroke="{DynamicResource Brush.Success}"
                          Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibility}}" b:Pop.Trigger="{Binding IsDone}" />
                  </Grid>
                  <TextBlock Text="{Binding Headline}" FontSize="23" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center"
                             TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource Brush.Text}" />
                  <TextBlock Text="{Binding StageText}" Style="{StaticResource Text.Label}" HorizontalAlignment="Center" Margin="0,4,0,0" Opacity="0.8"
                             Visibility="{Binding StageText, Converter={StaticResource HasValueToVisibility}}" />
                </StackPanel>
              </Grid>
            </Grid>

            <!-- What it found, the buttons and the four parts -->
            <StackPanel VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Smart Scan" Style="{StaticResource Text.Section}" />
                <Border Style="{StaticResource Badge}" Margin="10,0,0,0" Background="{DynamicResource Brush.AccentSoft}">
                  <TextBlock Text="clean · protect · speed up" FontSize="10.5" Foreground="{DynamicResource Brush.Accent}" />
                </Border>
              </StackPanel>
              <TextBlock Text="{Binding Caption}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,6,0,0" />
              <TextBlock Text="{Binding ResultText}" FontSize="12.5" Foreground="{DynamicResource Brush.Success}" TextWrapping="Wrap" Margin="0,8,0,0"
                         b:Pop.Trigger="{Binding IsDone}" Visibility="{Binding ResultText, Converter={StaticResource HasValueToVisibility}}" />

              <WrapPanel Margin="0,14,0,0">
                <Button Style="{StaticResource Button.AccentGradient}" Padding="20,9" Margin="0,0,10,8" Command="{Binding RunCommand}"
                        Visibility="{Binding IsReady, Converter={StaticResource BoolToVisibility}}">
                  <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource IconPath}" Width="14" Height="14" Data="{StaticResource Icon.Optimize}" Stroke="{DynamicResource Brush.OnAccent}" />
                    <TextBlock Text="Clean up and optimize" Margin="8,0,0,0" />
                  </StackPanel>
                </Button>
                <!-- the main button, except next to "Clean up and optimize", where it steps back -->
                <Button Padding="20,9" Margin="0,0,10,8" Command="{Binding ScanCommand}"
                        Visibility="{Binding IsWorking, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource Button.AccentGradient}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsReady}" Value="True">
                          <Setter Property="Background" Value="{DynamicResource Brush.Input}" />
                          <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                  <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource IconPath}" Width="14" Height="14" Data="{StaticResource Icon.Sparkle}" />
                    <TextBlock Text="{Binding ScanText}" Margin="8,0,0,0" />
                  </StackPanel>
                </Button>
                <Button Style="{StaticResource Button.Secondary}" Padding="20,9" Margin="0,0,10,8" Content="Stop" Command="{Binding CancelCommand}"
                        Visibility="{Binding IsWorking, Converter={StaticResource BoolToVisibility}}" />
              </WrapPanel>

              <ItemsControl ItemsSource="{Binding Modules}" ItemTemplate="{StaticResource ModuleTile}" Focusable="False" Margin="0,6,0,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <c:AdaptiveGrid MinColumnWidth="210" MaxColumns="2" Spacing="10" UniformRowHeight="True" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </StackPanel>
          </c:AdaptiveGrid>
        </Grid>
      </c:SquircleBorder>

      <!-- Two columns that stack: Cleanup over Free up memory, Protection over Speed up, each card as tall as its content.
           Only Speed up may grow to line up with the other column, because its startup list shows more apps when it's
           taller. One column when the window is narrow. -->
      <c:StackedColumns MinColumnWidth="460" MaxColumns="2" Spacing="16" RowSpacing="16" InOrder="True" FillColumns="True" Margin="0,16,0,0">

        <!-- ============================================================ -->
        <!-- Cleanup                                                      -->
        <!-- ============================================================ -->
        <c:SquircleBorder Style="{StaticResource Card}" DataContext="{Binding Cleanup}">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <c:SquircleBorder Width="34" Height="34" CornerRadius="10" Background="{DynamicResource Brush.AccentSoft}">
                <Path Style="{StaticResource IconPath}" Width="16" Height="16" Data="{StaticResource Icon.Trash}" Stroke="{DynamicResource Brush.Accent}" />
              </c:SquircleBorder>
              <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Text.CardTitle}" Text="Cleanup" />
                <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding SelectedText}" Margin="0,2,0,0" />
              </StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,10,0,0" />
            <ProgressBar Style="{StaticResource ProgressBar.Thin}" Maximum="1" Margin="0,8,0,0" b:Smooth.Value="{Binding Progress}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <ItemsControl ItemsSource="{Binding Categories}" ItemTemplate="{StaticResource JunkRow}" Focusable="False" Margin="0,12,0,0" />
            <WrapPanel Margin="0,6,0,0">
              <Button Style="{StaticResource Button.Primary}" Padding="16,7" Margin="0,0,8,0" Command="{Binding CleanCommand}">
                <StackPanel Orientation="Horizontal">
                  <Path Style="{StaticResource IconPath}" Width="13" Height="13" Data="{StaticResource Icon.Trash}" Stroke="{DynamicResource Brush.OnAccent}" />
                  <TextBlock Text="Clean selected" Margin="7,0,0,0" />
                </StackPanel>
              </Button>
              <Button Style="{StaticResource Button.Secondary}" Padding="16,7" Margin="0,0,8,0" Content="Scan" Command="{Binding ScanCommand}"
                      Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
              <Button Style="{StaticResource Button.Secondary}" Padding="16,7" Content="Stop" Command="{Binding CancelCommand}"
                      Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            </WrapPanel>
            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,10,0,0" TextWrapping="Wrap"
                       Text="Only temporary files, caches and reports apps and Windows rebuild on their own are touched. Files in use are skipped." />
          </StackPanel>
        </c:SquircleBorder>

        <!-- ============================================================ -->
        <!-- Protection                                                   -->
        <!-- ============================================================ -->
        <c:SquircleBorder Style="{StaticResource Card}" DataContext="{Binding Protection}">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid Width="34" Height="34">
                <Ellipse Fill="{Binding ColorKey, Converter={StaticResource ColorKeyToBrush}}" Opacity="0.16" />
                <Path Style="{StaticResource IconPath}" Width="17" Height="17" Data="{StaticResource Icon.Shield}"
                      Stroke="{Binding ColorKey, Converter={StaticResource ColorKeyToBrush}}" />
              </Grid>
              <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Text.CardTitle}" Text="Protection" />
                <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Engine}" Margin="0,2,0,0" />
              </StackPanel>
              <Button Grid.Column="2" Style="{StaticResource Button.Icon}" Command="{Binding RefreshCommand}" ToolTip="Check again" AutomationProperties.Name="Check protection again">
                <Path Style="{StaticResource IconPath}" Width="15" Height="15" Data="{StaticResource Icon.Refresh}" />
              </Button>
            </Grid>

            <c:SquircleBorder CornerRadius="12" Padding="14,12" Margin="0,12,0,0" Background="{DynamicResource Brush.Surface}">
              <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" Foreground="{Binding ColorKey, Converter={StaticResource ColorKeyToBrush}}" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,2,0,0" />
              </StackPanel>
            </c:SquircleBorder>

            <Grid Margin="2,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="ProtectionLabel" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Text="Real-time protection" Style="{StaticResource Text.Secondary}" Margin="0,0,16,6" />
              <TextBlock Grid.Column="1" Text="{Binding RealTime}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Row="1" Text="Virus definitions" Style="{StaticResource Text.Secondary}" Margin="0,0,16,6" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Definitions}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Row="2" Text="Last scan" Style="{StaticResource Text.Secondary}" Margin="0,0,16,0" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LastScan}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis" />
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}">
              <c:RadialGauge Style="{StaticResource Spinner}" b:Spin.IsSpinning="{Binding IsScanning}" />
              <TextBlock Text="Scanning with Microsoft Defender…" Margin="10,0,0,0" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,10,0,0"
                       Visibility="{Binding Message, Converter={StaticResource HasValueToVisibility}}" />

            <ItemsControl ItemsSource="{Binding Threats}" ItemTemplate="{StaticResource ThreatRow}" Focusable="False" Margin="0,12,0,0"
                          Visibility="{Binding HasThreats, Converter={StaticResource BoolToVisibility}}" />

            <WrapPanel Margin="0,12,0,0">
              <Button Style="{StaticResource Button.Primary}" Padding="16,7" Margin="0,0,8,8" Command="{Binding RemoveThreatsCommand}"
                      Visibility="{Binding HasThreats, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                  <Path Style="{StaticResource IconPath}" Width="13" Height="13" Data="{StaticResource Icon.Shield}" Stroke="{DynamicResource Brush.OnAccent}" />
                  <TextBlock Text="Remove threats" Margin="7,0,0,0" />
                </StackPanel>
              </Button>
              <Button Style="{StaticResource Button.Secondary}" Padding="16,7" Margin="0,0,8,8" Content="Quick scan" Command="{Binding QuickScanCommand}"
                      Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
              <Button Style="{StaticResource Button.Secondary}" Padding="16,7" Margin="0,0,8,8" Content="Stop scan" Command="{Binding CancelScanCommand}"
                      Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />
              <Button Style="{StaticResource Button.Secondary}" Padding="16,7" Margin="0,0,8,8" Content="Update definitions" Command="{Binding UpdateCommand}" />
              <Button Style="{StaticResource Button.Subtle}" Padding="12,7" Margin="0,0,8,8" Command="{Binding OpenSecurityCommand}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Windows Security" />
                  <Path Style="{StaticResource IconPath}" Width="12" Height="12" Data="{StaticResource Icon.External}" Margin="6,0,0,0" />
                </StackPanel>
              </Button>
            </WrapPanel>
          </StackPanel>
        </c:SquircleBorder>

        <!-- ============================================================ -->
        <!-- Memory                                                       -->
        <!-- ============================================================ -->
        <c:SquircleBorder Style="{StaticResource Card}" DataContext="{Binding Memory}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <c:SquircleBorder Width="34" Height="34" CornerRadius="10" Background="{DynamicResource Brush.AccentSoft}">
                <Path Style="{StaticResource IconPath}" Width="16" Height="16" Data="{StaticResource Icon.Memory}" Stroke="{DynamicResource Brush.Accent}" />
              </c:SquircleBorder>
              <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Text.CardTitle}" Text="Free up memory" />
                <TextBlock Style="{StaticResource Text.Caption}" Text="Trims memory background apps aren't using, so the app you're in has more room" TextWrapping="Wrap" Margin="0,2,0,0" />
              </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,16,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid Width="150" Height="150">
                <c:RadialGauge Thickness="14" Orb="True" TrackBrush="{DynamicResource Brush.Track}" ToneScale="True" CoolAt="0.4" WarmAt="0.8" HotAt="0.92"
                               Value="{Binding Fraction}" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock FontFamily="{StaticResource UiFont}" FontSize="31" FontWeight="Bold" Foreground="{DynamicResource Brush.Text}"
                               Typography.NumeralAlignment="Tabular" TextOptions.TextFormattingMode="Ideal"
                               b:AnimatedText.Formatter="{Binding PercentFormatter}" b:AnimatedText.Value="{Binding Load}" />
                    <TextBlock Text="%" Style="{StaticResource Text.Unit}" VerticalAlignment="Bottom" Margin="2,0,0,5" />
                  </StackPanel>
                  <TextBlock Text="in use" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" />
                </StackPanel>
              </Grid>
              <StackPanel Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding UsedText}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding AvailableText}" Style="{StaticResource Text.Secondary}" Margin="0,2,0,0" />
                <CheckBox Style="{StaticResource CheckBox.Compact}" IsChecked="{Binding ClearStandby}" Margin="-6,12,0,0">
                  <StackPanel>
                    <TextBlock Text="Also clear the standby cache" FontSize="12.5" Foreground="{DynamicResource Brush.Text}" />
                    <TextBlock Text="Frees cached files too; apps may open slower until Windows rebuilds it" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                  </StackPanel>
                </CheckBox>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <Button Style="{StaticResource Button.Primary}" Padding="16,7" Command="{Binding FreeUpCommand}">
                    <StackPanel Orientation="Horizontal">
                      <Path Style="{StaticResource IconPath}" Width="13" Height="13" Data="{StaticResource Icon.Sparkle}" Stroke="{DynamicResource Brush.OnAccent}" />
                      <TextBlock Text="Free up RAM" Margin="7,0,0,0" />
                    </StackPanel>
                  </Button>
                  <c:RadialGauge Style="{StaticResource Spinner}" Margin="12,0,0,0" b:Spin.IsSpinning="{Binding IsBusy}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <TextBlock Text="{Binding LastResult}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                           Visibility="{Binding LastResult, Converter={StaticResource HasValueToVisibility}}" />
                <TextBlock Text="{Binding TotalsText}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,3,0,0"
                           Visibility="{Binding TotalsText, Converter={StaticResource HasValueToVisibility}}" />
                <WrapPanel Margin="0,8,0,0" Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}">
                  <Button Style="{StaticResource Button.Subtle}" Command="{Binding ToggleDetailsCommand}" Margin="0,0,6,0" ToolTip="Every process: its memory before and after, and what happened">
                    <StackPanel Orientation="Horizontal">
                      <Path Style="{StaticResource IconPath}" Width="12" Height="12" Data="{StaticResource Icon.List}" />
                      <TextBlock Text="Process details" Margin="6,0,0,0" />
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource Button.Subtle}" Command="{Binding OpenLogsCommand}" ToolTip="Opens the log viewer at this clean-up's lines">
                    <StackPanel Orientation="Horizontal">
                      <Path Style="{StaticResource IconPath}" Width="12" Height="12" Data="{StaticResource Icon.Folder}" />
                      <TextBlock Text="Open logs" Margin="6,0,0,0" />
                    </StackPanel>
                  </Button>
                </WrapPanel>
              </StackPanel>
            </Grid>

            <!-- Every process of the last clean-up -->
            <StackPanel Grid.Row="2" Margin="0,14,0,0" Visibility="{Binding ShowDetails, Converter={StaticResource BoolToVisibility}}">
              <ListBox Style="{StaticResource Segmented}" HorizontalAlignment="Left" ItemsSource="{Binding ResultFilters}" DisplayMemberPath="Label"
                       SelectedValuePath="Value" SelectedValue="{Binding ResultFilter}" AutomationProperties.Name="Show processes" />
              <Grid Margin="4,10,14,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="78" />
                  <ColumnDefinition Width="78" />
                  <ColumnDefinition Width="84" />
                  <ColumnDefinition Width="74" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Process" Style="{StaticResource Text.Caption}" />
                <TextBlock Grid.Column="1" Text="Before" Style="{StaticResource Text.Caption}" TextAlignment="Right" />
                <TextBlock Grid.Column="2" Text="After" Style="{StaticResource Text.Caption}" TextAlignment="Right" />
                <TextBlock Grid.Column="3" Text="Reclaimed" Style="{StaticResource Text.Caption}" TextAlignment="Right" />
                <TextBlock Grid.Column="4" Text="Result" Style="{StaticResource Text.Caption}" Margin="12,0,0,0" />
              </Grid>
              <c:HeightCap Cap="300">
                <ScrollViewer Style="{StaticResource ScrollViewer.Page}" b:ScrollChain.Enabled="True">
                  <ItemsControl ItemsSource="{Binding Results}" Focusable="False" Margin="0,0,10,0" VirtualizingPanel.IsVirtualizing="True">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type pages:MemoryTrimRowViewModel}">
                        <Grid Margin="4,4" ToolTip="{Binding Reason}">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="78" />
                            <ColumnDefinition Width="78" />
                            <ColumnDefinition Width="84" />
                            <ColumnDefinition Width="74" />
                          </Grid.ColumnDefinitions>
                          <StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis">
                              <Run Text="{Binding PidText, Mode=OneWay}" /><Run Text="{Binding Reason, Mode=OneWay, StringFormat={} · {0}}" />
                            </TextBlock>
                          </StackPanel>
                          <TextBlock Grid.Column="1" Text="{Binding BeforeText}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{DynamicResource Brush.TextSecondary}" TextAlignment="Right" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="2" Text="{Binding AfterText}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{DynamicResource Brush.TextSecondary}" TextAlignment="Right" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="3" Text="{Binding ReclaimedText}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" TextAlignment="Right" VerticalAlignment="Center" />
                          <Border x:Name="Pill" Grid.Column="4" Style="{StaticResource Badge}" HorizontalAlignment="Left" Margin="12,0,0,0">
                            <TextBlock x:Name="PillText" Text="{Binding OutcomeText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" />
                          </Border>
                        </Grid>
                        <DataTemplate.Triggers>
                          <DataTrigger Binding="{Binding OutcomeText}" Value="Trimmed">
                            <Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource Brush.Success}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding OutcomeText}" Value="Failed">
                            <Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource Brush.Elevated}" />
                          </DataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </c:HeightCap>
              <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="4,8,0,0"
                         Text="Trimming asks Windows to write out memory a process hasn't used lately; the process keeps running and gets it back if it needs it. Coreloom never ends a process. Failed ones are usually protected parts of Windows or security software." />
            </StackPanel>
          </Grid>
        </c:SquircleBorder>

        <!-- ============================================================ -->
        <!-- Speed                                                        -->
        <!-- ============================================================ -->
        <c:SquircleBorder Style="{StaticResource Card}" DataContext="{Binding Speed}" c:StackedColumns.CanFill="True">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <c:SquircleBorder Width="34" Height="34" CornerRadius="10" Background="{DynamicResource Brush.AccentSoft}">
                <Path Style="{StaticResource IconPath}" Width="16" Height="16" Data="{StaticResource Icon.Rocket}" Stroke="{DynamicResource Brush.Accent}" />
              </c:SquircleBorder>
              <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Text.CardTitle}" Text="Speed up" />
                <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding StartupSummary}" Margin="0,2,0,0" />
              </StackPanel>
              <Button Grid.Column="2" Style="{StaticResource Button.Icon}" Command="{Binding RefreshCommand}" ToolTip="Refresh" AutomationProperties.Name="Refresh startup apps">
                <Path Style="{StaticResource IconPath}" Width="15" Height="15" Data="{StaticResource Icon.Refresh}" />
              </Button>
            </Grid>

            <TextBlock Grid.Row="1" Text="Startup apps" Style="{StaticResource Text.Label}" Margin="0,14,0,4" />
            <TextBlock Grid.Row="2" Text="Fewer apps starting with Windows means a faster sign-in. Turning one off doesn't uninstall it." Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
            <!-- starts at up to 300 px and shows more apps when the card is taller -->
            <c:HeightCap Grid.Row="3" Cap="300" Margin="0,8,0,0">
              <ScrollViewer Style="{StaticResource ScrollViewer.Page}" b:ScrollChain.Enabled="True">
                <ItemsControl ItemsSource="{Binding StartupApps}" ItemTemplate="{StaticResource StartupRow}" Focusable="False" Margin="0,0,10,0" />
              </ScrollViewer>
            </c:HeightCap>
            <TextBlock Grid.Row="4" Text="No startup apps found." Style="{StaticResource Text.Secondary}" Margin="0,4,0,0"
                       Visibility="{Binding HasStartupApps, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />

            <TextBlock Grid.Row="5" Text="Maintenance" Style="{StaticResource Text.Label}" Margin="0,16,0,8" />
            <ItemsControl Grid.Row="6" ItemsSource="{Binding Tasks}" ItemTemplate="{StaticResource TaskRow}" Focusable="False" />
          </Grid>
        </c:SquircleBorder>
      </c:StackedColumns>
    </StackPanel>
  </ScrollViewer>
</UserControl>
