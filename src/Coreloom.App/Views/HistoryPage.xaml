<UserControl x:Class="Coreloom.App.Views.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Coreloom.App.Controls"
             xmlns:b="clr-namespace:Coreloom.App.Behaviors"
             xmlns:pages="clr-namespace:Coreloom.ViewModels.Pages;assembly=Coreloom.ViewModels">

  <Grid Margin="32,14,28,24" b:Motion.Entrance="True">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="290" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Metric picker -->
    <c:SquircleBorder Style="{StaticResource Card}" Padding="14,14,8,10">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,6,10">
          <TextBlock Style="{StaticResource Text.CardTitle}" Text="Metrics" />
          <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,0"
                     Text="Pick up to six to compare on a shared timeline. History is kept in memory for the last hour." TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,6,8">
          <TextBox x:Name="FilterBox" Style="{StaticResource TextBox.Default}" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                   AutomationProperties.Name="Filter metrics" />
          <TextBlock Text="Filter (e.g. temperature, GPU)" IsHitTestVisible="False" Margin="12,0,0,0" VerticalAlignment="Center"
                     Foreground="{DynamicResource Brush.TextTertiary}" FontSize="13"
                     Visibility="{Binding Text, ElementName=FilterBox, Converter={StaticResource HasValueToVisibility}, ConverterParameter=Invert}" />
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" b:SmoothScroll.IsEnabled="True">
          <ItemsControl ItemsSource="{Binding FilteredOptions}" Focusable="False" Margin="0,0,6,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type pages:HistoryMetricOption}">
                <CheckBox Style="{StaticResource CheckBox.Compact}" IsChecked="{Binding IsSelected}" ToolTip="{Binding Id}">
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis">
                      <Run Text="{Binding Group, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Device, Mode=OneWay}" />
                    </TextBlock>
                  </StackPanel>
                </CheckBox>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="0,10,6,0">
          <TextBlock Text="{Binding SelectionText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource Button.Subtle}" Content="Clear" Padding="10,4" Command="{Binding ClearSelectionCommand}" />
            <Button Style="{StaticResource Button.Secondary}" Padding="10,4" Margin="6,0,0,0" Command="{Binding ExportCommand}"
                    ToolTip="Export the visible time window of the selected metrics to a CSV file">
              <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource IconPath}" Width="12" Height="12" Data="{StaticResource Icon.Download}" />
                <TextBlock Text="Export CSV" Margin="6,0,0,0" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Grid>
    </c:SquircleBorder>

    <!-- Stacked, time-aligned charts (hover is synchronized through the shared timeline) -->
    <Grid Grid.Column="1" Margin="16,0,0,0">
      <c:SquircleBorder Style="{StaticResource Card}" VerticalAlignment="Top"
              Visibility="{Binding Charts.Count, Converter={StaticResource HasValueToVisibility}, ConverterParameter=Invert}">
        <StackPanel Margin="8,18">
          <Path Style="{StaticResource IconPath}" Width="22" Height="22" Data="{StaticResource Icon.History}" HorizontalAlignment="Center" />
          <TextBlock Text="Select metrics on the left to chart them here." Style="{StaticResource Text.Secondary}" HorizontalAlignment="Center" Margin="0,10,0,0" />
          <TextBlock Text="Use the window selector above to look back up to an hour." Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" Margin="0,4,0,0" />
        </StackPanel>
      </c:SquircleBorder>

      <ScrollViewer Style="{StaticResource ScrollViewer.Page}">
        <ItemsControl ItemsSource="{Binding Charts}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type pages:HistoryChartViewModel}">
              <c:SquircleBorder Style="{StaticResource Card}" Padding="18,14,14,10" Margin="0,0,0,12">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="9" Height="9" VerticalAlignment="Center" Fill="{Binding Metric.ColorKey, Converter={StaticResource ColorKeyToBrush}}" />
                    <StackPanel Grid.Column="1" Margin="10,0,12,0">
                      <TextBlock Text="{Binding Chart.Title}" Style="{StaticResource Text.CardTitle}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Metric.StatsText}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0"
                                 Visibility="{Binding Metric.StatsText, Converter={StaticResource HasValueToVisibility}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="19" FontWeight="SemiBold"
                                 b:AnimatedText.Formatter="{Binding Metric.NumberFormatter}"
                                 b:AnimatedText.Value="{Binding Metric.Value}" Foreground="{DynamicResource Brush.Text}" />
                      <TextBlock Style="{StaticResource Text.Unit}" Text="{Binding Metric.Unit}" VerticalAlignment="Bottom" Margin="4,0,0,3" />
                      <Button Style="{StaticResource Button.Icon}" Margin="10,0,0,0" ToolTip="Remove from comparison"
                              Command="{Binding DataContext.RemoveChartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}">
                        <Path Style="{StaticResource IconPath}" Width="10" Height="10" Data="{StaticResource Icon.Close}" />
                      </Button>
                    </StackPanel>
                  </Grid>
                  <c:LiveLineChart Grid.Row="1" Height="170" Margin="0,10,0,0" Chart="{Binding Chart}"
                                   Timeline="{Binding DataContext.Timeline, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </Grid>
              </c:SquircleBorder>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
