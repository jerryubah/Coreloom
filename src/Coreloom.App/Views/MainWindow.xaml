<Window x:Class="Coreloom.App.Views.MainWindow"
        x:Name="Root"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Coreloom.ViewModels;assembly=Coreloom.ViewModels"
        xmlns:pages="clr-namespace:Coreloom.ViewModels.Pages;assembly=Coreloom.ViewModels"
        xmlns:views="clr-namespace:Coreloom.App.Views"
        xmlns:interop="clr-namespace:Coreloom.App.Interop"
        xmlns:b="clr-namespace:Coreloom.App.Behaviors"
        xmlns:c="clr-namespace:Coreloom.App.Controls"
        Title="Coreloom"
        Width="1360" Height="880" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.WindowBackground}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Auto"
        TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Icon="pack://application:,,,/Assets/coreloom.ico">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <!-- View lookup for each page view model. -->
    <DataTemplate DataType="{x:Type pages:OverviewViewModel}"><views:OverviewPage /></DataTemplate>
    <DataTemplate DataType="{x:Type pages:GamingViewModel}"><views:GamingPage /></DataTemplate>
    <DataTemplate DataType="{x:Type pages:BenchmarkingViewModel}"><views:BenchmarkingPage /></DataTemplate>
    <DataTemplate DataType="{x:Type pages:GpuViewModel}"><views:GpuPage /></DataTemplate>
    <DataTemplate DataType="{x:Type pages:CpuViewModel}"><views:CpuPage /></DataTemplate>
    <DataTemplate DataType="{x:Type pages:MemoryViewModel}"><views:MemoryPage /></DataTemplate>
    <DataTemplate DataType="{x:Type pages:StorageViewModel}"><views:StoragePage /></DataTemplate>
    <DataTemplate DataType="{x:Type pages:DevicesViewModel}"><views:DevicesPage /></DataTemplate>
    <DataTemplate DataType="{x:Type pages:DriversViewModel}"><views:DriversPage /></DataTemplate>
    <DataTemplate DataType="{x:Type pages:NetworkViewModel}"><views:NetworkPage /></DataTemplate>
    <DataTemplate DataType="{x:Type pages:ApplicationsViewModel}"><views:ApplicationsPage /></DataTemplate>
    <DataTemplate DataType="{x:Type pages:HistoryViewModel}"><views:HistoryPage /></DataTemplate>
    <DataTemplate DataType="{x:Type pages:OptimizeViewModel}"><views:OptimizePage /></DataTemplate>
    <DataTemplate DataType="{x:Type pages:SettingsViewModel}"><views:SettingsPage /></DataTemplate>

    <!-- The pages in their sidebar groups (Monitor, Play, Maintain; 1.9.0). -->
    <CollectionViewSource x:Key="GroupedPages" Source="{Binding Pages}">
      <CollectionViewSource.GroupDescriptions>
        <PropertyGroupDescription PropertyName="Group" />
      </CollectionViewSource.GroupDescriptions>
    </CollectionViewSource>

    <Style x:Key="NavItemBound" TargetType="ListBoxItem" BasedOn="{StaticResource NavItem}">
      <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
      <Setter Property="ToolTip" Value="{Binding Title}" />
      <Setter Property="ToolTipService.IsEnabled" Value="{Binding IsCompactSidebar, RelativeSource={RelativeSource AncestorType=Window}}" />
      <Setter Property="ToolTipService.Placement" Value="Right" />
    </Style>

    <!-- A group's small label; collapsed, a thin line stands in for it. -->
    <Style x:Key="NavGroup" TargetType="GroupItem">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="GroupItem">
            <StackPanel>
              <Grid x:Name="Header" Height="30" Margin="14,6,0,0">
                <c:TrackedText Style="{StaticResource Text.Overline}" Text="{Binding Name, Converter={StaticResource UpperCase}}" VerticalAlignment="Center" />
              </Grid>
              <Border x:Name="Line" Height="1" Margin="12,8,12,6" Background="{DynamicResource Brush.Divider}" Visibility="Collapsed" />
              <ItemsPresenter />
            </StackPanel>
            <ControlTemplate.Triggers>
              <DataTrigger Binding="{Binding IsCompactSidebar, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                <Setter TargetName="Header" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Line" Property="Visibility" Value="Visible" />
              </DataTrigger>
              <DataTrigger Binding="{Binding Name}" Value="Monitor">
                <Setter TargetName="Line" Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Collapsed, an item is only 40 px wide: the icon sits centered with no margins (with them it didn't fit and was
         clipped on the right). -->
    <DataTemplate x:Key="NavItemTemplate" DataType="{x:Type pages:PageViewModel}">
      <Grid x:Name="Row" Margin="13,0,10,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid VerticalAlignment="Center">
          <Path Style="{StaticResource IconPath}" Width="17" Height="17" Data="{Binding IconKey, Converter={StaticResource IconKeyToGeometry}}" />
          <!-- A red dot when the page has news (Settings, when an update is out) -->
          <Ellipse Width="9" Height="9" Fill="{DynamicResource Brush.Critical}" Stroke="{DynamicResource Brush.Surface}" StrokeThickness="1.5"
                   HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-4,0" IsHitTestVisible="False"
                   Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
        <TextBlock x:Name="Label" Grid.Column="1" Text="{Binding Title}" Margin="12,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   Visibility="{Binding IsCompactSidebar, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
        <!-- A count beside the name (Drivers: updates waiting) -->
        <Border x:Name="Count" Grid.Column="2" Style="{StaticResource Badge.Count}" Margin="0,0,-2,0"
                Visibility="{Binding Badge, Converter={StaticResource HasValueToVisibility}}">
          <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsCompactSidebar, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
          <Setter TargetName="Row" Property="Margin" Value="0" />
          <Setter TargetName="Row" Property="HorizontalAlignment" Value="Center" />
          <Setter TargetName="Count" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
          <Setter TargetName="Count" Property="Background" Value="#33FFFFFF" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- The update button (1.9.0: the accent pill, like every main action), with the version and its state. -->
    <Style x:Key="Button.Update" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="6,5,12,5" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsCompactSidebar, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
          <Setter Property="HorizontalContentAlignment" Value="Center" />
          <Setter Property="Padding" Value="0,5" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- The brand mark: beside the name when expanded, centered over the icons when collapsed. -->
    <Style x:Key="SidebarBrand" TargetType="StackPanel">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Margin" Value="6,0,0,0" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsCompactSidebar, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
          <Setter Property="HorizontalAlignment" Value="Center" />
          <Setter Property="Margin" Value="0" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- The account chip at the foot of the sidebar: a pill when expanded, just the circle when collapsed. -->
    <Style x:Key="Button.AccountChip" TargetType="Button" BasedOn="{StaticResource Button.Plain}">
      <Setter Property="Background" Value="{DynamicResource Brush.Pill}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.PillBorder}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsCompactSidebar, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderBrush" Value="Transparent" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- A round header button (search, bell, pause) in the window's caption area. -->
    <Style x:Key="Button.Header" TargetType="Button" BasedOn="{StaticResource Button.Round}">
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
      <Setter Property="Margin" Value="6,0,0,0" />
    </Style>
  </Window.Resources>

  <Border x:Name="RootBorder">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- =========================== Sidebar =========================== -->
      <!-- One background spans the whole window (the Orbs, a gradient, a colour or a picture chosen in Settings ›
           Appearance); the sidebar floats on it as a pane of the same dark glass as every card, inset from the window's
           edges. -->
      <c:WindowBackdrop x:Name="WindowBackdrop" Grid.ColumnSpan="2" Background="{DynamicResource Brush.ContentLayer}" />
      <c:SquircleBorder x:Name="Sidebar" Width="232" Margin="10" CornerRadius="22" Smoothing="0.7"
                        Background="{DynamicResource Brush.GlassFill}" BorderBrush="{DynamicResource Brush.GlassRim}" BorderThickness="1"
                        Sheen="0.5" Shadow="1" Frosted="True" RenderOptions.ClearTypeHint="Enabled">
        <Grid Margin="10,0,10,10">
          <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Brand (the app's icon, its name and this machine's) + collapse -->
          <Grid>
            <StackPanel Style="{StaticResource SidebarBrand}">
              <Image Source="{DynamicResource Image.AppIcon}" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
              <StackPanel Margin="10,0,0,0" VerticalAlignment="Center"
                          Visibility="{Binding IsCompactSidebar, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                <TextBlock Text="Coreloom" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Account.MachineName}" FontSize="11" Margin="0,1,0,0" Foreground="{DynamicResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" MaxWidth="120" />
              </StackPanel>
            </StackPanel>
            <Button Style="{StaticResource Button.Icon}" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-2,0"
                    WindowChrome.IsHitTestVisibleInChrome="True" Command="{Binding ToggleSidebarCommand}" ToolTip="Collapse sidebar"
                    Visibility="{Binding IsCompactSidebar, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
              <Path Style="{StaticResource IconPath}" Width="15" Height="15" Data="{StaticResource Icon.Sidebar}" />
            </Button>
          </Grid>

          <!-- Jump anywhere: a page or a settings section (Ctrl+K) -->
          <Grid Grid.Row="1" Margin="0,2,0,6">
            <c:QuickSearch x:Name="JumpSearch" Height="36" Placeholder="Search…" Hint="Type a page or a setting"
                           Text="{Binding JumpSearch}" Suggestions="{Binding JumpSuggestions}" ChooseCommand="{Binding JumpCommand}"
                           AutomationProperties.Name="Search pages and settings"
                           Visibility="{Binding IsCompactSidebar, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
            <Border Style="{StaticResource Badge}" Padding="6,1" Margin="0,0,10,0" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False"
                    Background="{DynamicResource Brush.Pill}" Visibility="{Binding Visibility, ElementName=JumpSearch}">
              <TextBlock Text="Ctrl K" FontSize="10.5" FontWeight="Medium" Foreground="{DynamicResource Brush.TextTertiary}" />
            </Border>
            <Button Style="{StaticResource Button.Icon}" HorizontalAlignment="Center" Command="{Binding ToggleSidebarCommand}"
                    ToolTip="Expand sidebar" Visibility="{Binding IsCompactSidebar, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
              <Path Style="{StaticResource IconPath}" Width="16" Height="16" Data="{StaticResource Icon.Sidebar}" />
            </Button>
          </Grid>

          <!-- Navigation, in its groups -->
          <ListBox x:Name="NavList" Grid.Row="2" Style="{StaticResource NavList}" ItemsSource="{Binding Source={StaticResource GroupedPages}}"
                   ItemContainerStyle="{StaticResource NavItemBound}" ItemTemplate="{StaticResource NavItemTemplate}"
                   IsSynchronizedWithCurrentItem="False" SelectionChanged="OnNavigationSelectionChanged">
            <ListBox.GroupStyle>
              <GroupStyle ContainerStyle="{StaticResource NavGroup}" />
            </ListBox.GroupStyle>
          </ListBox>

          <!-- Footer: Settings, an update when one is out, Dark mode and who's signed in -->
          <StackPanel Grid.Row="3">
            <Border Height="1" Margin="4,6,4,8" Background="{DynamicResource Brush.Divider}" />
            <ListBox x:Name="SettingsNav" Style="{StaticResource NavList}" ItemContainerStyle="{StaticResource NavItemBound}"
                     ItemTemplate="{StaticResource NavItemTemplate}" SelectionChanged="OnNavigationSelectionChanged" />

            <!-- Update button: a newer version is available, downloading or ready to install. -->
            <Button Style="{StaticResource Button.Update}" Margin="0,8,0,0"
                    Command="{Binding OpenUpdatesCommand}" ToolTip="{Binding Updates.BadgeToolTip}"
                    AutomationProperties.Name="{Binding Updates.BadgeToolTip}"
                    Visibility="{Binding Updates.ShowBadge, Converter={StaticResource BoolToVisibility}}">
              <StackPanel Orientation="Horizontal">
                <Border Width="26" Height="26" CornerRadius="13" Background="#2EFFFFFF" VerticalAlignment="Center">
                  <Path Style="{StaticResource IconPath}" Width="13" Height="13" Data="{StaticResource Icon.Sparkle}" Stroke="{DynamicResource Brush.OnAccent}" />
                </Border>
                <StackPanel Margin="9,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding IsCompactSidebar, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                  <TextBlock Text="{Binding Updates.BadgeText}" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource Brush.OnAccent}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Updates.BadgeDetail}" FontSize="11" Margin="0,1,0,0" Foreground="{DynamicResource Brush.OnAccent}" Opacity="0.8" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </StackPanel>
            </Button>

            <!-- Dark mode -->
            <Grid Height="36" Margin="13,8,8,0" Visibility="{Binding IsCompactSidebar, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
              <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsDarkMode}" AutomationProperties.Name="Dark mode" ToolTip="The dark theme; off is the light one">
                <StackPanel Orientation="Horizontal">
                  <Path Style="{StaticResource IconPath}" Width="16" Height="16" Data="{StaticResource Icon.Moon}" Stroke="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" />
                  <TextBlock Text="Dark mode" Margin="13,0,0,0" FontSize="13.5" FontWeight="Medium" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" />
                </StackPanel>
              </CheckBox>
            </Grid>
            <Button Style="{StaticResource Button.Icon}" Width="36" Height="36" HorizontalAlignment="Center" Margin="0,8,0,0" Command="{Binding ToggleDarkModeCommand}" ToolTip="Dark mode"
                    Visibility="{Binding IsCompactSidebar, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
              <Path Style="{StaticResource IconPath}" Width="16" Height="16" Data="{StaticResource Icon.Moon}" />
            </Button>

            <!-- Who's signed in, on which machine (opens Settings) -->
            <Button Style="{StaticResource Button.AccountChip}" Margin="0,8,0,0" Command="{Binding OpenSettingsCommand}" ToolTip="Settings"
                    AutomationProperties.Name="{Binding Account.DisplayName}">
              <Grid x:Name="AccountChip" Margin="4,4,10,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="34" Height="34">
                  <Ellipse Fill="{DynamicResource Brush.AccentSoft}" />
                  <TextBlock Text="{Binding Account.Initials}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <Ellipse Width="9" Height="9" Fill="{DynamicResource Brush.Success}" Stroke="{DynamicResource Brush.Card}" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                </Grid>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding IsCompactSidebar, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                  <TextBlock Text="{Binding Account.DisplayName}" FontSize="12.5" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Account.MachineName}" FontSize="11" Margin="0,1,0,0" Foreground="{DynamicResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Path Grid.Column="2" Style="{StaticResource IconPath}" Width="13" Height="13" Data="{StaticResource Icon.ChevronDown}" Stroke="{DynamicResource Brush.TextTertiary}" VerticalAlignment="Center"
                      Visibility="{Binding IsCompactSidebar, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
              </Grid>
            </Button>
          </StackPanel>
        </Grid>
      </c:SquircleBorder>

      <!-- =========================== Content =========================== -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="56" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The caption row: the greeting and the day at the left, the header's buttons and the window's at the right.
             The window's background shows through it. -->
        <Border Background="{DynamicResource Brush.TitleBar}" />
        <StackPanel Margin="32,9,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" IsHitTestVisible="False">
          <TextBlock x:Name="GreetingText" Style="{StaticResource Text.Greeting}" Text="{Binding Greeting}" />
          <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
            <Grid Width="10" Height="10" VerticalAlignment="Center">
              <Ellipse x:Name="LivePulse" Fill="{DynamicResource Brush.Success}" Opacity="0.35" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                  <ScaleTransform x:Name="LivePulseScale" ScaleX="1" ScaleY="1" />
                </Ellipse.RenderTransform>
              </Ellipse>
              <Ellipse x:Name="LiveDot" Width="7" Height="7" Fill="{DynamicResource Brush.Success}">
                <Ellipse.Style>
                  <Style TargetType="Ellipse">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsMonitoringPaused}" Value="True">
                        <Setter Property="Fill" Value="{DynamicResource Brush.Elevated}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsChartsFrozen}" Value="True">
                        <Setter Property="Fill" Value="{DynamicResource Brush.Elevated}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Ellipse.Style>
              </Ellipse>
            </Grid>
            <TextBlock Text="{Binding DateLine}" Margin="8,0,0,0" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" />
            <TextBlock Text=" · " FontSize="12" Foreground="{DynamicResource Brush.TextTertiary}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" ToolTip="Monitoring status and polling interval" />
          </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,11,148,0">
          <!-- Time window -->
          <ListBox Style="{StaticResource Segmented}" ItemsSource="{Binding WindowOptions}" DisplayMemberPath="Label" Height="34"
                   SelectedValuePath="Value" SelectedValue="{Binding SelectedWindow}" ToolTip="Chart time range" WindowChrome.IsHitTestVisibleInChrome="True" />

          <!-- Freeze charts -->
          <ToggleButton Style="{StaticResource ToggleButton.Icon}" Width="36" Height="36" Margin="8,0,0,0" IsChecked="{Binding IsChartsFrozen}" WindowChrome.IsHitTestVisibleInChrome="True"
                        Background="{DynamicResource Brush.Pill}" BorderBrush="{DynamicResource Brush.PillBorder}" Foreground="{DynamicResource Brush.Text}"
                        ToolTip="Pause charts to inspect them (monitoring continues)">
            <Grid>
              <Path Style="{StaticResource IconPath}" Width="14" Height="14" Data="{StaticResource Icon.Pause}"
                    Visibility="{Binding IsChartsFrozen, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
              <Path Style="{StaticResource IconPath}" Width="14" Height="14" Data="{StaticResource Icon.Play}"
                    Visibility="{Binding IsChartsFrozen, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
          </ToggleButton>

          <!-- Search (the sidebar's) -->
          <Button Style="{StaticResource Button.Header}" Click="OnSearchClick" ToolTip="Search pages and settings (Ctrl+K)" AutomationProperties.Name="Search">
            <Path Style="{StaticResource IconPath}" Width="15" Height="15" Data="{StaticResource Icon.Search}" />
          </Button>

          <!-- Updates: a count on the bell while one waits -->
          <Button Style="{StaticResource Button.Header}" Command="{Binding OpenUpdatesCommand}" ToolTip="Updates" AutomationProperties.Name="Updates">
            <Grid>
              <Path Style="{StaticResource IconPath}" Width="16" Height="16" Data="{StaticResource Icon.Bell}" />
              <Border Width="16" Height="16" CornerRadius="8" Background="{DynamicResource Brush.Accent}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-9,-10,0"
                      Visibility="{Binding Updates.ShowBadge, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="1" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Grid>
          </Button>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
          <Button x:Name="MinimizeButton" Style="{StaticResource Button.Caption}" WindowChrome.IsHitTestVisibleInChrome="True"
                  Content="{StaticResource Glyph.Minimize}" Click="OnMinimizeClick" ToolTip="Minimize" />
          <Button x:Name="MaximizeButton" Style="{StaticResource Button.Caption}" WindowChrome.IsHitTestVisibleInChrome="True"
                  Content="{StaticResource Glyph.Maximize}" Click="OnMaximizeClick" />
          <Button x:Name="CloseButton" Style="{StaticResource Button.CaptionClose}" WindowChrome.IsHitTestVisibleInChrome="True"
                  Content="{StaticResource Glyph.Close}" Click="OnCloseClick" ToolTip="Close" />
        </StackPanel>

        <!-- Page header: the page's name (it types in as the page changes) and what it's for -->
        <Grid Grid.Row="1" Margin="32,10,28,0">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Style="{StaticResource Text.PageTitle}" b:TypeIn.Text="{Binding CurrentPage.Title}" />
            <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,3,0,0" FontSize="13" Text="{Binding CurrentPage.HeaderLine}" />
          </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2">
          <!-- "Updated to …" banner (first launches after an update, until dismissed) -->
          <c:SquircleBorder Margin="32,16,28,0" Padding="14,10" CornerRadius="16"
                  Background="{DynamicResource Brush.AccentSoft}" BorderBrush="{DynamicResource Brush.CardBorder}" BorderThickness="1"
                  Visibility="{Binding Updates.ShowUpdatedBanner, Converter={StaticResource BoolToVisibility}}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Path Style="{StaticResource IconPath}" Width="16" Height="16" Data="{StaticResource Icon.Sparkle}" Stroke="{DynamicResource Brush.Accent}" />
              <TextBlock Grid.Column="1" Margin="12,0" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12.5" FontWeight="Medium"
                         Text="{Binding Updates.UpdatedBannerText}" />
              <Button Grid.Column="2" Style="{StaticResource Button.Secondary}" Content="See what's new" Padding="12,5"
                      Command="{Binding ShowWhatsNewCommand}" />
              <Button Grid.Column="3" Style="{StaticResource Button.Icon}" Width="28" Height="28" Margin="6,0,0,0"
                      Command="{Binding Updates.DismissUpdatedBannerCommand}" ToolTip="Dismiss" AutomationProperties.Name="Dismiss">
                <Path Style="{StaticResource IconPath}" Width="11" Height="11" Data="{StaticResource Icon.Close}" />
              </Button>
            </Grid>
          </c:SquircleBorder>

          <!-- Limited-mode banner -->
          <c:SquircleBorder Margin="32,16,28,0" Padding="14,10" CornerRadius="16"
                  Background="{DynamicResource Brush.BannerBackground}" BorderBrush="{DynamicResource Brush.BannerBorder}" BorderThickness="1"
                  Visibility="{Binding ShowLimitedModeBanner, Converter={StaticResource BoolToVisibility}}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Path Style="{StaticResource IconPath}" Width="16" Height="16" Data="{StaticResource Icon.Shield}" Stroke="{DynamicResource Brush.Elevated}" />
              <TextBlock Grid.Column="1" Margin="12,0" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12.5">
                <Run Text="{Binding LimitedModeText, Mode=OneWay}" />
                <Run Text=" Everything else is fully available." Foreground="{DynamicResource Brush.TextSecondary}" />
              </TextBlock>
              <Button Grid.Column="2" Style="{StaticResource Button.Secondary}" Content="About PawnIO" Padding="12,5"
                      Command="{Binding OpenPawnIoCommand}" ToolTip="Opens pawnio.eu in your browser. Coreloom never installs drivers." />
              <Button Grid.Column="3" Style="{StaticResource Button.Icon}" Width="28" Height="28" Margin="6,0,0,0" Command="{Binding DismissBannerCommand}" ToolTip="Dismiss">
                <Path Style="{StaticResource IconPath}" Width="11" Height="11" Data="{StaticResource Icon.Close}" />
              </Button>
            </Grid>
          </c:SquircleBorder>
        </StackPanel>

        <!-- Page -->
        <c:PageHost Grid.Row="3" Page="{Binding CurrentPage}" Margin="0,8,0,0" />

        <!-- A message over the page ("Export failed"), instead of a dialog; it leaves after five seconds. Since 1.9.0 a
             light pill with dark text, the one bright thing on the page, rising from the bottom. -->
        <c:SquircleBorder Grid.Row="3" Panel.ZIndex="10" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="32,0,28,24"
                          MaxWidth="560" Padding="16,9,8,9" CornerRadius="99" Smoothing="0" Shadow="1.2"
                          Background="{DynamicResource Brush.Toast}" BorderBrush="Transparent" BorderThickness="0"
                          b:Reveal.Enabled="True" b:Reveal.FromBelow="True"
                          Visibility="{Binding HasToast, Converter={StaticResource BoolToVisibility}}"
                          AutomationProperties.LiveSetting="Assertive" AutomationProperties.Name="{Binding ToastText}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Path Style="{StaticResource IconPath}" Width="15" Height="15" VerticalAlignment="Center"
                  Data="{StaticResource Icon.Warning}" Stroke="{DynamicResource Brush.Elevated}" />
            <TextBlock Grid.Column="1" Margin="12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="13" Foreground="{DynamicResource Brush.ToastText}">
              <Run Text="{Binding ToastTitle, Mode=OneWay}" FontWeight="Medium" /><Run Text=" · " /><Run Text="{Binding ToastText, Mode=OneWay}" />
            </TextBlock>
            <Button Grid.Column="2" Style="{StaticResource Button.Plain}" Padding="12,4" FontSize="12" Foreground="{DynamicResource Brush.ToastText}"
                    Background="{DynamicResource Brush.ToastControl}" Content="Dismiss" Command="{Binding DismissToastCommand}" AutomationProperties.Name="Dismiss" />
          </Grid>
        </c:SquircleBorder>
      </Grid>
    </Grid>
  </Border>
</Window>
