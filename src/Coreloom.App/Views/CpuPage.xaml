<UserControl x:Class="Coreloom.App.Views.CpuPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Coreloom.App.Controls"
             xmlns:b="clr-namespace:Coreloom.App.Behaviors"
             xmlns:pages="clr-namespace:Coreloom.ViewModels.Pages;assembly=Coreloom.ViewModels">

  <UserControl.Resources>
    <!-- Status pill of a processor control: accent for a known value, amber for "likely on", green for "looks off", grey otherwise -->
    <Style x:Key="TuningPill" TargetType="Border" BasedOn="{StaticResource Badge}">
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Padding" Value="8,2" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding StateKey}" Value="readonly">
          <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StateKey}" Value="detected">
          <Setter Property="Background" Value="{DynamicResource Brush.ElevatedSoft}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StateKey}" Value="off">
          <Setter Property="Background" Value="{DynamicResource Brush.SuccessSoft}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="TuningPillText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding StateKey}" Value="readonly">
          <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StateKey}" Value="detected">
          <Setter Property="Foreground" Value="{DynamicResource Brush.Elevated}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StateKey}" Value="off">
          <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <ScrollViewer Style="{StaticResource ScrollViewer.Window}">
    <StackPanel Margin="32,14,28,32" b:Motion.Entrance="True">

      <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
        <c:BrandMark Vendor="{Binding VendorKey}" Margin="0,0,12,0" />
        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Cpu}" Stroke="{DynamicResource Series.Cpu.Brush}" Margin="0,0,10,0" VerticalAlignment="Center"
              Visibility="{Binding VendorKey, Converter={StaticResource HasValueToVisibility}, ConverterParameter=Invert}" />
        <TextBlock Text="{Binding CpuName}" Style="{StaticResource Text.Section}" VerticalAlignment="Center" />
      </StackPanel>

      <!-- Why temperature/power may be missing -->
      <c:SquircleBorder Style="{StaticResource Card.Inset}" Margin="0,0,0,16" Visibility="{Binding LowLevelUnavailable, Converter={StaticResource BoolToVisibility}}">
        <StackPanel Orientation="Horizontal">
          <Path Style="{StaticResource IconPath}" Width="14" Height="14" Data="{StaticResource Icon.Info}" />
          <TextBlock Text="{Binding LowLevelMessage}" Margin="10,0,0,0" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" />
        </StackPanel>
      </c:SquircleBorder>

      <!-- Gauges -->
      <c:AdaptiveGrid MinColumnWidth="250" MaxColumns="4" Spacing="16">
        <ContentPresenter Content="{Binding Load}" ContentTemplate="{StaticResource GaugeCard}" />
        <ContentPresenter Content="{Binding Temperature}" ContentTemplate="{StaticResource GaugeCard}" />
        <ContentPresenter Content="{Binding Power}" ContentTemplate="{StaticResource GaugeCard}" />
        <ContentPresenter Content="{Binding Clock}" ContentTemplate="{StaticResource GaugeCard}" />
      </c:AdaptiveGrid>

      <!-- Health of the processor -->
      <ContentPresenter Content="{Binding Health}" ContentTemplate="{StaticResource HealthCard}" Margin="0,16,0,0" />

      <ItemsControl ItemsSource="{Binding Details}" ItemTemplate="{StaticResource MetricTile}" Margin="0,16,0,0" Focusable="False">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <c:AdaptiveGrid MinColumnWidth="168" MaxColumns="6" Spacing="12" UniformRowHeight="True" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>

      <!-- AMD processor: what it is, the readings it reports, and its tuning (read-only) -->
      <c:SquircleBorder Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="{Binding IsAmd, Converter={StaticResource BoolToVisibility}}">
        <StackPanel DataContext="{Binding Amd}">
          <Grid Margin="0,0,0,12">
            <StackPanel Margin="0,0,120,0">
              <TextBlock Style="{StaticResource Text.CardTitle}" Text="AMD processor" />
              <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
            </StackPanel>
            <Border Style="{StaticResource Badge}" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="8,2" Background="{DynamicResource Brush.AccentSoft}"
                    Visibility="{Binding Architecture, Converter={StaticResource HasValueToVisibility}}">
              <TextBlock Text="{Binding Architecture}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" />
            </Border>
          </Grid>

          <ItemsControl ItemsSource="{Binding Capabilities}" Focusable="False" Margin="0,0,0,10">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Badge}" Margin="0,0,6,6">
                  <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <ItemsControl ItemsSource="{Binding Readings}" ItemTemplate="{StaticResource MetricTile}" Focusable="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <c:AdaptiveGrid MinColumnWidth="168" MaxColumns="6" Spacing="12" UniformRowHeight="True" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>

          <ItemsControl ItemsSource="{Binding Missing}" Focusable="False" Margin="0,10,0,0" Visibility="{Binding HasMissing, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type pages:MissingReadings}">
                <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2">
                  <Run Text="Not reported: " /><Run Text="{Binding Names, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" — " /><Run Text="{Binding Reason, Mode=OneWay}" />
                </TextBlock>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Style="{StaticResource Text.Label}" Text="Limits and tuning" Margin="0,18,0,2" />
          <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding ReadOnlyNote}" TextWrapping="Wrap" Margin="0,0,0,8" />
          <ItemsControl ItemsSource="{Binding Controls}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type pages:TuningControlViewModel}">
                <c:SquircleBorder Style="{StaticResource Card.Inset}" Margin="0,0,0,8" Padding="12,10">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                      <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Explanation}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,3,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource TuningPill}">
                      <TextBlock Text="{Binding Status}" Style="{StaticResource TuningPillText}" />
                    </Border>
                  </Grid>
                </c:SquircleBorder>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </c:SquircleBorder>

      <!-- Charts -->
      <c:AdaptiveGrid MinColumnWidth="460" MaxColumns="2" Spacing="16" Margin="0,16,0,0">
        <ContentPresenter Content="{Binding LoadChart}" ContentTemplate="{StaticResource ChartCard}" Height="280" />
        <ContentPresenter Content="{Binding TemperatureChart}" ContentTemplate="{StaticResource ChartCard}" Height="280" />
        <ContentPresenter Content="{Binding PowerChart}" ContentTemplate="{StaticResource ChartCard}" Height="280" />
        <ContentPresenter Content="{Binding ClockChart}" ContentTemplate="{StaticResource ChartCard}" Height="280" />
      </c:AdaptiveGrid>

      <!-- Logical processors -->
      <c:SquircleBorder Style="{StaticResource Card}" Margin="0,16,0,0">
        <StackPanel>
          <Grid Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Style="{StaticResource Text.CardTitle}" Text="Logical processors" />
              <TextBlock Style="{StaticResource Text.Caption}" Text="Utilization per hardware thread over the last 60 seconds" Margin="0,2,0,0" />
            </StackPanel>
            <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" IsChecked="{Binding ShowThreads}">
              <TextBlock Text="Show graphs" Style="{StaticResource Text.Secondary}" />
            </CheckBox>
          </Grid>
          <ItemsControl ItemsSource="{Binding Threads}" Focusable="False" Visibility="{Binding ShowThreads, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <c:AdaptiveGrid MinColumnWidth="118" MaxColumns="16" Spacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type pages:ThreadTileViewModel}">
                <c:SquircleBorder Style="{StaticResource Card.Inset}" Padding="10,8,10,6">
                  <StackPanel>
                    <Grid>
                      <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Caption}" />
                      <TextBlock Text="{Binding ValueText}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    </Grid>
                    <c:Sparkline Height="30" Margin="0,6,0,0" MetricId="{Binding MetricId}" ColorKey="Cpu" Maximum="100" FillOpacity="0.22" StrokeThickness="1.2"
                                 Timeline="{Binding DataContext.Timeline, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                  </StackPanel>
                </c:SquircleBorder>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </c:SquircleBorder>

      <!-- Per-core table -->
      <c:SquircleBorder Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="{Binding HasCoreTable, Converter={StaticResource BoolToVisibility}}">
        <StackPanel>
          <TextBlock Style="{StaticResource Text.CardTitle}" Text="Cores" Margin="0,0,0,10" />
          <Grid Margin="8,0,8,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="120" />
              <ColumnDefinition Width="120" />
              <ColumnDefinition Width="110" />
              <ColumnDefinition Width="100" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Core" Style="{StaticResource Text.Label}" />
            <TextBlock Grid.Column="1" Text="Clock" Style="{StaticResource Text.Label}" TextAlignment="Right" />
            <TextBlock Grid.Column="2" Text="Effective" Style="{StaticResource Text.Label}" TextAlignment="Right" />
            <TextBlock Grid.Column="3" Text="Temperature" Style="{StaticResource Text.Label}" TextAlignment="Right" />
            <TextBlock Grid.Column="4" Text="Power" Style="{StaticResource Text.Label}" TextAlignment="Right" />
          </Grid>
          <ItemsControl ItemsSource="{Binding Cores}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type pages:CoreRowViewModel}">
                <Grid Margin="8,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="100" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Label}" FontSize="12.5" />
                  <TextBlock Grid.Column="1" Text="{Binding Clock}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextAlignment="Right" />
                  <TextBlock Grid.Column="2" Text="{Binding Effective}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextAlignment="Right" />
                  <TextBlock Grid.Column="3" Text="{Binding Temperature}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextAlignment="Right" />
                  <TextBlock Grid.Column="4" Text="{Binding Power}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextAlignment="Right" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </c:SquircleBorder>

      <!-- Processes + specs (each card as tall as its own content) -->
      <c:AdaptiveGrid MinColumnWidth="460" MaxColumns="2" Spacing="16" Margin="0,16,0,0">
        <c:SquircleBorder Style="{StaticResource Card}" VerticalAlignment="Top">
          <StackPanel>
            <TextBlock Style="{StaticResource Text.CardTitle}" Text="Top processes by CPU" />
            <TextBlock Style="{StaticResource Text.Caption}" Text="Grouped by application · refreshed every 2 seconds" Margin="0,2,0,10" />
            <ContentPresenter Content="{Binding Processes}" ContentTemplate="{StaticResource ProcessList}" />
          </StackPanel>
        </c:SquircleBorder>
        <c:SquircleBorder Style="{StaticResource Card}" VerticalAlignment="Top">
          <StackPanel>
            <TextBlock Style="{StaticResource Text.CardTitle}" Text="Specifications" Margin="0,0,0,10" />
            <ItemsControl ItemsSource="{Binding Specifications}" ItemTemplate="{StaticResource KeyValueRow}" Focusable="False" Grid.IsSharedSizeScope="True" />
          </StackPanel>
        </c:SquircleBorder>
      </c:AdaptiveGrid>

      <!-- Motherboard sensors, two cards side by side -->
      <StackPanel Orientation="Horizontal" Margin="0,24,0,10">
        <TextBlock Style="{StaticResource Text.Section}" Text="Motherboard fans &amp; temperatures" VerticalAlignment="Center" />
        <TextBlock Style="{StaticResource Text.Caption}" Text="Super I/O sensors (requires administrator rights and PawnIO)" Margin="10,2,0,0" VerticalAlignment="Center" />
      </StackPanel>
      <ContentPresenter Content="{Binding BoardSensors}" ContentTemplate="{StaticResource SensorColumns}" />

      <!-- All processor sensors, two cards side by side -->
      <Grid Margin="0,24,0,10">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Style="{StaticResource Text.Section}" Text="All processor sensors" VerticalAlignment="Center" />
          <TextBlock Style="{StaticResource Text.Caption}" Margin="10,2,0,0" VerticalAlignment="Center">
            <Run Text="{Binding Sensors.Count, Mode=OneWay}" /><Run Text=" readings" />
          </TextBlock>
        </StackPanel>
        <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" IsChecked="{Binding Sensors.ShowRaw}">
          <TextBlock Text="Raw sensors" Style="{StaticResource Text.Secondary}" />
        </CheckBox>
      </Grid>
      <ContentPresenter Content="{Binding Sensors}" ContentTemplate="{StaticResource SensorColumns}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
