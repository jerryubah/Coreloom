<UserControl x:Class="Coreloom.App.Views.PcIllustration"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Picture of this PC"
             Focusable="False">

  <!--
    The PC in the Overview header (bound to SystemSummaryViewModel): a render split into layers by
    build/pc-render.py, which also writes this file (edit the script and regenerate rather than editing it). The base
    picture has its glow taken out; the glow layer is filled with the color chosen under Customize (or cycles for
    Rainbow); each fan's blades turn at a speed that follows the PC's fans; the pump screen and the card show live
    text.

    A render or photo of the real build can replace it: pc.png in %AppData%\Coreloom (or Data next to a portable copy)
    or in assets/pc/ at build time. See assets/pc/README.md.
  -->
  <Grid>
    <Grid x:Name="Picture" Background="Transparent" ToolTip="{Binding FanToolTip}" ToolTipService.InitialShowDelay="900">
      <Viewbox x:Name="Art" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
        <Grid Width="555" Height="663">
          <Image Source="pack://application:,,,/Assets/PcRender/base.png" Width="555" Height="663" />
          <Rectangle x:Name="GlowLayer" Width="555" Height="663" Fill="#0D6BFF" IsHitTestVisible="False">
            <Rectangle.OpacityMask>
              <ImageBrush ImageSource="pack://application:,,,/Assets/PcRender/glow.png" />
            </Rectangle.OpacityMask>
          </Rectangle>

          <!-- Fan blades: turned by PcIllustration.xaml.cs -->
          <Canvas IsHitTestVisible="False">
            <Grid Canvas.Left="116.54" Canvas.Top="81.49" Width="85.52" Height="85.52" RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform>
                <TransformGroup>
                  <RotateTransform x:Name="FanTop1Turn" Angle="0" />
                  <ScaleTransform ScaleY="0.2707" />
                  <RotateTransform Angle="2.4" />
                </TransformGroup>
              </Grid.RenderTransform>
              <Image x:Name="FanTop1Sharp" Source="pack://application:,,,/Assets/PcRender/blades-top1.png" />
              <Image x:Name="FanTop1Blur" Source="pack://application:,,,/Assets/PcRender/blades-top1-blur.png" Opacity="0" />
            </Grid>
            <Grid Canvas.Left="221.54" Canvas.Top="76.98" Width="83.63" Height="83.63" RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform>
                <TransformGroup>
                  <RotateTransform x:Name="FanTop2Turn" Angle="23" />
                  <ScaleTransform ScaleY="0.2881" />
                  <RotateTransform Angle="0.2" />
                </TransformGroup>
              </Grid.RenderTransform>
              <Image x:Name="FanTop2Sharp" Source="pack://application:,,,/Assets/PcRender/blades-top2.png" />
              <Image x:Name="FanTop2Blur" Source="pack://application:,,,/Assets/PcRender/blades-top2-blur.png" Opacity="0" />
            </Grid>
            <Grid Canvas.Left="326.79" Canvas.Top="70.46" Width="85.24" Height="85.24" RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform>
                <TransformGroup>
                  <RotateTransform x:Name="FanTop3Turn" Angle="9" />
                  <ScaleTransform ScaleY="0.2938" />
                  <RotateTransform Angle="-0.8" />
                </TransformGroup>
              </Grid.RenderTransform>
              <Image x:Name="FanTop3Sharp" Source="pack://application:,,,/Assets/PcRender/blades-top3.png" />
              <Image x:Name="FanTop3Blur" Source="pack://application:,,,/Assets/PcRender/blades-top3-blur.png" Opacity="0" />
            </Grid>
            <Grid Canvas.Left="103.59" Canvas.Top="507.07" Width="88.64" Height="88.64" RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform>
                <TransformGroup>
                  <RotateTransform x:Name="FanBottom1Turn" Angle="31" />
                  <ScaleTransform ScaleY="0.1802" />
                  <RotateTransform Angle="-1.7" />
                </TransformGroup>
              </Grid.RenderTransform>
              <Image x:Name="FanBottom1Sharp" Source="pack://application:,,,/Assets/PcRender/blades-bottom1.png" />
              <Image x:Name="FanBottom1Blur" Source="pack://application:,,,/Assets/PcRender/blades-bottom1-blur.png" Opacity="0" />
            </Grid>
            <Grid Canvas.Left="208.24" Canvas.Top="510.85" Width="87.13" Height="87.13" RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform>
                <TransformGroup>
                  <RotateTransform x:Name="FanBottom2Turn" Angle="5" />
                  <ScaleTransform ScaleY="0.1898" />
                  <RotateTransform Angle="-1.4" />
                </TransformGroup>
              </Grid.RenderTransform>
              <Image x:Name="FanBottom2Sharp" Source="pack://application:,,,/Assets/PcRender/blades-bottom2.png" />
              <Image x:Name="FanBottom2Blur" Source="pack://application:,,,/Assets/PcRender/blades-bottom2-blur.png" Opacity="0" />
            </Grid>
            <Grid Canvas.Left="316.01" Canvas.Top="511.93" Width="90.81" Height="90.81" RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform>
                <TransformGroup>
                  <RotateTransform x:Name="FanBottom3Turn" Angle="17" />
                  <ScaleTransform ScaleY="0.1873" />
                  <RotateTransform Angle="-0.4" />
                </TransformGroup>
              </Grid.RenderTransform>
              <Image x:Name="FanBottom3Sharp" Source="pack://application:,,,/Assets/PcRender/blades-bottom3.png" />
              <Image x:Name="FanBottom3Blur" Source="pack://application:,,,/Assets/PcRender/blades-bottom3-blur.png" Opacity="0" />
            </Grid>
          </Canvas>

          <!-- Live text: the pump screen and the graphics card -->
          <Canvas IsHitTestVisible="False" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale">
            <TextBlock Canvas.Left="210.42" Canvas.Top="221.97" Width="90" TextAlignment="Center" Text="{Binding ScreenValue}"
                       FontSize="26.72" FontWeight="SemiBold" Foreground="#F5FFFFFF" />
            <TextBlock Canvas.Left="225.69" Canvas.Top="248.78" Width="60" TextAlignment="Center" Text="{Binding ScreenLabel}"
                       FontSize="11.88" FontWeight="SemiBold" Foreground="#E6FFFFFF" />
            <TextBlock Canvas.Left="133.92" Canvas.Top="342.93" Width="177.12" TextTrimming="CharacterEllipsis" Text="{Binding GpuLabel}"
                       FontSize="22.27" FontWeight="SemiBold" Foreground="#F2FFFFFF"
                       Visibility="{Binding ShowGpuLabel, Converter={StaticResource BoolToVisibility}}" />
          </Canvas>
        </Grid>
      </Viewbox>
      <Image x:Name="CustomImage" Stretch="Uniform" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality" />
    </Grid>
  </Grid>
</UserControl>
