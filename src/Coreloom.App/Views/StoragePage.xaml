<UserControl x:Class="Coreloom.App.Views.StoragePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Coreloom.App.Controls"
             xmlns:b="clr-namespace:Coreloom.App.Behaviors"
             xmlns:pages="clr-namespace:Coreloom.ViewModels.Pages;assembly=Coreloom.ViewModels">

  <ScrollViewer Style="{StaticResource ScrollViewer.Window}">
    <StackPanel Margin="32,14,28,32" b:Motion.Entrance="True">

      <c:AdaptiveGrid MinColumnWidth="300" MaxColumns="3" Spacing="16">
        <ContentPresenter Content="{Binding TotalRead}" ContentTemplate="{StaticResource MetricTile}" />
        <ContentPresenter Content="{Binding TotalWrite}" ContentTemplate="{StaticResource MetricTile}" />
      </c:AdaptiveGrid>

      <!-- Health of the drives -->
      <ContentPresenter Content="{Binding Health}" ContentTemplate="{StaticResource HealthCard}" Margin="0,16,0,0" />

      <ContentPresenter Content="{Binding TotalChart}" ContentTemplate="{StaticResource ChartCard}" Height="260" Margin="0,16,0,0" />

      <!-- Drive speed test -->
      <c:SquircleBorder Style="{StaticResource Card}" Margin="0,16,0,0" DataContext="{Binding Benchmark}" Padding="20,18">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <c:SquircleBorder Width="38" Height="38" CornerRadius="11" Background="{DynamicResource Brush.AccentSoft}" VerticalAlignment="Top">
              <Path Style="{StaticResource IconPath}" Width="18" Height="18" Data="{StaticResource Icon.Gauge}" Stroke="{DynamicResource Brush.Accent}" />
            </c:SquircleBorder>
            <StackPanel Grid.Column="1" Margin="12,0,0,0">
              <TextBlock Style="{StaticResource Text.CardTitle}" Text="Drive speed test" />
              <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,2,0,0" />
            </StackPanel>
          </Grid>

          <!-- Drive, size and start -->
          <WrapPanel Margin="0,14,0,0" Orientation="Horizontal">
            <ComboBox Style="{StaticResource ComboBox.Default}" MinWidth="280" Margin="0,0,10,8" ItemsSource="{Binding Drives}" DisplayMemberPath="Text"
                      SelectedItem="{Binding SelectedDrive}" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="Drive to test" />
            <ListBox Style="{StaticResource Segmented}" Margin="0,0,10,8" VerticalAlignment="Center" ItemsSource="{Binding Sizes}" DisplayMemberPath="Text"
                     SelectedItem="{Binding SelectedSize}" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="Test size" />
            <Button Style="{StaticResource Button.Icon}" Margin="0,0,10,8" Command="{Binding RefreshDrivesCommand}" ToolTip="Refresh the list of drives"
                    AutomationProperties.Name="Refresh drives">
              <Path Style="{StaticResource IconPath}" Width="15" Height="15" Data="{StaticResource Icon.Refresh}" />
            </Button>
            <Button Style="{StaticResource Button.Primary}" Padding="18,8" Margin="0,0,10,8" Command="{Binding RunCommand}"
                    Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisibility}}">
              <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource IconPath}" Width="13" Height="13" Data="{StaticResource Icon.Play}" Stroke="{DynamicResource Brush.OnGlow}" />
                <TextBlock Text="Start test" Margin="7,0,0,0" />
              </StackPanel>
            </Button>
            <Button Style="{StaticResource Button.Secondary}" Padding="18,8" Margin="0,0,10,8" Content="Cancel" Command="{Binding CancelCommand}"
                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
          </WrapPanel>

          <ProgressBar Style="{StaticResource ProgressBar.Thin}" Margin="0,4,0,0" Maximum="1"
                       b:Smooth.Value="{Binding Progress}" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
          <Border Background="{DynamicResource Brush.CriticalSoft}" CornerRadius="8" Padding="12,8" Margin="0,8,0,0"
                  Visibility="{Binding Error, Converter={StaticResource HasValueToVisibility}}">
            <StackPanel Orientation="Horizontal">
              <Path Style="{StaticResource IconPath}" Width="14" Height="14" Data="{StaticResource Icon.Warning}" Stroke="{DynamicResource Brush.Critical}" />
              <TextBlock Text="{Binding Error}" Margin="8,0,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}" />
            </StackPanel>
          </Border>

          <!-- Gauges and results -->
          <c:AdaptiveGrid MinColumnWidth="400" MaxColumns="2" Spacing="20" Margin="0,16,0,0">
            <c:SquircleBorder Style="{StaticResource Card.Inset}" Padding="16,18">
              <c:AdaptiveGrid MinColumnWidth="170" MaxColumns="2" Spacing="12" VerticalAlignment="Center">
                <ContentPresenter Content="{Binding ReadGauge}" ContentTemplate="{StaticResource ToneGauge}" />
                <ContentPresenter Content="{Binding WriteGauge}" ContentTemplate="{StaticResource ToneGauge}" />
              </c:AdaptiveGrid>
            </c:SquircleBorder>
            <StackPanel>
              <Grid Margin="14,0,14,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1.2*" MinWidth="130" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Test" Style="{StaticResource Text.Label}" />
                <TextBlock Grid.Column="1" Text="Read" Style="{StaticResource Text.Label}" />
                <TextBlock Grid.Column="2" Text="Write" Style="{StaticResource Text.Label}" />
              </Grid>
              <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource DiskBenchmarkRow}" Focusable="False" />
              <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Summary}" Margin="2,2,0,0"
                         Visibility="{Binding Summary, Converter={StaticResource HasValueToVisibility}}" />
            </StackPanel>
          </c:AdaptiveGrid>
        </StackPanel>
      </c:SquircleBorder>

      <!-- Drives side by side end on one line: the shorter card's chart grows, so its volumes line up at the bottom -->
      <ItemsControl ItemsSource="{Binding Disks}" Margin="0,16,0,0" Focusable="False">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <c:AdaptiveGrid MinColumnWidth="520" MaxColumns="2" Spacing="16" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type pages:DiskViewModel}">
            <c:SquircleBorder Style="{StaticResource Card}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- Header -->
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <c:SquircleBorder Width="34" Height="34" CornerRadius="10" Background="{DynamicResource Brush.ControlHover}">
                    <Path Style="{StaticResource IconPath}" Width="16" Height="16" Data="{StaticResource Icon.Storage}" Stroke="{DynamicResource Series.Storage.Brush}" />
                  </c:SquircleBorder>
                  <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.CardTitle}" />
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,0">
                      <Run Text="{Binding Kind, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Capacity, Mode=OneWay}" />
                    </TextBlock>
                  </StackPanel>
                  <Border Grid.Column="2" Style="{StaticResource Badge}" Padding="8,3" Visibility="{Binding Temperature.HasValue, Converter={StaticResource BoolToVisibility}}"
                          ToolTip="{Binding Temperature.ToolTip}">
                    <StackPanel Orientation="Horizontal">
                      <Path Style="{StaticResource IconPath}" Width="12" Height="12" Data="{StaticResource Icon.Temperature}" />
                      <TextBlock Margin="4,0,0,0" FontFamily="{StaticResource MonoFont}" FontSize="11.5" FontWeight="SemiBold">
                        <Run Text="{Binding Temperature.Number, Mode=OneWay}" /><Run Text="{Binding Temperature.Unit, Mode=OneWay}" />
                      </TextBlock>
                    </StackPanel>
                  </Border>
                </Grid>

                <!-- Live metrics -->
                <c:AdaptiveGrid Grid.Row="1" MinColumnWidth="120" MaxColumns="3" Spacing="10" Margin="0,14,0,0">
                  <ContentPresenter Content="{Binding Read}" ContentTemplate="{StaticResource MetricTile}" />
                  <ContentPresenter Content="{Binding Write}" ContentTemplate="{StaticResource MetricTile}" />
                  <ContentPresenter Content="{Binding Activity}" ContentTemplate="{StaticResource MetricTile}" />
                </c:AdaptiveGrid>

                <TextBlock Grid.Row="2" Style="{StaticResource Text.Caption}" Text="{Binding Health}" Margin="0,10,0,0"
                           Visibility="{Binding Health, Converter={StaticResource HasValueToVisibility}}" />

                <c:LiveLineChart Grid.Row="3" MinHeight="170" Margin="0,12,0,0" Chart="{Binding Chart}"
                                 Timeline="{Binding DataContext.Timeline, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                <!-- Volumes -->
                <ItemsControl Grid.Row="4" ItemsSource="{Binding Volumes}" ItemTemplate="{StaticResource VolumeRow}" Margin="0,10,0,0" Focusable="False" />
              </Grid>
            </c:SquircleBorder>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
