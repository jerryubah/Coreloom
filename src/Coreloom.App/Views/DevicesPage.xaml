<UserControl x:Class="Coreloom.App.Views.DevicesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Coreloom.App.Controls"
             xmlns:b="clr-namespace:Coreloom.App.Behaviors"
             xmlns:pages="clr-namespace:Coreloom.ViewModels.Pages;assembly=Coreloom.ViewModels">

  <UserControl.Resources>
    <!-- A small spinning arc for "working". -->
    <Style x:Key="DeviceSpinner" TargetType="c:RadialGauge">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="Thickness" Value="2.2" />
      <Setter Property="SweepAngle" Value="359" />
      <Setter Property="Value" Value="0.28" />
      <Setter Property="TrackBrush" Value="Transparent" />
      <Setter Property="Fill" Value="{DynamicResource Brush.Accent}" />
    </Style>

    <!-- A paired Bluetooth device, kept compact: icon, name and type; a status pill and battery; Connect or Disconnect. -->
    <DataTemplate x:Key="BluetoothCard" DataType="{x:Type pages:BluetoothDeviceViewModel}">
      <c:SquircleBorder x:Name="Card" Style="{StaticResource Card}" Padding="14,13,14,14" ToolTip="{Binding AddressText}" ToolTipService.InitialShowDelay="900">
        <c:SquircleBorder.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Rename…" Command="{Binding RenameCommand}" />
            <MenuItem Header="Use the device's own name" Command="{Binding ResetNameCommand}"
                      Visibility="{Binding HasCustomName, Converter={StaticResource BoolToVisibility}}" />
          </ContextMenu>
        </c:SquircleBorder.ContextMenu>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Icon, name and type (the name gets the whole width), and Rename. Renaming swaps the name for a text box:
               Enter or a click elsewhere keeps the name, Esc cancels, and an empty box goes back to the device's own. -->
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Width="38" Height="38" VerticalAlignment="Top">
              <Ellipse x:Name="Halo" Fill="{DynamicResource Brush.TextTertiary}" Opacity="0.14" />
              <Path x:Name="Glyph" Style="{StaticResource IconPath}" Width="18" Height="18" Data="{Binding IconKey, Converter={StaticResource IconKeyToGeometry}}"
                    Stroke="{DynamicResource Brush.TextSecondary}" />
            </Grid>
            <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center"
                        Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
              <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis"
                         ToolTip="{Binding NameToolTip}" />
              <TextBlock Style="{StaticResource Text.Caption}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis">
                <Run Text="{Binding KindText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding TransportText, Mode=OneWay}" />
              </TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="1" Grid.ColumnSpan="2" Margin="11,0,0,0" VerticalAlignment="Center"
                        Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibility}}">
              <TextBox Style="{StaticResource TextBox.Default}" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" MaxLength="48" Padding="8,5"
                       AutomationProperties.Name="Device name" b:EditBox.FocusOnShow="True" b:EditBox.CommitOnLeave="{Binding SaveNameCommand}">
                <TextBox.InputBindings>
                  <KeyBinding Key="Enter" Command="{Binding SaveNameCommand}" />
                  <KeyBinding Key="Escape" Command="{Binding CancelRenameCommand}" />
                </TextBox.InputBindings>
              </TextBox>
              <TextBlock Style="{StaticResource Text.Caption}" Margin="1,5,0,0" TextWrapping="Wrap">
                <Run Text="Shown in Coreloom only. Leave it empty for its own name, " /><Run Text="{Binding ReportedName, Mode=OneWay}" /><Run Text="." />
              </TextBlock>
            </StackPanel>
            <Button Grid.Column="2" Style="{StaticResource Button.Icon}" Width="28" Height="28" Margin="6,0,-5,0" VerticalAlignment="Center"
                    Command="{Binding RenameCommand}" ToolTip="Rename" AutomationProperties.Name="Rename"
                    Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
              <Path Style="{StaticResource IconPath}" Width="13" Height="13" Data="{StaticResource Icon.Edit}" />
            </Button>
          </Grid>

          <!-- Status pill and battery -->
          <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border CornerRadius="10" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource Brush.ControlHover}"
                    ToolTip="{Binding StatusText}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="Dot" Width="7" Height="7" VerticalAlignment="Center" Fill="{DynamicResource Brush.TextTertiary}" />
                <TextBlock x:Name="State" Grid.Column="1" Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0"
                           Foreground="{DynamicResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" />
              </Grid>
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0"
                        Visibility="{Binding HasBattery, Converter={StaticResource BoolToVisibility}}" ToolTip="Battery">
              <Grid Width="22" Height="12" VerticalAlignment="Center">
                <Path Style="{StaticResource IconPath}" Width="22" Height="12" Data="{StaticResource Icon.Battery}" StrokeThickness="1.4"
                      Stroke="{Binding BatteryColorKey, Converter={StaticResource ColorKeyToBrush}}" />
                <ProgressBar Style="{StaticResource ProgressBar.Thin}" Width="14" Height="6" Margin="2.5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                             Maximum="1" Background="Transparent" Foreground="{Binding BatteryColorKey, Converter={StaticResource ColorKeyToBrush}}"
                             b:Smooth.Value="{Binding BatteryFraction}" />
              </Grid>
              <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"
                         Foreground="{DynamicResource Brush.Text}" b:AnimatedText.Formatter="{Binding BatteryFormatter}" b:AnimatedText.Value="{Binding Battery}" />
              <TextBlock Text="%" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="1,0,0,0" />
            </StackPanel>
          </Grid>

          <!-- How the last action went -->
          <TextBlock x:Name="Message" Grid.Row="2" Text="{Binding Message}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                     Foreground="{DynamicResource Brush.Success}" b:Pop.Trigger="{Binding Message, Converter={StaticResource HasValueToBool}}"
                     Visibility="{Binding Message, Converter={StaticResource HasValueToVisibility}}" />

          <!-- Connect / Disconnect -->
          <Grid Grid.Row="4" Margin="0,12,0,0">
            <Button x:Name="Connect" Style="{StaticResource Button.Primary}" Padding="12,6" HorizontalAlignment="Stretch" Command="{Binding ActionCommand}">
              <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource IconPath}" Width="13" Height="13" Data="{StaticResource Icon.Link}" Stroke="{DynamicResource Brush.OnGlow}"
                      Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                <c:RadialGauge Style="{StaticResource DeviceSpinner}" Fill="{DynamicResource Brush.OnGlow}" b:Spin.IsSpinning="{Binding IsBusy}"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding ActionText}" Margin="7,0,0,0" />
              </StackPanel>
            </Button>
            <Button x:Name="Disconnect" Style="{StaticResource Button.Secondary}" Padding="12,6" HorizontalAlignment="Stretch" Command="{Binding ActionCommand}" Visibility="Collapsed">
              <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource IconPath}" Width="13" Height="13" Data="{StaticResource Icon.Unlink}"
                      Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                <c:RadialGauge Style="{StaticResource DeviceSpinner}" b:Spin.IsSpinning="{Binding IsBusy}"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding ActionText}" Margin="7,0,0,0" />
              </StackPanel>
            </Button>
          </Grid>
        </Grid>
      </c:SquircleBorder>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsConnected}" Value="True">
          <Setter TargetName="Halo" Property="Fill" Value="{DynamicResource Brush.Success}" />
          <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource Brush.Success}" />
          <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.SuccessSoft}" />
          <Setter TargetName="Connect" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="Disconnect" Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StatusKey}" Value="Connected">
          <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.Success}" />
          <Setter TargetName="State" Property="Foreground" Value="{DynamicResource Brush.Success}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StatusKey}" Value="Busy">
          <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.Accent}" />
          <Setter TargetName="Dot" Property="b:Pulse.IsPulsing" Value="True" />
          <Setter TargetName="State" Property="Text" Value="{Binding ActionText}" />
          <Setter TargetName="State" Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding MessageIsError}" Value="True">
          <Setter TargetName="Message" Property="Foreground" Value="{DynamicResource Brush.Elevated}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A device plugged in by wire: a compact card, the same width as the Bluetooth cards above. -->
    <DataTemplate x:Key="WiredCard" DataType="{x:Type pages:WiredDeviceViewModel}">
      <c:SquircleBorder Style="{StaticResource Card}" Padding="12,11">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid Width="34" Height="34" VerticalAlignment="Top">
            <Ellipse Fill="{DynamicResource Brush.Accent}" Opacity="0.12" />
            <Path Style="{StaticResource IconPath}" Width="16" Height="16" Data="{Binding IconKey, Converter={StaticResource IconKeyToGeometry}}"
                  Stroke="{DynamicResource Brush.Accent}" />
          </Grid>
          <StackPanel Grid.Column="1" Margin="11,0,6,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
            <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" />
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding HasProblem, Converter={StaticResource BoolToVisibility}}">
              <Path Style="{StaticResource IconPath}" Width="12" Height="12" Data="{StaticResource Icon.Warning}" Stroke="{DynamicResource Brush.Elevated}" />
              <TextBlock Text="{Binding ProblemText}" FontSize="11.5" Foreground="{DynamicResource Brush.Elevated}" Margin="5,0,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <TextBlock x:Name="Message" Text="{Binding Message}" FontSize="11.5" Foreground="{DynamicResource Brush.Success}" TextWrapping="Wrap" Margin="0,4,0,0"
                       b:Pop.Trigger="{Binding Message, Converter={StaticResource HasValueToBool}}"
                       Visibility="{Binding Message, Converter={StaticResource HasValueToVisibility}}" />
          </StackPanel>
          <Button Grid.Column="2" Style="{StaticResource Button.Secondary}" Width="32" Height="32" Padding="0" VerticalAlignment="Center" Command="{Binding EjectCommand}"
                  ToolTip="Eject (safely remove)" AutomationProperties.Name="Eject" Visibility="{Binding CanEject, Converter={StaticResource BoolToVisibility}}">
            <Grid>
              <Path Style="{StaticResource IconPath}" Width="13" Height="13" Data="{StaticResource Icon.Eject}"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
              <c:RadialGauge Style="{StaticResource DeviceSpinner}" Width="13" Height="13" b:Spin.IsSpinning="{Binding IsBusy}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
          </Button>
        </Grid>
      </c:SquircleBorder>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding MessageIsError}" Value="True">
          <Setter TargetName="Message" Property="Foreground" Value="{DynamicResource Brush.Elevated}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A group of wired devices: a heading and its cards stacked in one column. -->
    <DataTemplate x:Key="WiredGroup" DataType="{x:Type pages:DeviceGroupViewModel}">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="2,0,0,10">
          <Path Style="{StaticResource IconPath}" Width="14" Height="14" Data="{Binding IconKey, Converter={StaticResource IconKeyToGeometry}}"
                Stroke="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" Margin="8,0,0,0" VerticalAlignment="Center" />
          <Border Style="{StaticResource Badge}" Margin="8,0,0,0">
            <TextBlock Text="{Binding CountText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" />
          </Border>
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Devices}" ItemTemplate="{StaticResource WiredCard}" Focusable="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <c:AdaptiveGrid MinColumnWidth="1" MaxColumns="1" Spacing="10" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer Style="{StaticResource ScrollViewer.Window}">
    <StackPanel Margin="32,14,28,32" b:Motion.Entrance="True">

      <!-- Not available here -->
      <c:SquircleBorder Style="{StaticResource Card}" Margin="0,0,0,16" Background="{DynamicResource Brush.ElevatedSoft}"
              Visibility="{Binding IsSupported, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
        <StackPanel Orientation="Horizontal">
          <Path Style="{StaticResource IconPath}" Width="16" Height="16" Data="{StaticResource Icon.Info}" Stroke="{DynamicResource Brush.Elevated}" />
          <TextBlock Text="{Binding UnsupportedText}" Margin="10,0,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}" />
        </StackPanel>
      </c:SquircleBorder>

      <!-- ============================================================ -->
      <!-- Bluetooth adapter and summary                                -->
      <!-- ============================================================ -->
      <c:SquircleBorder Style="{StaticResource Card.Glow}" GlowKey="Accent" GlowStrength="0.8" Sheen="0.8" Padding="0">
        <Grid>
          <c:SquircleBorder CornerRadius="17" Background="{DynamicResource Brush.AccentSoft}" IsHitTestVisible="False">
            <c:SquircleBorder.OpacityMask>
              <RadialGradientBrush Center="0.12,0.2" GradientOrigin="0.12,0.2" RadiusX="0.5" RadiusY="1.1">
                <GradientStop Color="#FF000000" Offset="0" />
                <GradientStop Color="#00000000" Offset="1" />
              </RadialGradientBrush>
            </c:SquircleBorder.OpacityMask>
          </c:SquircleBorder>

          <c:AdaptiveGrid MinColumnWidth="340" MaxColumns="2" Spacing="20" Margin="24,22">
            <StackPanel VerticalAlignment="Center">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="48" Height="48">
                  <Ellipse x:Name="RadioHalo" Fill="{DynamicResource Brush.Accent}" Opacity="0.18" />
                  <Path Style="{StaticResource IconPath}" Width="22" Height="22" Data="{StaticResource Icon.Wireless}" Stroke="{DynamicResource Brush.Accent}" />
                </Grid>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="Bluetooth" Style="{StaticResource Text.Section}" />
                  <TextBlock Text="{Binding RadioText}" Style="{StaticResource Text.Secondary}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                  <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsRadioOn}" IsEnabled="{Binding CanToggleRadio}"
                            AutomationProperties.Name="Bluetooth" ToolTip="Turn Bluetooth on or off" />
                  <c:RadialGauge Style="{StaticResource DeviceSpinner}" Margin="10,0,0,0" b:Spin.IsSpinning="{Binding IsRadioBusy}"
                                 Visibility="{Binding IsRadioBusy, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
              </Grid>

              <TextBlock Text="{Binding BluetoothSummary}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,14,0,0" />
              <Border Background="{DynamicResource Brush.ElevatedSoft}" CornerRadius="8" Padding="10,6" Margin="0,10,0,0" HorizontalAlignment="Left"
                      Visibility="{Binding LowBatteryText, Converter={StaticResource HasValueToVisibility}}">
                <StackPanel Orientation="Horizontal">
                  <Path Style="{StaticResource IconPath}" Width="16" Height="10" Data="{StaticResource Icon.Battery}" Stroke="{DynamicResource Brush.Elevated}" />
                  <TextBlock Text="{Binding LowBatteryText}" FontSize="12" Margin="8,0,0,0" Foreground="{DynamicResource Brush.Text}" />
                </StackPanel>
              </Border>
              <TextBlock Text="{Binding RadioMessage}" FontSize="12" Foreground="{DynamicResource Brush.Elevated}" TextWrapping="Wrap" Margin="0,8,0,0"
                         Visibility="{Binding RadioMessage, Converter={StaticResource HasValueToVisibility}}" />

              <WrapPanel Margin="0,16,0,0">
                <Button Style="{StaticResource Button.Primary}" Padding="16,8" Margin="0,0,8,0" Command="{Binding PairCommand}">
                  <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource IconPath}" Width="13" Height="13" Data="{StaticResource Icon.Plus}" Stroke="{DynamicResource Brush.OnGlow}" />
                    <TextBlock Text="Pair a new device" Margin="7,0,0,0" />
                  </StackPanel>
                </Button>
                <Button Style="{StaticResource Button.Secondary}" Padding="14,8" Command="{Binding RefreshCommand}" ToolTip="Check again">
                  <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource IconPath}" Width="13" Height="13" Data="{StaticResource Icon.Refresh}" />
                    <TextBlock Text="Refresh" Margin="7,0,0,0" />
                  </StackPanel>
                </Button>
              </WrapPanel>
            </StackPanel>

            <!-- At a glance -->
            <c:AdaptiveGrid MinColumnWidth="100" MaxColumns="3" Spacing="10" UniformRowHeight="True" VerticalAlignment="Center">
              <c:SquircleBorder Style="{StaticResource Card.Inset}" Padding="14,12">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource Brush.Success}" VerticalAlignment="Center" />
                    <TextBlock Text="Connected" Style="{StaticResource Text.Label}" Margin="7,0,0,0" />
                  </StackPanel>
                  <TextBlock Text="{Binding ConnectedCount}" FontFamily="{StaticResource MonoFont}" FontSize="26" FontWeight="SemiBold" Margin="0,6,0,0" Foreground="{DynamicResource Brush.Text}" />
                  <TextBlock Text="Bluetooth" Style="{StaticResource Text.Caption}" />
                </StackPanel>
              </c:SquircleBorder>
              <c:SquircleBorder Style="{StaticResource Card.Inset}" Padding="14,12">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource Brush.Info}" VerticalAlignment="Center" />
                    <TextBlock Text="Paired" Style="{StaticResource Text.Label}" Margin="7,0,0,0" />
                  </StackPanel>
                  <TextBlock Text="{Binding PairedCount}" FontFamily="{StaticResource MonoFont}" FontSize="26" FontWeight="SemiBold" Margin="0,6,0,0" Foreground="{DynamicResource Brush.Text}" />
                  <TextBlock Text="Bluetooth" Style="{StaticResource Text.Caption}" />
                </StackPanel>
              </c:SquircleBorder>
              <c:SquircleBorder Style="{StaticResource Card.Inset}" Padding="14,12">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource Brush.Accent}" VerticalAlignment="Center" />
                    <TextBlock Text="Plugged in" Style="{StaticResource Text.Label}" Margin="7,0,0,0" />
                  </StackPanel>
                  <TextBlock Text="{Binding WiredCount}" FontFamily="{StaticResource MonoFont}" FontSize="26" FontWeight="SemiBold" Margin="0,6,0,0" Foreground="{DynamicResource Brush.Text}" />
                  <TextBlock Text="USB and display" Style="{StaticResource Text.Caption}" />
                </StackPanel>
              </c:SquircleBorder>
            </c:AdaptiveGrid>
          </c:AdaptiveGrid>
        </Grid>
      </c:SquircleBorder>

      <!-- Search: answers as you type (the best matches drop down under it) and filters the cards below. Clicking outside
           the box, or Esc, leaves it (TextBoxFocus); Ctrl+K or Ctrl+F jumps to it. -->
      <c:QuickSearch Margin="0,16,0,0" Width="440" HorizontalAlignment="Left" Placeholder="Search devices by name or type"
                     Hint="Start typing a device's name or type" Text="{Binding Search}" Suggestions="{Binding SearchSuggestions}" />

      <!-- ============================================================ -->
      <!-- Bluetooth devices                                            -->
      <!-- ============================================================ -->
      <StackPanel Margin="2,26,0,14">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Bluetooth devices" Style="{StaticResource Text.SectionTitle}" VerticalAlignment="Center" />
          <Border Style="{StaticResource Badge}" Margin="10,1,0,0">
            <TextBlock Text="{Binding PairedCount}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" />
          </Border>
        </StackPanel>
        <TextBlock Text="Paired with this PC. Connect or disconnect each one here." Style="{StaticResource Text.Secondary}" Margin="0,3,0,0" />
      </StackPanel>
      <TextBlock Text="Looking for devices…" Style="{StaticResource Text.Secondary}" Margin="2,0,0,8"
                 Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
      <ItemsControl ItemsSource="{Binding BluetoothDevices}" ItemTemplate="{StaticResource BluetoothCard}" Focusable="False">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <c:AdaptiveGrid MinColumnWidth="270" MaxColumnWidth="330" MaxColumns="12" Spacing="12" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
      <c:SquircleBorder Style="{StaticResource Card.Inset}" Padding="16,14" Visibility="{Binding HasBluetoothDevices, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
        <StackPanel Orientation="Horizontal">
          <Path Style="{StaticResource IconPath}" Width="16" Height="16" Data="{StaticResource Icon.Wireless}" Stroke="{DynamicResource Brush.TextTertiary}" />
          <TextBlock Text="{Binding BluetoothEmptyText}" Style="{StaticResource Text.Secondary}" Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
      </c:SquircleBorder>
      <TextBlock Style="{StaticResource Text.Caption}" Margin="2,10,0,0" TextWrapping="Wrap"
                 Text="Connect brings back headphones and speakers that moved to your phone or another PC. Keyboards, mice and controllers usually reconnect by themselves when you turn them on or press a button." />

      <!-- ============================================================ -->
      <!-- Wired devices                                                -->
      <!-- ============================================================ -->
      <StackPanel Margin="2,34,0,16">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Wired and USB devices" Style="{StaticResource Text.SectionTitle}" VerticalAlignment="Center" />
          <Border Style="{StaticResource Badge}" Margin="10,1,0,0">
            <TextBlock Text="{Binding WiredCount}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" />
          </Border>
        </StackPanel>
        <TextBlock Text="Plugged in by USB, display cable or Thunderbolt, grouped by type." Style="{StaticResource Text.Secondary}" Margin="0,3,0,0" />
      </StackPanel>
      <!-- Same column widths and gaps as the Bluetooth cards, so the two sections line up; each group stacks under the
           shortest column. -->
      <ItemsControl ItemsSource="{Binding WiredGroups}" ItemTemplate="{StaticResource WiredGroup}" Focusable="False">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <c:StackedColumns MinColumnWidth="270" MaxColumnWidth="330" MaxColumns="12" Spacing="12" RowSpacing="22" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
      <c:SquircleBorder Style="{StaticResource Card.Inset}" Padding="16,14" Visibility="{Binding HasWiredDevices, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
        <StackPanel Orientation="Horizontal">
          <Path Style="{StaticResource IconPath}" Width="16" Height="16" Data="{StaticResource Icon.Plug}" Stroke="{DynamicResource Brush.TextTertiary}" />
          <TextBlock Text="{Binding WiredEmptyText}" Style="{StaticResource Text.Secondary}" Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
      </c:SquircleBorder>
    </StackPanel>
  </ScrollViewer>
</UserControl>
