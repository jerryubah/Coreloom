<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Coreloom.App.Controls"
                    xmlns:interop="clr-namespace:Coreloom.App.Interop"
                    xmlns:b="clr-namespace:Coreloom.App.Behaviors">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Icons.xaml" />
    <ResourceDictionary Source="Converters.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- ================================================================================= -->
  <!-- Typography                                                                          -->
  <!-- ================================================================================= -->
  <!-- Inter for the interface, JetBrains Mono for measured values. Both ship with the app (Fonts/, SIL OFL 1.1).
       WPF resolves the weights (Regular/Medium/SemiBold/Bold) from the embedded files; if a file is ever missing
       it silently falls back to the system UI font instead of failing. -->
  <FontFamily x:Key="UiFont">pack://application:,,,/Fonts/#Inter</FontFamily>
  <FontFamily x:Key="MonoFont">pack://application:,,,/Fonts/#JetBrains Mono</FontFamily>

  <!-- Technical/numeric text: monospaced so columns of readings line up and digits don't jitter. -->
  <Style x:Key="Text.Mono" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>

  <!-- Large text is laid out in Ideal mode (true glyph shapes and spacing); Display mode, used for everything else, snaps
       small text to the pixel grid for crispness but distorts big glyphs. -->
  <Style x:Key="Text.PageTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="27" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style x:Key="Text.Section" TargetType="TextBlock">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>

  <!-- A heading over a group of cards on a page (one level above the cards' own titles). -->
  <Style x:Key="Text.SectionTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>

  <Style x:Key="Text.CardTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style x:Key="Text.Body" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="Text.Secondary" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style x:Key="Text.Caption" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style x:Key="Text.Label" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <!-- A card's headline number: big, bold Inter with tabular digits (they keep their width as the value counts). -->
  <Style x:Key="Text.ValueLarge" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="32" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="LineHeight" Value="38" />
  </Style>

  <Style x:Key="Text.Value" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="21" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
  </Style>

  <Style x:Key="Text.ValueSmall" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
  </Style>

  <Style x:Key="Text.Unit" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="Margin" Value="4,0,0,0" />
  </Style>

  <!-- ================================================================================= -->
  <!-- Icons                                                                              -->
  <!-- ================================================================================= -->
  <SolidColorBrush x:Key="FallbackIconBrush" Color="#9297A3" />
  <Style x:Key="IconPath" TargetType="Path">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}, FallbackValue={StaticResource FallbackIconBrush}}" />
    <Setter Property="StrokeThickness" Value="1.7" />
    <Setter Property="StrokeLineJoin" Value="Round" />
    <Setter Property="StrokeStartLineCap" Value="Round" />
    <Setter Property="StrokeEndLineCap" Value="Round" />
    <Setter Property="SnapsToDevicePixels" Value="False" />
  </Style>

  <!-- ================================================================================= -->
  <!-- Cards and surfaces                                                                 -->
  <!-- ================================================================================= -->
  <!-- Cards are c:SquircleBorder (smooth "squircle" corners, the same everywhere); the styles target Border so they also
       fit a plain Border. A card's top rim catches a little light (Sheen), like the edge of a pane of glass. -->
  <!-- Cards: the same frosted glass as the sidebar (since 1.8.2): the window's background blurred behind them, a faint
       fill, a bevelled rim and a top rim that catches the light. -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled" />
    <Setter Property="Background" Value="{DynamicResource Brush.GlassFill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.GlassRim}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Padding" Value="18,16" />
    <Setter Property="c:SquircleBorder.Sheen" Value="0.6" />
    <Setter Property="c:SquircleBorder.Frosted" Value="True" />
  </Style>

  <!-- A card with data that glows in its own color (set GlowKey), lit from below, its rim lighting up under the pointer. -->
  <Style x:Key="Card.Glow" TargetType="c:SquircleBorder" BasedOn="{StaticResource Card}">
    <Setter Property="EdgeGlow" Value="True" />
  </Style>

  <!-- A page's hero card: a stronger glow (GlowKey Accent unless set). -->
  <Style x:Key="Card.Hero" TargetType="c:SquircleBorder" BasedOn="{StaticResource Card.Glow}">
    <Setter Property="GlowKey" Value="Accent" />
    <Setter Property="GlowStrength" Value="1.5" />
    <Setter Property="Sheen" Value="0.8" />
  </Style>

  <Style x:Key="Card.Inset" TargetType="Border">
    <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="12,10" />
  </Style>

  <Style x:Key="Divider" TargetType="Border">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Brush.Divider}" />
    <Setter Property="Margin" Value="0,12" />
  </Style>

  <Style x:Key="Badge" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.ControlHover}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- ================================================================================= -->
  <!-- Buttons                                                                            -->
  <!-- ================================================================================= -->
  <Style x:Key="FocusVisual">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <c:SquircleBorder Margin="-2" CornerRadius="12" BorderThickness="2" BorderBrush="{DynamicResource Brush.Accent}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The base of every button: no fill until hovered. Icon buttons keep it; text buttons are glass (below). -->
  <Style x:Key="Button.Plain" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <c:SquircleBorder x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
          </c:SquircleBorder>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.ControlHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.ControlPressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A link-like button: accent text, dimmed a little on hover. -->
  <Style x:Key="Button.Link" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
            <ContentPresenter RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Opacity" Value="0.8" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The glass button (the banners' since 1.8.3, every text button's in 1.8.4): charcoal glass with white text, its rim
       lit along the top and toward a soft light of the accent in its lower right corner, which grows on hover. The
       banners' AccentGradient, Secondary and Subtle are this button; since 1.8.5 Primary is the accent-filled button
       again, so an action such as Connect doesn't look secondary. -->
  <Style x:Key="Button.Glass" TargetType="Button" BasedOn="{StaticResource Button.Plain}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.OnGlow}" />
    <Setter Property="Background" Value="{DynamicResource Brush.GlowButtonFill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.GlowButtonRim}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <c:SquircleBorder x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                              CornerRadius="11" ClipContent="True">
              <Border x:Name="Light" Background="{DynamicResource Brush.GlowButtonLight}" Opacity="0.85" IsHitTestVisible="False" />
            </c:SquircleBorder>
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Light" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Light" Property="Opacity" Value="0.6" />
              <Setter Property="RenderTransform">
                <Setter.Value>
                  <ScaleTransform ScaleX="0.98" ScaleY="0.98" />
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Button.AccentGradient" TargetType="Button" BasedOn="{StaticResource Button.Glass}" />

  <!-- A card's main action (Connect, Play, Clean, Save…): filled with the accent, white text (back in 1.8.5). -->
  <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource Button.Plain}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <c:SquircleBorder x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
          </c:SquircleBorder>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.AccentHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="Opacity" Value="0.85" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Button.Secondary" TargetType="Button" BasedOn="{StaticResource Button.Glass}">
    <Setter Property="FontWeight" Value="Normal" />
  </Style>

  <Style x:Key="Button.Subtle" TargetType="Button" BasedOn="{StaticResource Button.Glass}">
    <Setter Property="FontWeight" Value="Normal" />
  </Style>

  <!-- The banners' grain (assets/textures/grain.png, tiled), laid a few percent strong over their light so it doesn't band. -->
  <ImageBrush x:Key="GrainTexture" ImageSource="pack://application:,,,/Coreloom;component/Assets/grain.png" TileMode="Tile" Stretch="None"
              AlignmentX="Left" AlignmentY="Top" ViewportUnits="Absolute" Viewport="0,0,160,160" />

  <Style x:Key="Button.Icon" TargetType="Button" BasedOn="{StaticResource Button.Plain}">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
  </Style>

  <Style x:Key="ToggleButton.Icon" TargetType="ToggleButton">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <c:SquircleBorder x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="10">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </c:SquircleBorder>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.ControlHover}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Window caption buttons (minimize / maximize / close). -->
  <Style x:Key="Button.Caption" TargetType="Button">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root" Background="{TemplateBinding Background}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.ControlHover}" />
            </Trigger>
            <Trigger Property="interop:CaptionButton.IsHovered" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.ControlHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.ControlPressed}" />
            </Trigger>
            <Trigger Property="interop:CaptionButton.IsPressed" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.ControlPressed}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Button.CaptionClose" TargetType="Button" BasedOn="{StaticResource Button.Caption}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root" Background="Transparent">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="#C42B1C" />
              <Setter Property="Foreground" Value="White" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="Background" Value="#B3261A" />
              <Setter Property="Foreground" Value="White" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================================= -->
  <!-- Toggle switch (CheckBox)                                                           -->
  <!-- ================================================================================= -->
  <!-- Liquid toggle: a pill track and a white pill knob. Pressing it turns the knob into a lens of clear glass that swells
       over the track (the track shows through it); letting go, it flows across with a springy overshoot and turns white
       again while the track floods with the accent. -->
  <Style x:Key="ToggleSwitch" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ContentPresenter VerticalAlignment="Center" Margin="0,0,16,0" />
            <Grid x:Name="Switch" Grid.Column="1" Width="46" Height="26" VerticalAlignment="Center">
              <!-- the track: off, then the accent fading in over it, then a sheen of light across the top -->
              <Border x:Name="TrackOff" CornerRadius="13" Background="{DynamicResource Brush.Track}"
                      BorderBrush="{DynamicResource Brush.InputBorder}" BorderThickness="1" />
              <Border x:Name="TrackOn" CornerRadius="13" Background="{DynamicResource Brush.Accent}" Opacity="0" />
              <Border CornerRadius="13" IsHitTestVisible="False">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#2EFFFFFF" Offset="0" />
                    <GradientStop Color="#00FFFFFF" Offset="0.55" />
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
              <!-- the knob -->
              <Grid x:Name="Knob" Width="28" Height="22" HorizontalAlignment="Left" Margin="2,0,0,0" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                  <TransformGroup>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                    <TranslateTransform X="0" />
                  </TransformGroup>
                </Grid.RenderTransform>
                <!-- a soft shadow under the white knob -->
                <Border x:Name="KnobShadow" CornerRadius="12" Margin="-1,0,-1,-2" Background="#30000000" />
                <!-- the glass lens: a faint fill, bright at the top-left rim, catching light at the bottom-right -->
                <Border x:Name="KnobGlass" CornerRadius="11" Opacity="0" BorderThickness="1.2">
                  <Border.Background>
                    <RadialGradientBrush GradientOrigin="0.3,0.25" Center="0.5,0.5" RadiusX="0.75" RadiusY="0.75">
                      <GradientStop Color="#33FFFFFF" Offset="0" />
                      <GradientStop Color="#0AFFFFFF" Offset="0.7" />
                      <GradientStop Color="#1AFFFFFF" Offset="1" />
                    </RadialGradientBrush>
                  </Border.Background>
                  <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                      <GradientStop Color="#E6FFFFFF" Offset="0" />
                      <GradientStop Color="#30FFFFFF" Offset="0.45" />
                      <GradientStop Color="#99FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                  </Border.BorderBrush>
                </Border>
                <!-- the white cover that melts away while pressed -->
                <Border x:Name="KnobCover" CornerRadius="11" Background="#FFFFFFFF" />
              </Grid>
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)" To="14" Duration="0:0:0.55">
                      <DoubleAnimation.EasingFunction>
                        <ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="5" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.22" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)" To="0" Duration="0:0:0.55">
                      <DoubleAnimation.EasingFunction>
                        <ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="5" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <!-- pressed: the knob swells into a glass lens (wider than tall, like a drop pressed flat) -->
            <Trigger Property="IsPressed" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1.5" Duration="0:0:0.18">
                      <DoubleAnimation.EasingFunction>
                        <BackEase EasingMode="EaseOut" Amplitude="0.5" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1.4" Duration="0:0:0.18">
                      <DoubleAnimation.EasingFunction>
                        <BackEase EasingMode="EaseOut" Amplitude="0.5" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="KnobCover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                    <DoubleAnimation Storyboard.TargetName="KnobShadow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                    <DoubleAnimation Storyboard.TargetName="KnobGlass" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)">
                      <SplineDoubleKeyFrame KeyTime="0:0:0.16" Value="1.18" KeySpline="0.2,0,0.4,1" />
                      <SplineDoubleKeyFrame KeyTime="0:0:0.42" Value="1" KeySpline="0.3,0,0.2,1" />
                    </DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)">
                      <SplineDoubleKeyFrame KeyTime="0:0:0.16" Value="0.92" KeySpline="0.2,0,0.4,1" />
                      <SplineDoubleKeyFrame KeyTime="0:0:0.42" Value="1" KeySpline="0.3,0,0.2,1" />
                    </DoubleAnimationUsingKeyFrames>
                    <DoubleAnimation Storyboard.TargetName="KnobCover" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.12" Duration="0:0:0.24" />
                    <DoubleAnimation Storyboard.TargetName="KnobShadow" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.12" Duration="0:0:0.24" />
                    <DoubleAnimation Storyboard.TargetName="KnobGlass" Storyboard.TargetProperty="Opacity" To="0" BeginTime="0:0:0.12" Duration="0:0:0.24" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="TrackOff" Property="Background" Value="{DynamicResource Brush.InputHover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Compact check box (Performance History metric picker). -->
  <Style x:Key="CheckBox.Compact" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Border x:Name="Row" Background="Transparent" CornerRadius="6" Padding="6,5">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border x:Name="Box" Width="16" Height="16" CornerRadius="4" BorderThickness="1.5"
                      BorderBrush="{DynamicResource Brush.TextTertiary}" Background="Transparent" VerticalAlignment="Center">
                <Path x:Name="Mark" Data="M3.5,8.5 L6.5,11.5 12.5,4.5" Stroke="{DynamicResource Brush.OnAccent}" StrokeThickness="1.8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" />
              </Border>
              <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.Accent}" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
              <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.ControlHover}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================================= -->
  <!-- Text box                                                                           -->
  <!-- ================================================================================= -->
  <Style x:Key="TextBox.Default" TargetType="TextBox">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Input}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.InputBorder}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <c:SquircleBorder x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="False"
                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
          </c:SquircleBorder>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.InputHover}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================================= -->
  <!-- Quick search (c:QuickSearch)                                                       -->
  <!-- ================================================================================= -->
  <!-- A text box with no chrome of its own (the search field draws the box). -->
  <Style x:Key="TextBox.Bare" TargetType="TextBox">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CaretBrush" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center"
                        HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A row in the panel under a search box. -->
  <Style x:Key="QuickSearchItem" TargetType="ListBoxItem">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <c:SquircleBorder x:Name="Row" Background="Transparent" CornerRadius="10" Padding="8,7" Margin="0,1">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <c:SquircleBorder x:Name="Tile" Width="30" Height="30" CornerRadius="9" Background="{DynamicResource Brush.ControlHover}" VerticalAlignment="Center">
                <Path x:Name="Glyph" Style="{StaticResource IconPath}" Width="14" Height="14" Stroke="{DynamicResource Brush.TextSecondary}"
                      Data="{Binding IconKey, Converter={StaticResource IconKeyToGeometry}}" />
              </c:SquircleBorder>
              <StackPanel Grid.Column="1" Margin="11,0,8,0" VerticalAlignment="Center">
                <TextBlock x:Name="Title" Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Detail}" FontSize="11.5" Foreground="{DynamicResource Brush.TextTertiary}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"
                           Visibility="{Binding Detail, Converter={StaticResource HasValueToVisibility}}" />
              </StackPanel>
              <!-- Enter picks the highlighted row -->
              <c:SquircleBorder x:Name="Enter" Grid.Column="2" CornerRadius="5" Padding="6,2" Background="{DynamicResource Brush.ControlHover}" VerticalAlignment="Center" Opacity="0">
                <TextBlock Text="↵" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" />
              </c:SquircleBorder>
            </Grid>
          </c:SquircleBorder>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding Kind}" Value="Filter">
              <Setter TargetName="Tile" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
              <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource Brush.Accent}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Hint">
              <Setter Property="Cursor" Value="Arrow" />
              <Setter TargetName="Title" Property="FontWeight" Value="Medium" />
              <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Empty">
              <Setter Property="Cursor" Value="Arrow" />
              <Setter TargetName="Title" Property="FontWeight" Value="Medium" />
              <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            </DataTrigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.ControlHover}" />
              <Setter TargetName="Enter" Property="Opacity" Value="1" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The search field: icon, text, a clear button, and the panel that drops down from it (Ctrl+K or Ctrl+F jump here). -->
  <Style TargetType="c:QuickSearch">
    <Setter Property="Height" Value="38" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="c:QuickSearch">
          <Grid>
            <!-- a soft focus ring outside the field -->
            <c:SquircleBorder x:Name="Ring" Margin="-3" CornerRadius="15" BorderThickness="3" BorderBrush="{DynamicResource Brush.AccentSoft}" Opacity="0" IsHitTestVisible="False" />
            <c:SquircleBorder x:Name="Field" CornerRadius="12" Background="{DynamicResource Brush.Input}" BorderBrush="{DynamicResource Brush.InputBorder}" BorderThickness="1">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Path x:Name="Glass" Style="{StaticResource IconPath}" Width="14" Height="14" Margin="13,0,0,0" Data="{StaticResource Icon.Search}"
                      Stroke="{DynamicResource Brush.TextTertiary}" IsHitTestVisible="False" />
                <TextBox x:Name="PART_TextBox" Grid.Column="1" Style="{StaticResource TextBox.Bare}" Margin="9,0,4,0"
                         Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{TemplateBinding Placeholder}" />
                <!-- the hint hides once the box is clicked, so the caret is plainly where typing starts -->
                <TextBlock x:Name="Placeholder" Grid.Column="1" Margin="11,0,4,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           Text="{TemplateBinding Placeholder}" Foreground="{DynamicResource Brush.TextTertiary}" TextTrimming="CharacterEllipsis" />
                <Button x:Name="ClearButton" Grid.Column="2" Style="{StaticResource Button.Icon}" Width="26" Height="26" Margin="0,0,5,0" Visibility="Collapsed"
                        Command="{x:Static c:QuickSearch.ClearCommand}" ToolTip="Clear" AutomationProperties.Name="Clear search">
                  <Path Style="{StaticResource IconPath}" Width="10" Height="10" Data="{StaticResource Icon.Close}" />
                </Button>
              </Grid>
            </c:SquircleBorder>

            <!-- centered under the field (the panel's margin only leaves room for its shadow) and kept attached to it -->
            <Popup x:Name="PART_Popup" PlacementTarget="{Binding ElementName=Field}" b:PopupAnchor.Align="Center" b:PopupAnchor.Gap="6"
                   AllowsTransparency="True" Focusable="False" StaysOpen="True"
                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
              <c:SquircleBorder x:Name="PART_Panel" Margin="12,10,12,16" Width="{Binding ActualWidth, ElementName=Field}" CornerRadius="16" Padding="6"
                                Background="{DynamicResource Brush.Tooltip}" BorderBrush="{DynamicResource Brush.TooltipBorder}" BorderThickness="1" Shadow="1" Sheen="0.6"
                                TextOptions.TextFormattingMode="Display">
                <ListBox x:Name="PART_List" Focusable="False" Background="Transparent" BorderThickness="0" MaxHeight="380"
                         ItemContainerStyle="{StaticResource QuickSearchItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="False">
                  <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                      <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" b:SmoothScroll.IsEnabled="True">
                        <ItemsPresenter />
                      </ScrollViewer>
                    </ControlTemplate>
                  </ListBox.Template>
                </ListBox>
              </c:SquircleBorder>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="HasText" Value="True">
              <Setter TargetName="Placeholder" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="ClearButton" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger SourceName="PART_TextBox" Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Placeholder" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
              <Setter TargetName="Ring" Property="Opacity" Value="1" />
              <Setter TargetName="Glass" Property="Stroke" Value="{DynamicResource Brush.Accent}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Field" Property="Background" Value="{DynamicResource Brush.InputHover}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================================= -->
  <!-- Scroll bars (thin, rounded)                                                        -->
  <!-- ================================================================================= -->
  <Style x:Key="ScrollThumb" TargetType="Thumb">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="Root" CornerRadius="4" Background="{DynamicResource Brush.TextTertiary}" Opacity="0.55" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Opacity" Value="0.85" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="Root" Property="Opacity" Value="1" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Width" Value="10" />
    <Setter Property="MinWidth" Value="10" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent" Margin="2">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageUpCommand" />
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource ScrollThumb}" />
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageDownCommand" />
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="10" />
        <Setter Property="MinHeight" Value="10" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Grid Background="Transparent" Margin="2">
                <Track x:Name="PART_Track" IsDirectionReversed="False">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageLeftCommand" />
                  </Track.DecreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollThumb}" />
                  </Track.Thumb>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageRightCommand" />
                  </Track.IncreaseRepeatButton>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Scrolling glides and eases into place (b:SmoothScroll) in every scroll area. -->
  <Style x:Key="ScrollViewer.Page" TargetType="ScrollViewer">
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="PanningMode" Value="VerticalOnly" />
    <Setter Property="b:SmoothScroll.IsEnabled" Value="True" />
  </Style>

  <!-- The thumb of a page's scroll bar: 8px, widening to 14px while the pointer is on the bar (b:ScrollBarHover).
       The whole width of the bar can be grabbed, not just the visible part. -->
  <Style x:Key="ScrollThumb.Window" TargetType="Thumb">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Grid Background="Transparent">
            <Border x:Name="Bar" Width="8" HorizontalAlignment="Right" Margin="0,0,3,0" CornerRadius="4"
                    Background="{DynamicResource Brush.TextTertiary}" Opacity="0.55" />
          </Grid>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding Path=(b:ScrollBarHover.IsExpanded), RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="True">
              <DataTrigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="Width" To="14" Duration="0:0:0.12" />
                  </Storyboard>
                </BeginStoryboard>
              </DataTrigger.EnterActions>
              <DataTrigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="Width" To="8" Duration="0:0:0.16" />
                  </Storyboard>
                </BeginStoryboard>
              </DataTrigger.ExitActions>
              <Setter TargetName="Bar" Property="Opacity" Value="0.75" />
              <Setter TargetName="Bar" Property="CornerRadius" Value="7" />
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bar" Property="Opacity" Value="0.9" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="Bar" Property="Opacity" Value="1" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A page's scroll bar at the right edge of the window. It is 24px wide but keeps its right 6px clear: that strip is the
       window's resize border, where the pointer turns into the resize arrow. -->
  <Style x:Key="ScrollBar.Window" TargetType="ScrollBar">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Width" Value="24" />
    <Setter Property="MinWidth" Value="24" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="b:ScrollBarHover.Enabled" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent" Margin="0,4,6,4">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageUpCommand" />
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource ScrollThumb.Window}" />
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageDownCommand" />
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A page that scrolls, at the right edge of the window. The content keeps the 10px beside the bar it always had; the
       wider bar sits over the page's right margin, so nothing moves. -->
  <Style x:Key="ScrollViewer.Window" TargetType="ScrollViewer" BasedOn="{StaticResource ScrollViewer.Page}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollViewer">
          <Grid Background="{TemplateBinding Background}">
            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Margin="0,0,10,0"
                                    CanContentScroll="{TemplateBinding CanContentScroll}" />
            <ScrollBar x:Name="PART_VerticalScrollBar" Style="{StaticResource ScrollBar.Window}" Orientation="Vertical"
                       HorizontalAlignment="Right" Cursor="Arrow" AutomationProperties.AutomationId="VerticalScrollBar"
                       Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                       Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================================= -->
  <!-- Slider (thin track, filled with the accent up to a round thumb)                    -->
  <!-- ================================================================================= -->
  <Style x:Key="SliderFill" TargetType="RepeatButton">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Grid Background="Transparent">
            <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SliderThumb" TargetType="Thumb">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Grid Width="18" Height="18" Background="Transparent">
            <Ellipse x:Name="Knob" Width="14" Height="14" Fill="{DynamicResource Brush.Text}" Stroke="{DynamicResource Brush.Accent}" StrokeThickness="3" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Knob" Property="Width" Value="16" />
              <Setter TargetName="Knob" Property="Height" Value="16" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="Knob" Property="Width" Value="16" />
              <Setter TargetName="Knob" Property="Height" Value="16" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Slider.Default" TargetType="Slider">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
    <Setter Property="IsMoveToPointEnabled" Value="True" />
    <Setter Property="IsSnapToTickEnabled" Value="True" />
    <Setter Property="TickFrequency" Value="1" />
    <Setter Property="SmallChange" Value="1" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid Background="Transparent" VerticalAlignment="Center">
            <Border Height="4" CornerRadius="2" Background="{DynamicResource Brush.Track}" Margin="2,0" />
            <Track x:Name="PART_Track">
              <Track.DecreaseRepeatButton>
                <RepeatButton Style="{StaticResource SliderFill}" Background="{DynamicResource Brush.Accent}" Command="Slider.DecreaseLarge" />
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource SliderThumb}" />
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Style="{StaticResource SliderFill}" Background="Transparent" Command="Slider.IncreaseLarge" />
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================================= -->
  <!-- Tool tip                                                                           -->
  <!-- ================================================================================= -->
  <Style TargetType="ToolTip">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Tooltip}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.TooltipBorder}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="MaxWidth" Value="360" />
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <c:SquircleBorder Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                  CornerRadius="10" Padding="10,7">
            <ContentPresenter>
              <ContentPresenter.Resources>
                <Style TargetType="TextBlock">
                  <Setter Property="TextWrapping" Value="Wrap" />
                </Style>
              </ContentPresenter.Resources>
            </ContentPresenter>
          </c:SquircleBorder>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================================= -->
  <!-- Progress bar (thin, rounded)                                                       -->
  <!-- ================================================================================= -->
  <Style x:Key="ProgressBar.Thin" TargetType="ProgressBar">
    <Setter Property="Height" Value="4" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Track}" />
    <Setter Property="Maximum" Value="100" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid x:Name="TemplateRoot">
            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2" />
            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2" HorizontalAlignment="Left" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================================= -->
  <!-- Combo box                                                                          -->
  <!-- ================================================================================= -->
  <Style x:Key="ComboToggle" TargetType="ToggleButton">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="ClickMode" Value="Press" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <c:SquircleBorder x:Name="Root" Background="{DynamicResource Brush.Input}" BorderBrush="{DynamicResource Brush.InputBorder}" BorderThickness="1" CornerRadius="10">
            <Path x:Name="Arrow" Data="M0,0 L4,4 8,0" Stroke="{DynamicResource Brush.TextSecondary}" StrokeThickness="1.5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
          </c:SquircleBorder>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.InputHover}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ComboBoxItem.Default" TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Root" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="4,1">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.ControlHover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ComboBox.Default" TargetType="ComboBox">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="MinWidth" Value="200" />
    <Setter Property="Height" Value="34" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource ComboBoxItem.Default}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="Toggle" Style="{StaticResource ComboToggle}"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Margin="12,0,32,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
            <Popup x:Name="PART_Popup" b:PopupAnchor.Align="Start" b:PopupAnchor.Gap="4" AllowsTransparency="True" Focusable="False"
                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
              <c:SquircleBorder MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                      Background="{DynamicResource Brush.Tooltip}" BorderBrush="{DynamicResource Brush.TooltipBorder}" BorderThickness="1" CornerRadius="14" Padding="0,4">
                <ScrollViewer SnapsToDevicePixels="True" b:SmoothScroll.IsEnabled="True">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                </ScrollViewer>
              </c:SquircleBorder>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================================= -->
  <!-- Segmented control (ListBox)                                                        -->
  <!-- ================================================================================= -->
  <Style x:Key="SegmentItem" TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <c:SquircleBorder x:Name="Root" Background="Transparent" CornerRadius="8" Padding="11,5" Margin="1">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </c:SquircleBorder>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Card}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Segmented" TargetType="ListBox">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource SegmentItem}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <c:SquircleBorder Background="{TemplateBinding Background}" CornerRadius="11" Padding="2">
            <ItemsPresenter />
          </c:SquircleBorder>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================================= -->
  <!-- Navigation (ListBox)                                                               -->
  <!-- ================================================================================= -->
  <Style x:Key="NavItem" TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Grid>
            <c:SquircleBorder x:Name="Root" Background="Transparent" CornerRadius="11" Height="38">
              <ContentPresenter VerticalAlignment="Center" />
            </c:SquircleBorder>
            <Border x:Name="Indicator" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" Margin="0,0,0,0"
                    Background="{DynamicResource Brush.Accent}" Opacity="0" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.ControlHover}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.NavSelected}" />
              <Setter TargetName="Indicator" Property="Opacity" Value="1" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="NavList" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource NavItem}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" b:SmoothScroll.IsEnabled="True">
            <ItemsPresenter />
          </ScrollViewer>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================================= -->
  <!-- Context menu (tray)                                                                -->
  <!-- ================================================================================= -->
  <Style TargetType="ContextMenu">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <c:SquircleBorder Background="{DynamicResource Brush.Tooltip}" BorderBrush="{DynamicResource Brush.TooltipBorder}" BorderThickness="1"
                  CornerRadius="14" Padding="4" MinWidth="210">
            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
          </c:SquircleBorder>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="Root" Background="Transparent" CornerRadius="6" Padding="12,7">
            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.ControlHover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Separator">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Height="1" Margin="8,4" Background="{DynamicResource Brush.Divider}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
