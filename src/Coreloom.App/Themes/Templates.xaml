<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Coreloom.App.Controls"
                    xmlns:b="clr-namespace:Coreloom.App.Behaviors"
                    xmlns:inf="clr-namespace:Coreloom.ViewModels.Infrastructure;assembly=Coreloom.ViewModels"
                    xmlns:pages="clr-namespace:Coreloom.ViewModels.Pages;assembly=Coreloom.ViewModels"
                    xmlns:overlay="clr-namespace:Coreloom.ViewModels.Overlay;assembly=Coreloom.ViewModels">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Icons.xaml" />
    <ResourceDictionary Source="Converters.xaml" />
    <ResourceDictionary Source="Controls.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- ================================================================================= -->
  <!-- Value with unit (animated number)                                                  -->
  <!-- ================================================================================= -->
  <DataTemplate x:Key="ValueLarge" DataType="{x:Type inf:MetricViewModel}">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
      <TextBlock Style="{StaticResource Text.ValueLarge}"
                 b:AnimatedText.Formatter="{Binding NumberFormatter}"
                 b:AnimatedText.Value="{Binding Value}" />
      <TextBlock Style="{StaticResource Text.Unit}" Text="{Binding Unit}" VerticalAlignment="Bottom" Margin="5,0,0,5" FontSize="14" />
    </StackPanel>
  </DataTemplate>

  <!-- ================================================================================= -->
  <!-- Metric tile (secondary metrics grid)                                               -->
  <!-- ================================================================================= -->
  <DataTemplate x:Key="MetricTile" DataType="{x:Type inf:MetricViewModel}">
    <c:SquircleBorder Style="{StaticResource Card.Inset}" ToolTip="{Binding ToolTip}" ToolTipService.InitialShowDelay="400" MinHeight="74">
      <StackPanel>
        <Grid>
          <TextBlock Style="{StaticResource Text.Label}" Text="{Binding Label}" Margin="0,0,24,0" />
          <Border Style="{StaticResource Badge}" HorizontalAlignment="Right" Padding="5,0"
                  Visibility="{Binding IsDerived, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="derived" FontSize="10" Foreground="{DynamicResource Brush.TextSecondary}" />
          </Border>
        </Grid>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
          <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="18" FontWeight="SemiBold"
                     b:AnimatedText.Formatter="{Binding NumberFormatter}"
                     b:AnimatedText.Value="{Binding Value}">
            <TextBlock.Foreground>
              <MultiBinding Converter="{StaticResource LevelToBrush}" ConverterParameter="Text">
                <Binding Path="Level" />
                <Binding Path="ColorKey" />
              </MultiBinding>
            </TextBlock.Foreground>
          </TextBlock>
          <TextBlock Style="{StaticResource Text.Unit}" Text="{Binding Unit}" VerticalAlignment="Bottom" Margin="4,0,0,2" />
        </StackPanel>
        <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Detail}" Margin="0,2,0,0"
                   Visibility="{Binding Detail, Converter={StaticResource HasValueToVisibility}}" />
        <TextBlock Style="{StaticResource Text.Caption}" Text="Unavailable" Margin="0,2,0,0"
                   Visibility="{Binding HasValue, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
      </StackPanel>
    </c:SquircleBorder>
  </DataTemplate>

  <!-- ================================================================================= -->
  <!-- Gauge card (page heroes)                                                           -->
  <!-- ================================================================================= -->
  <DataTemplate x:Key="GaugeCard" DataType="{x:Type inf:MetricViewModel}">
    <c:SquircleBorder Style="{StaticResource Card.Glow}" GlowKey="{Binding GlowKey}" ToolTip="{Binding ToolTip}" ToolTipService.InitialShowDelay="400">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Style="{StaticResource Text.Label}" Text="{Binding Label}" />
          <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ValueLarge}" Margin="0,6,0,0" HorizontalAlignment="Left" />
          <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Detail}" Margin="0,4,0,0"
                     Visibility="{Binding Detail, Converter={StaticResource HasValueToVisibility}}" />
          <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding StatsText}" Margin="0,2,0,0"
                     Visibility="{Binding StatsText, Converter={StaticResource HasValueToVisibility}}" />
        </StackPanel>
        <c:RadialGauge Grid.Column="1" Width="80" Height="80" Thickness="10" Orb="True" Margin="12,0,0,0" VerticalAlignment="Center"
                       Value="{Binding Fraction}" TrackBrush="{DynamicResource Brush.Track}"
                       ToneScale="True" TemperatureScale="{Binding IsTemperature}" CoolAt="{Binding GaugeCoolAt}" WarmAt="{Binding GaugeWarmAt}" HotAt="{Binding GaugeHotAt}"
                       IsUnavailable="{Binding HasValue, Converter={StaticResource InverseBool}}" />
      </Grid>
    </c:SquircleBorder>
  </DataTemplate>

  <!-- ================================================================================= -->
  <!-- Overview summary card                                                              -->
  <!-- ================================================================================= -->
  <!-- A card made taller on the dashboard gives the extra height to its sparkline. -->
  <DataTemplate x:Key="SummaryCard" DataType="{x:Type pages:SummaryCardViewModel}">
    <c:SquircleBorder Style="{StaticResource Card.Glow}" GlowKey="{Binding Metric.GlowKey}" Padding="18,16,18,14" ToolTip="{Binding Metric.ToolTip}" ToolTipService.InitialShowDelay="500">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- Header -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Width="26" Height="26" CornerRadius="8" Background="{DynamicResource Brush.ControlHover}">
            <Path Style="{StaticResource IconPath}" Width="14" Height="14" StrokeThickness="1.6"
                  Data="{Binding IconKey, Converter={StaticResource IconKeyToGeometry}}"
                  Stroke="{Binding Metric.GlowKey, Converter={StaticResource ColorKeyToBrush}}" />
          </Border>
          <TextBlock Grid.Column="1" Style="{StaticResource Text.CardTitle}" Text="{Binding Title}" VerticalAlignment="Center" Margin="10,0,0,0" />
          <Border Grid.Column="2" Style="{StaticResource Badge}" Visibility="{Binding Metric.IsDerived, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="derived" FontSize="10" Foreground="{DynamicResource Brush.TextSecondary}" />
          </Border>
        </Grid>

        <!-- Value + gauge -->
        <Grid Grid.Row="1" Margin="0,14,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Text.ValueLarge}"
                         b:AnimatedText.Formatter="{Binding Metric.NumberFormatter}"
                         b:AnimatedText.Value="{Binding Metric.Value}">
                <TextBlock.Foreground>
                  <MultiBinding Converter="{StaticResource LevelToBrush}" ConverterParameter="Text">
                    <Binding Path="Metric.Level" />
                    <Binding Path="Metric.ColorKey" />
                  </MultiBinding>
                </TextBlock.Foreground>
              </TextBlock>
              <TextBlock Style="{StaticResource Text.Unit}" Text="{Binding Metric.Unit}" VerticalAlignment="Bottom" Margin="5,0,0,5" FontSize="14" />
            </StackPanel>
            <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Metric.Detail}" Margin="0,4,0,0" TextWrapping="NoWrap"
                       Visibility="{Binding Metric.Detail, Converter={StaticResource HasValueToVisibility}}" />
          </StackPanel>
          <c:RadialGauge Grid.Column="1" Width="60" Height="60" Thickness="8" Margin="10,0,0,0"
                         Value="{Binding Metric.Fraction}" TrackBrush="{DynamicResource Brush.Track}"
                         ToneScale="True" TemperatureScale="{Binding Metric.IsTemperature}" CoolAt="{Binding Metric.GaugeCoolAt}" WarmAt="{Binding Metric.GaugeWarmAt}" HotAt="{Binding Metric.GaugeHotAt}"
                         IsUnavailable="{Binding Metric.HasValue, Converter={StaticResource InverseBool}}" />
        </Grid>

        <!-- Sparkline -->
        <c:Sparkline Grid.Row="2" MinHeight="34" Margin="-2,12,-2,0"
                     MetricId="{Binding Metric.MetricId}" ColorKey="{Binding Metric.GlowKey}"
                     Timeline="{Binding DataContext.Timeline, RelativeSource={RelativeSource AncestorType=UserControl}}" />

        <!-- Stats -->
        <TextBlock Grid.Row="3" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" Text="{Binding Metric.StatsText}"
                   Visibility="{Binding DataContext.ShowStatisticsOnCards, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
      </Grid>
    </c:SquircleBorder>
  </DataTemplate>

  <!-- ================================================================================= -->
  <!-- Chart legend                                                                       -->
  <!-- ================================================================================= -->
  <Style x:Key="LegendToggle" TargetType="CheckBox">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Border x:Name="Root" Background="Transparent" CornerRadius="6" Padding="6,3">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.ControlHover}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <DataTemplate x:Key="LegendItem" DataType="{x:Type inf:ChartSeriesViewModel}">
    <CheckBox Style="{StaticResource LegendToggle}" IsChecked="{Binding IsVisible}" ToolTip="Show or hide this series">
      <StackPanel Orientation="Horizontal">
        <Ellipse Width="8" Height="8" Fill="{Binding ColorKey, Converter={StaticResource ColorKeyToBrush}}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Label}" Margin="6,0,0,0" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding CurrentText}" Margin="6,0,0,0" FontFamily="{StaticResource MonoFont}" FontSize="11.5" FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" />
      </StackPanel>
    </CheckBox>
  </DataTemplate>

  <!-- ================================================================================= -->
  <!-- Chart card                                                                         -->
  <!-- ================================================================================= -->
  <DataTemplate x:Key="ChartCard" DataType="{x:Type inf:ChartViewModel}">
    <c:SquircleBorder Style="{StaticResource Card}" Padding="18,14,14,10">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Style="{StaticResource Text.CardTitle}" Text="{Binding Title}" VerticalAlignment="Center" Margin="0,0,12,0" />
          <ItemsControl Grid.Column="1" ItemsSource="{Binding Series}" ItemTemplate="{StaticResource LegendItem}" HorizontalAlignment="Right" Focusable="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </Grid>
        <c:LiveLineChart Grid.Row="1" MinHeight="170" Chart="{Binding}"
                         Timeline="{Binding DataContext.Timeline, RelativeSource={RelativeSource AncestorType=UserControl}}" />
      </Grid>
    </c:SquircleBorder>
  </DataTemplate>

  <!-- ================================================================================= -->
  <!-- Specification list                                                                 -->
  <!-- ================================================================================= -->
  <DataTemplate x:Key="KeyValueRow" DataType="{x:Type inf:KeyValueItem}">
    <Grid Margin="0,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" SharedSizeGroup="SpecKey" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding Key}" Margin="0,0,24,0" />
      <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12.5" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" TextAlignment="Right" />
    </Grid>
  </DataTemplate>

  <!-- ================================================================================= -->
  <!-- Sensor table                                                                       -->
  <!-- ================================================================================= -->
  <DataTemplate x:Key="SensorRow" DataType="{x:Type inf:SensorRowViewModel}">
    <Border x:Name="Row" Background="Transparent" CornerRadius="6" Padding="8,5" ToolTip="{Binding ToolTip}" ToolTipService.InitialShowDelay="600">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="120" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding Device}" FontSize="11.5" Foreground="{DynamicResource Brush.TextTertiary}" Margin="8,0,0,0"
                     TextTrimming="CharacterEllipsis" Visibility="{Binding Descriptor.IsRaw, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
        <Border Grid.Column="1" Style="{StaticResource Badge}" Margin="8,0" Visibility="{Binding IsDerived, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="derived" FontSize="10" Foreground="{DynamicResource Brush.TextSecondary}" />
        </Border>
        <TextBlock Grid.Column="2" Text="{Binding Value}" FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush.Text}" TextAlignment="Right" />
        <TextBlock Grid.Column="3" Text="{Binding Source}" FontSize="11" Foreground="{DynamicResource Brush.TextTertiary}" Width="132"
                   TextAlignment="Right" TextTrimming="CharacterEllipsis" Margin="12,0,0,0" />
      </Grid>
    </Border>
    <DataTemplate.Triggers>
      <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
        <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.ControlHover}" />
      </Trigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <DataTemplate x:Key="SensorGroup" DataType="{x:Type inf:SensorGroupViewModel}">
    <StackPanel Margin="0,0,0,10">
      <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Label}" Margin="8,6,0,4" />
      <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource SensorRow}" Focusable="False" />
    </StackPanel>
  </DataTemplate>

  <!-- One card's worth of sensors (all groups in one column). -->
  <DataTemplate x:Key="SensorTable" DataType="{x:Type inf:SensorTableViewModel}">
    <StackPanel>
      <TextBlock Style="{StaticResource Text.Secondary}" Text="No sensors reported." Margin="8,4"
                 Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
      <ItemsControl ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource SensorGroup}" Focusable="False" />
    </StackPanel>
  </DataTemplate>

  <!-- A long sensor list as two cards side by side (stacked in narrow windows). Each card is only as tall as its own
       content, and the groups are balanced between the two (see SensorColumns). -->
  <DataTemplate x:Key="SensorColumns" DataType="{x:Type inf:SensorTableViewModel}">
    <Grid>
      <c:SquircleBorder Style="{StaticResource Card}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Style="{StaticResource Text.Secondary}" Text="No sensors reported." />
      </c:SquircleBorder>
      <c:AdaptiveGrid MinColumnWidth="460" MaxColumns="2" Spacing="16"
                      Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
        <c:SquircleBorder Style="{StaticResource Card}" VerticalAlignment="Top" Padding="10,8,10,2">
          <ItemsControl ItemsSource="{Binding FirstColumn}" ItemTemplate="{StaticResource SensorGroup}" Focusable="False" />
        </c:SquircleBorder>
        <c:SquircleBorder Style="{StaticResource Card}" VerticalAlignment="Top" Padding="10,8,10,2"
                Visibility="{Binding HasSecondColumn, Converter={StaticResource BoolToVisibility}}">
          <ItemsControl ItemsSource="{Binding SecondColumn}" ItemTemplate="{StaticResource SensorGroup}" Focusable="False" />
        </c:SquircleBorder>
      </c:AdaptiveGrid>
    </Grid>
  </DataTemplate>

  <!-- ================================================================================= -->
  <!-- Process list                                                                       -->
  <!-- ================================================================================= -->
  <DataTemplate x:Key="ProcessList" DataType="{x:Type inf:ProcessListViewModel}">
    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type inf:ProcessRowViewModel}">
          <Grid Margin="0,5" Visibility="{Binding Name, Converter={StaticResource HasValueToVisibility}}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1" Text="{Binding Secondary}" FontSize="11.5" Foreground="{DynamicResource Brush.TextTertiary}" Margin="12,0" />
            <TextBlock Grid.Column="2" Text="{Binding Primary}" FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Text}" MinWidth="64" TextAlignment="Right" />
            <ProgressBar Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource ProgressBar.Thin}" Height="3" Margin="0,5,0,0"
                         Value="{Binding Fraction, Mode=OneWay, Converter={StaticResource FractionToPercent}}" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </DataTemplate>

  <!-- ================================================================================= -->
  <!-- Donut legend row                                                                   -->
  <!-- ================================================================================= -->
  <DataTemplate x:Key="DonutLegendRow" DataType="{x:Type inf:DonutSegmentViewModel}">
    <Grid Margin="0,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Ellipse Width="9" Height="9" Fill="{Binding ColorKey, Converter={StaticResource ColorKeyToBrush}}" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" Text="{Binding Label}" Margin="8,0,12,0" Style="{StaticResource Text.Secondary}" />
      <TextBlock Grid.Column="2" Text="{Binding ValueText}" FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
    </Grid>
  </DataTemplate>

  <!-- ================================================================================= -->
  <!-- Volume (storage)                                                                   -->
  <!-- ================================================================================= -->
  <DataTemplate x:Key="VolumeRow" DataType="{x:Type pages:VolumeViewModel}">
    <Grid Margin="0,6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid Width="54" Height="54">
        <c:DonutChart Segments="{Binding Segments}" Thickness="6" GapDegrees="4" />
        <TextBlock Text="{Binding Letter}" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{DynamicResource Brush.Text}" />
      </Grid>
      <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
        <Grid>
          <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis" Margin="0,0,48,0" />
          <TextBlock Text="{Binding PercentText}" FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" HorizontalAlignment="Right" />
        </Grid>
        <ProgressBar Style="{StaticResource ProgressBar.Thin}" Margin="0,6,0,0" Foreground="{Binding Used.ColorKey, Converter={StaticResource ColorKeyToBrush}}"
                     Value="{Binding Fraction, Mode=OneWay, Converter={StaticResource FractionToPercent}}" />
        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,5,0,0">
          <Run Text="{Binding UsedText, Mode=OneWay}" /><Run Text=" used · " /><Run Text="{Binding FreeText, Mode=OneWay}" /><Run Text=" free of " /><Run Text="{Binding CapacityText, Mode=OneWay}" />
        </TextBlock>
      </StackPanel>
    </Grid>
  </DataTemplate>
  <!-- ================================================================================= -->
  <!-- Health (Graphics and Processor pages, and the Overview's health card)              -->
  <!-- ================================================================================= -->

  <!-- One check: an icon by state, the title and its detail underneath. -->
  <DataTemplate x:Key="HealthCheckRow" DataType="{x:Type pages:HealthCheckViewModel}">
    <Grid Background="Transparent" ToolTip="{Binding Detail}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Path x:Name="Icon" Style="{StaticResource IconPath}" Width="15" Height="15" VerticalAlignment="Top" Margin="0,1,9,0"
            Data="{StaticResource Icon.Check}" Stroke="{DynamicResource Brush.Success}" />
      <StackPanel Grid.Column="1">
        <TextBlock Text="{Binding Title}" FontSize="13" Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
      </StackPanel>
    </Grid>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding StateKey}" Value="Notice">
        <Setter TargetName="Icon" Property="Data" Value="{StaticResource Icon.Info}" />
        <Setter TargetName="Icon" Property="Stroke" Value="{DynamicResource Brush.Elevated}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding StateKey}" Value="Problem">
        <Setter TargetName="Icon" Property="Data" Value="{StaticResource Icon.Warning}" />
        <Setter TargetName="Icon" Property="Stroke" Value="{DynamicResource Brush.Critical}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding StateKey}" Value="Unknown">
        <Setter TargetName="Icon" Property="Data" Value="{StaticResource Icon.Info}" />
        <Setter TargetName="Icon" Property="Stroke" Value="{DynamicResource Brush.TextTertiary}" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- A check on one line (the Overview's health card is short). -->
  <DataTemplate x:Key="HealthCheckLine" DataType="{x:Type pages:HealthCheckViewModel}">
    <Grid Background="Transparent" Margin="0,2" ToolTip="{Binding Detail}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Path x:Name="Icon" Style="{StaticResource IconPath}" Width="13" Height="13" Margin="0,0,7,0" VerticalAlignment="Center"
            Data="{StaticResource Icon.Check}" Stroke="{DynamicResource Brush.Success}" />
      <TextBlock Grid.Column="1" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12.5">
        <Run Text="{Binding Title, Mode=OneWay}" Foreground="{DynamicResource Brush.Text}" /><Run Text=" · " Foreground="{DynamicResource Brush.TextTertiary}" /><Run Text="{Binding Detail, Mode=OneWay}" Foreground="{DynamicResource Brush.TextSecondary}" />
      </TextBlock>
    </Grid>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding StateKey}" Value="Notice">
        <Setter TargetName="Icon" Property="Data" Value="{StaticResource Icon.Info}" />
        <Setter TargetName="Icon" Property="Stroke" Value="{DynamicResource Brush.Elevated}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding StateKey}" Value="Problem">
        <Setter TargetName="Icon" Property="Data" Value="{StaticResource Icon.Warning}" />
        <Setter TargetName="Icon" Property="Stroke" Value="{DynamicResource Brush.Critical}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding StateKey}" Value="Unknown">
        <Setter TargetName="Icon" Property="Data" Value="{StaticResource Icon.Info}" />
        <Setter TargetName="Icon" Property="Stroke" Value="{DynamicResource Brush.TextTertiary}" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- A part's health across the page: shield and status on the left, the checks on the right.
       Excellent is green, Good blue, Needs attention red. -->
  <DataTemplate x:Key="HealthCard" DataType="{x:Type pages:HealthReportViewModel}">
    <c:SquircleBorder Style="{StaticResource Card.Glow}" Padding="18,14" GlowStrength="0.8"
                      GlowKey="{Binding StatusKey, Converter={StaticResource StatusToGlowKey}}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,28,0" MinWidth="230">
          <Grid Width="46" Height="46" VerticalAlignment="Center">
            <Ellipse x:Name="Halo" Fill="{DynamicResource Brush.TextTertiary}" Opacity="0.14" />
            <Path x:Name="Shield" Style="{StaticResource IconPath}" Width="22" Height="22" Data="{StaticResource Icon.Shield}"
                  Stroke="{DynamicResource Brush.TextTertiary}" StrokeThickness="1.8" />
          </Grid>
          <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource Text.Label}" Text="{Binding Name, StringFormat={}{0} health}" />
            <TextBlock x:Name="Status" Text="{Binding StatusText}" FontSize="20" FontWeight="SemiBold" Margin="0,1,0,0"
                       Foreground="{DynamicResource Brush.TextSecondary}" />
            <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" MaxWidth="260" />
          </StackPanel>
        </StackPanel>
        <ItemsControl Grid.Column="1" ItemsSource="{Binding Checks}" ItemTemplate="{StaticResource HealthCheckRow}" Focusable="False"
                      VerticalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <c:AdaptiveGrid MinColumnWidth="200" MaxColumns="3" Spacing="20" RowSpacing="10" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </Grid>
    </c:SquircleBorder>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding StatusKey}" Value="Excellent">
        <Setter TargetName="Halo" Property="Fill" Value="{DynamicResource Brush.Success}" />
        <Setter TargetName="Shield" Property="Stroke" Value="{DynamicResource Brush.Success}" />
        <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource Brush.Success}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding StatusKey}" Value="Good">
        <Setter TargetName="Halo" Property="Fill" Value="{DynamicResource Brush.Info}" />
        <Setter TargetName="Shield" Property="Stroke" Value="{DynamicResource Brush.Info}" />
        <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource Brush.Info}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding StatusKey}" Value="Attention">
        <Setter TargetName="Halo" Property="Fill" Value="{DynamicResource Brush.Critical}" />
        <Setter TargetName="Shield" Property="Stroke" Value="{DynamicResource Brush.Critical}" />
        <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource Brush.Critical}" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- ================================================================================= -->
  <!-- In-game overlay (the overlay window and its preview in the settings card)          -->
  <!-- ================================================================================= -->

  <!-- The overlay's text shadow, on the text only: the frame-time graph redraws many times a second and must not take a
       blur with it each time. -->
  <DropShadowEffect x:Key="OverlayTextShadow" BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.85" Color="#000000" RenderingBias="Performance" />

  <!-- A value: the number, then a smaller unit on the same baseline. The FPS number is the headline: bigger and bold. -->
  <DataTemplate x:Key="OverlayValue" DataType="{x:Type overlay:OverlayValueViewModel}">
    <TextBlock x:Name="Value" Margin="{Binding Group.ValueSpacing}" Foreground="{Binding Color, Converter={StaticResource HexToBrush}}" VerticalAlignment="Bottom">
      <Run Text="{Binding Number, Mode=OneWay}" /><Run Text="{Binding Unit, Mode=OneWay, StringFormat={}&#x2009;{0}}" FontSize="{Binding Group.SmallFontSize, Mode=OneWay}" FontWeight="Medium" />
    </TextBlock>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding Id}" Value="fps">
        <Setter TargetName="Value" Property="FontSize" Value="{Binding Group.HeadlineFontSize}" />
        <Setter TargetName="Value" Property="FontWeight" Value="Bold" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- A line: "GPU  97 %  72 °C  350 W". Labels line up in a column when stacked. The FPS line also carries the
       frame-time graph (under the line when stacked, after it on one line). The text shadow is set on the text parts,
       never the graph. (1.4.1–1.4.4 also showed a green pill with the frame limit next to FPS.) -->
  <DataTemplate x:Key="OverlayGroup" DataType="{x:Type overlay:OverlayGroupViewModel}">
    <Grid Margin="{Binding Overlay.GroupSpacing}" TextElement.FontSize="{Binding FontSize}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" SharedSizeGroup="OverlayLabel" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock x:Name="Label" Text="{Binding Label}" Opacity="0.55" Margin="{Binding LabelSpacing}" VerticalAlignment="Bottom"
                 FontSize="{Binding SmallFontSize}" FontWeight="SemiBold"
                 Visibility="{Binding Overlay.ShowLabels, Converter={StaticResource BoolToVisibility}}" />
      <ItemsControl x:Name="Values" Grid.Column="1" ItemsSource="{Binding Values}" ItemTemplate="{StaticResource OverlayValue}" Focusable="False" VerticalAlignment="Bottom">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
      <!-- the graph: after the values on one line -->
      <c:FrameGraph x:Name="InlineGraph" Grid.Column="3" Margin="8,0,0,2" VerticalAlignment="Bottom" Visibility="Collapsed"
                    Width="{Binding GraphWidth}" Height="{Binding GraphHeight}"
                    Feed="{Binding Overlay.FrameTimes}" Stroke="{Binding Overlay.TextColor, Converter={StaticResource HexToBrush}}" />
      <!-- the graph: under the line when stacked -->
      <c:FrameGraph x:Name="Graph" Grid.Row="1" Grid.ColumnSpan="4" Margin="0,3,0,2" HorizontalAlignment="Left" Visibility="Collapsed"
                    Width="{Binding GraphWidth}" Height="{Binding GraphHeight}"
                    Feed="{Binding Overlay.FrameTimes}" Stroke="{Binding Overlay.TextColor, Converter={StaticResource HexToBrush}}" />
      <!-- while the overlay is being moved: this line's size (S, M, L), click to change -->
      <Button x:Name="SizeButton" Grid.Column="4" Margin="8,0,0,0" Padding="6,0" MinWidth="22" VerticalAlignment="Center" Visibility="Collapsed"
              Command="{Binding CycleSizeCommand}" ToolTip="{Binding SizeToolTip}" Focusable="False" Cursor="Hand">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Border Background="#CC2D6BFF" CornerRadius="5" Padding="{TemplateBinding Padding}">
              <TextBlock Text="{Binding SizeLabel}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Button.Template>
      </Button>
    </Grid>
    <DataTemplate.Triggers>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding Overlay.IsMoving}" Value="True" />
          <Condition Binding="{Binding (c:FrameGraph.IsLive), RelativeSource={RelativeSource Self}}" Value="True" />
        </MultiDataTrigger.Conditions>
        <Setter TargetName="SizeButton" Property="Visibility" Value="Visible" />
      </MultiDataTrigger>
      <DataTrigger Binding="{Binding Overlay.TextShadow}" Value="True">
        <Setter TargetName="Label" Property="Effect" Value="{StaticResource OverlayTextShadow}" />
        <Setter TargetName="Values" Property="Effect" Value="{StaticResource OverlayTextShadow}" />
      </DataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding IsFrameRate}" Value="True" />
          <Condition Binding="{Binding Overlay.ShowGraph}" Value="True" />
          <Condition Binding="{Binding Overlay.IsHorizontal}" Value="False" />
        </MultiDataTrigger.Conditions>
        <Setter TargetName="Graph" Property="Visibility" Value="Visible" />
      </MultiDataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding IsFrameRate}" Value="True" />
          <Condition Binding="{Binding Overlay.ShowGraph}" Value="True" />
          <Condition Binding="{Binding Overlay.IsHorizontal}" Value="True" />
        </MultiDataTrigger.Conditions>
        <Setter TargetName="InlineGraph" Property="Visibility" Value="Visible" />
      </MultiDataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- The overlay: a squircle of smoked glass (its own background color and opacity) with a soft sheen toward the top and
       no outline, the lines stacked or on one line. -->
  <DataTemplate x:Key="OverlayContent" DataType="{x:Type overlay:OverlayViewModel}">
    <Grid TextElement.FontFamily="{StaticResource UiFont}" TextElement.FontSize="{Binding FontSize}"
          TextElement.FontWeight="{Binding FontWeight}" TextElement.Foreground="{Binding TextColor, Converter={StaticResource HexToBrush}}"
          Typography.NumeralAlignment="Tabular" TextOptions.TextRenderingMode="Grayscale" TextOptions.TextFormattingMode="Ideal"
          Visibility="{Binding HasContent, Converter={StaticResource BoolToVisibility}}">
      <Grid Opacity="{Binding BackgroundOpacity}">
        <c:SquircleBorder CornerRadius="{Binding CornerRadius}" Background="{Binding BackgroundColor, Converter={StaticResource HexToBrush}}" />
        <c:SquircleBorder CornerRadius="{Binding CornerRadius}">
          <c:SquircleBorder.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="#10FFFFFF" Offset="0" />
              <GradientStop Color="#00FFFFFF" Offset="0.5" />
            </LinearGradientBrush>
          </c:SquircleBorder.Background>
        </c:SquircleBorder>
      </Grid>
      <ItemsControl ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource OverlayGroup}" Margin="{Binding Padding}"
                    Opacity="{Binding TextOpacity}" Grid.IsSharedSizeScope="True" Focusable="False">
        <ItemsControl.Style>
          <Style TargetType="ItemsControl">
            <Setter Property="ItemsPanel">
              <Setter.Value>
                <ItemsPanelTemplate>
                  <StackPanel />
                </ItemsPanelTemplate>
              </Setter.Value>
            </Setter>
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsHorizontal}" Value="True">
                <Setter Property="ItemsPanel">
                  <Setter.Value>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </Setter.Value>
                </Setter>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </ItemsControl.Style>
      </ItemsControl>
    </Grid>
  </DataTemplate>

  <!-- ================================================================================= -->
  <!-- Tools: drive benchmark and internet speed test (values on the four-color scale)   -->
  <!-- ================================================================================= -->

  <!-- A result tile: icon and label, the number (counting smoothly), a bar in the rating's color and a detail line.
       A dot breathes while the value is being measured. -->
  <DataTemplate x:Key="ToneTile" DataType="{x:Type pages:ToneValueViewModel}">
    <c:SquircleBorder Style="{StaticResource Card.Inset}" Padding="14,12" MinHeight="98">
      <StackPanel>
        <Grid>
          <StackPanel Orientation="Horizontal">
            <Path Style="{StaticResource IconPath}" Width="14" Height="14" VerticalAlignment="Center"
                  Data="{Binding IconKey, Converter={StaticResource IconKeyToGeometry}}"
                  Stroke="{Binding ColorKey, Converter={StaticResource ColorKeyToBrush}}" />
            <TextBlock Style="{StaticResource Text.Label}" Text="{Binding Label}" Margin="7,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <Ellipse Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Center"
                   Fill="{Binding ColorKey, Converter={StaticResource ColorKeyToBrush}}"
                   b:Pulse.IsPulsing="{Binding IsActive}" Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}"
                     b:AnimatedText.Formatter="{Binding NumberFormatter}" b:AnimatedText.Value="{Binding Value}" />
          <TextBlock Style="{StaticResource Text.Unit}" Text="{Binding Unit}" VerticalAlignment="Bottom" Margin="5,0,0,3" />
        </StackPanel>
        <ProgressBar Style="{StaticResource ProgressBar.Thin}" Margin="0,8,0,0"
                     Foreground="{Binding ColorKey, Converter={StaticResource ColorKeyToBrush}}"
                     b:Smooth.Value="{Binding Fraction, Converter={StaticResource FractionToPercent}}" />
        <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Detail}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"
                   Visibility="{Binding Detail, Converter={StaticResource HasValueToVisibility}}" />
      </StackPanel>
    </c:SquircleBorder>
  </DataTemplate>

  <!-- A big ring for a speed: the arc's length and color glide as the reading changes. -->
  <DataTemplate x:Key="ToneGauge" DataType="{x:Type pages:ToneValueViewModel}">
    <StackPanel HorizontalAlignment="Center">
      <Grid Width="164" Height="164">
        <c:RadialGauge Thickness="15" Orb="True" TrackBrush="{DynamicResource Brush.Track}" ToneScale="True"
                       Tone="{Binding Tone}" Value="{Binding Fraction}" />
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <Path Style="{StaticResource IconPath}" Width="16" Height="16" HorizontalAlignment="Center"
                Data="{Binding IconKey, Converter={StaticResource IconKeyToGeometry}}"
                Stroke="{Binding ColorKey, Converter={StaticResource ColorKeyToBrush}}" b:Pulse.IsPulsing="{Binding IsActive}" />
          <TextBlock FontFamily="{StaticResource UiFont}" FontSize="29" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"
                     Foreground="{DynamicResource Brush.Text}" Typography.NumeralAlignment="Tabular" TextOptions.TextFormattingMode="Ideal"
                     b:AnimatedText.Formatter="{Binding NumberFormatter}" b:AnimatedText.Value="{Binding Value}" />
          <TextBlock Text="{Binding Unit}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>
      <TextBlock Text="{Binding Label}" Style="{StaticResource Text.CardTitle}" HorizontalAlignment="Center" Margin="0,6,0,0" />
      <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" Margin="0,2,0,0" MinHeight="16" />
    </StackPanel>
  </DataTemplate>

  <!-- One value in the benchmark table: number and unit, a bar in the rating's color, and IOPS and latency. -->
  <DataTemplate x:Key="ToneCell" DataType="{x:Type pages:ToneValueViewModel}">
    <StackPanel>
      <Grid>
        <StackPanel Orientation="Horizontal">
          <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}"
                     b:AnimatedText.Formatter="{Binding NumberFormatter}" b:AnimatedText.Value="{Binding Value}" />
          <TextBlock Style="{StaticResource Text.Unit}" Text="{Binding Unit}" VerticalAlignment="Bottom" Margin="4,0,0,1" />
        </StackPanel>
        <Ellipse Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Center"
                 Fill="{Binding ColorKey, Converter={StaticResource ColorKeyToBrush}}"
                 b:Pulse.IsPulsing="{Binding IsActive}" Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
      </Grid>
      <ProgressBar Style="{StaticResource ProgressBar.Thin}" Margin="0,6,0,0"
                   Foreground="{Binding ColorKey, Converter={StaticResource ColorKeyToBrush}}"
                   b:Smooth.Value="{Binding Fraction, Converter={StaticResource FractionToPercent}}" />
      <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Detail}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" MinHeight="15" />
    </StackPanel>
  </DataTemplate>

  <!-- A benchmark row: the test (name, shorthand, what it means) and its read and write results. -->
  <DataTemplate x:Key="DiskBenchmarkRow" DataType="{x:Type pages:DiskBenchmarkRowViewModel}">
    <c:SquircleBorder Style="{StaticResource Card.Inset}" Padding="14,12" Margin="0,0,0,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.2*" MinWidth="130" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Brush.Text}" />
            <Border Style="{StaticResource Badge}" Margin="8,0,0,0">
              <TextBlock Text="{Binding ShortName}" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{DynamicResource Brush.TextSecondary}" />
            </Border>
          </StackPanel>
          <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,3,0,0" />
        </StackPanel>
        <ContentPresenter Grid.Column="1" Content="{Binding Read}" ContentTemplate="{StaticResource ToneCell}" Margin="0,0,14,0" VerticalAlignment="Center" />
        <ContentPresenter Grid.Column="2" Content="{Binding Write}" ContentTemplate="{StaticResource ToneCell}" VerticalAlignment="Center" />
      </Grid>
    </c:SquircleBorder>
  </DataTemplate>
</ResourceDictionary>
