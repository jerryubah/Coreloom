<Project Sdk="Microsoft.NET.Sdk">

  <!-- The macOS back-end's arithmetic and decoding run everywhere; the tests that read the real Mac (MacHardwareTests)
       run on the macOS CI runners and skip elsewhere. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Coreloom Connect's cryptography (AES-GCM, P-256, HKDF), QR codes and server, checked on macOS as well. -->
  <ItemGroup>
    <Compile Include="..\Coreloom.Core.Tests\ConnectTests.cs" Link="ConnectTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Coreloom.Core\Coreloom.Core.csproj" />
    <ProjectReference Include="..\..\src\Coreloom.Hardware.Mac\Coreloom.Hardware.Mac.csproj" />
  </ItemGroup>

</Project>
