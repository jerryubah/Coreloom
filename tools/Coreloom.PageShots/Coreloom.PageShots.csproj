<Project Sdk="Microsoft.NET.Sdk">

  <!-- A developer tool, not part of the app or the release: draws Coreloom's pages with sample data into PNG files, so
       their layout (alignment, wrapping, spacing) can be checked from a build machine. Run by .github/workflows/pageshots.yml. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- The app's fonts at the same pack://application:,,,/Fonts/ address the app's styles use. -->
  <ItemGroup>
    <Resource Include="..\..\src\Coreloom.App\Fonts\*.ttf" Link="Fonts\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Coreloom.App\Coreloom.App.csproj" />
  </ItemGroup>

</Project>
